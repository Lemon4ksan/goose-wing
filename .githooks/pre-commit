# .githooks/pre-commit
# Hardware complexity gate, style invariants, and format verification for goose-wing.

# Enforce Linear Git History (block merge commits)
if [ -f ".git/MERGE_HEAD" ]; then
    echo "[pre-commit] ERROR: Merge commits are prohibited. Maintain a linear commit history via rebase or fast-forward."
    exit 1
fi

# Find all staged .goose files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.goose$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Enforce code clarity, formatting geometry, anti-aliasing, and parser contracts
PYTHON_BIN="python"
if ! command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python3"
fi

if command -v "$PYTHON_BIN" >/dev/null 2>&1 && [ -f "scripts/lint_invariants.py" ]; then
    echo "[pre-commit] Checking code clarity, geometry, and anti-aliasing invariants..."
    if ! "$PYTHON_BIN" scripts/lint_invariants.py --staged --strict-examples; then
        exit 1
    fi
fi

echo "[pre-commit] Checking formatting on staged .goose files..."
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        if ! goose format --check "$file" >/dev/null 2>&1; then
            echo "[pre-commit] ERROR: Formatting check failed for $file"
            echo "[pre-commit] Run: goose format $file"
            exit 1
        fi
    fi
done

echo "[pre-commit] Running typecheck..."
if ! goose check core.goose >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: Typecheck failed for core.goose"
    goose check core.goose
    exit 1
fi

if ! goose check wing.goose >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: Typecheck failed for wing.goose"
    goose check wing.goose
    exit 1
fi

for file in $STAGED_FILES; do
    case "$file" in
        tests/*.goose|examples/*.goose)
            if [ -f "$file" ]; then
                if ! goose check "$file" >/dev/null 2>&1; then
                    echo "[pre-commit] ERROR: Typecheck failed for $file"
                    goose check "$file"
                    exit 1
                fi
            fi
            ;;
    esac
done

LIT_BIN="goose-lit"
if ! command -v "$LIT_BIN" >/dev/null 2>&1; then
    if [ -f "../goose-lit/bin/goose-lit.exe" ]; then
        LIT_BIN="../goose-lit/bin/goose-lit.exe"
    elif [ -f "../goose-lit/bin/goose-lit" ]; then
        LIT_BIN="../goose-lit/bin/goose-lit"
    elif [ -f "bin/goose-lit.exe" ]; then
        LIT_BIN="bin/goose-lit.exe"
    elif [ -f "bin/goose-lit" ]; then
        LIT_BIN="bin/goose-lit"
    fi
fi

    BASELINE_FILE=".lit/baseline"
    if [ ! -f "$BASELINE_FILE" ] && [ -f "scripts/gcrap_baseline.txt" ]; then
        BASELINE_FILE="scripts/gcrap_baseline.txt"
    fi

    if [ -f "$LIT_BIN" ] || command -v "$LIT_BIN" >/dev/null 2>&1; then
        echo "[pre-commit] Enforcing G-CRAP complexity gate (ceiling: 25)..."
        for file in $STAGED_FILES; do
            # Enforce gate on production source files (excluding tests/ and examples/)
            case "$file" in
                tests/*|examples/*|bench/*)
                    continue
                    ;;
                *)
                    if [ -f "$file" ]; then
                        $LIT_BIN gate "$file" 25 --cov 0.85 >/dev/null 2>&1
                        RC=$?
                        if [ $RC -ne 0 ]; then
                            # If file is grandfathered in baseline, ratchet enforces delta below
                            if [ -f "$BASELINE_FILE" ] && grep -F -i "$file" "$BASELINE_FILE" >/dev/null 2>&1; then
                                echo "[pre-commit] INFO: $file contains grandfathered baseline entries; ratchet will enforce zero regression."
                            else
                                $LIT_BIN gate "$file" 25 --cov 0.85
                                echo "[pre-commit] GATE REJECTED: $file exceeds G-CRAP ceiling or contains bounds safety violations."
                                exit 1
                            fi
                        fi
                    fi
                    ;;
            esac
        done

        if [ -f "$BASELINE_FILE" ]; then
            echo "[pre-commit] Evaluating G-CRAP ratchet against baseline..."
            $LIT_BIN crap . --baseline "$BASELINE_FILE" --cov 0.85 --delta 5.0 >/dev/null 2>&1
            RC=$?
            if [ $RC -ne 0 ]; then
                echo "[pre-commit] RATCHET GATE REJECTED: Safety regressions or unproven bce:keep detected."
                $LIT_BIN crap . --baseline "$BASELINE_FILE" --cov 0.85 --delta 5.0
                exit 1
            fi
        fi
    fi

echo "[pre-commit] All invariants and complexity gates passed."
exit 0
