// packetdrill script: TCP graceful FIN half-close and peer drain (RFC 9293 Section 3.6).
// Verifies SHUT_WR FIN emission while continuing to receive peer data before final close.

--tolerance_usecs=100000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 16) = 0

+0.010 < S 0:0(0) win 65535 <mss 1460,sackOK,TS val 100 ecr 0>
+0.000 > S. 0:0(0) ack 1 <mss 1460,sackOK,TS val 200 ecr 100>
+0.010 < . 1:1(0) ack 1 win 65535 <nop,nop,TS val 110 ecr 200>
+0.000 accept(3, ..., ...) = 4

// Server writes response bytes and initiates half-close with SHUT_WR
+0.002 write(4, ..., 128) = 128
+0.000 > P. 1:129(128) ack 1 <nop,nop,TS val 210 ecr 110>
+0.002 shutdown(4, SHUT_WR) = 0
+0.000 > F. 129:129(0) ack 1 <nop,nop,TS val 212 ecr 110>

// Peer ACKs FIN-WAIT-1 and sends trailing request payload in FIN-WAIT-2
+0.010 < . 1:1(0) ack 130 win 65535 <nop,nop,TS val 120 ecr 212>
+0.005 < P. 1:65(64) ack 130 win 65535 <nop,nop,TS val 125 ecr 212>
+0.000 > . 130:130(0) ack 65 <nop,nop,TS val 220 ecr 125>
+0.001 read(4, ..., 256) = 64

// Peer sends FIN; server ACKs and enters TIME-WAIT
+0.010 < F. 65:65(0) ack 130 win 65535 <nop,nop,TS val 135 ecr 220>
+0.000 > . 130:130(0) ack 66 <nop,nop,TS val 230 ecr 135>
+0.001 read(4, ..., 256) = 0

+0.001 close(4) = 0
+0.000 close(3) = 0
