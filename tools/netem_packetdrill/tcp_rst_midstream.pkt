// packetdrill script: Abrupt mid-stream TCP RST during active HTTP/1.1 exchange
// (RFC 9293 Section 3.10.7).
// Verifies fail-closed ECONNRESET / EPIPE propagation into the Wing L4 reactor
// when a peer resets a connection with unacknowledged response bytes in flight.

--tolerance_usecs=100000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 setsockopt(3, SOL_SOCKET, SO_REUSEADDR, [1], 4) = 0
+0.000 bind(3, ..., ...) = 0
+0.000 listen(3, 16) = 0

// Establish 3-way handshake
+0.010 < S 0:0(0) win 32768 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
+0.000 > S. 0:0(0) ack 1 <mss 1460,sackOK,TS val 200 ecr 100,nop,wscale 7>
+0.010 < . 1:1(0) ack 1 win 256 <nop,nop,TS val 110 ecr 200>
+0.000 accept(3, ..., ...) = 4

// Peer delivers partial HTTP/1.1 request bytes
+0.005 < P. 1:25(24) ack 1 win 256 <nop,nop,TS val 115 ecr 200>
+0.000 > . 1:1(0) ack 25 <nop,nop,TS val 215 ecr 115>
+0.001 read(4, ..., 1024) = 24

// Server writes initial response bytes
+0.001 write(4, ..., 16) = 16
+0.000 > P. 1:17(16) ack 25 <nop,nop,TS val 216 ecr 115>

// Peer injects abrupt mid-stream RST
+0.005 < R. 25:25(0) ack 17 win 0

// Reactor read/write fail closed with ECONNRESET and EPIPE
+0.001 read(4, ..., 1024) = -1 ECONNRESET (Connection reset by peer)
+0.001 write(4, ..., 16) = -1 EPIPE (Broken pipe)

+0.001 close(4) = 0
+0.000 close(3) = 0
