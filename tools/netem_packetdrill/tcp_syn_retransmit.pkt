//
// packetdrill script: TCP client SYN retransmission and RTO backoff
// (RFC 6298 Section 2 / RFC 9293 Section 3.5).
// Exercises non-blocking connect recovery when the initial SYN is dropped
// before an HTTP/1.1 Wing client session begins.

--tolerance_usecs=150000

0.000 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0.000 fcntl(3, F_GETFL) = 0x2 (flags O_RDWR)
+0.000 fcntl(3, F_SETFL, O_RDWR|O_NONBLOCK) = 0
+0.000 connect(3, ..., ...) = -1 EINPROGRESS (Operation now in progress)

// Initial SYN emitted and lost in transit
+0.000 > S 0:0(0) <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>

// Retransmitted SYN after ~1.0s initial RTO
+0.900~+1.300 > S 0:0(0) <mss 1460,sackOK,TS val 1100 ecr 0,nop,wscale 7>

// Remote peer replies with SYN-ACK
+0.020 < S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 500 ecr 1100,nop,wscale 7>
+0.000 > . 1:1(0) ack 1 <nop,nop,TS val 1120 ecr 500>

// Wing client checks non-blocking connect completion
+0.001 getsockopt(3, SOL_SOCKET, SO_ERROR, [0], [4]) = 0

// Transmit minimal HTTP/1.1 request and close cleanly
+0.001 write(3, ..., 37) = 37
+0.000 > P. 1:38(37) ack 1 <nop,nop,TS val 1121 ecr 500>
+0.010 < . 1:1(0) ack 38 win 65535 <nop,nop,TS val 510 ecr 1121>

+0.001 close(3) = 0
+0.000 > F. 38:38(0) ack 1 <nop,nop,TS val 1131 ecr 510>
+0.010 < F. 1:1(0) ack 39 win 65535 <nop,nop,TS val 520 ecr 1131>
+0.000 > . 39:39(0) ack 2 <nop,nop,TS val 1141 ecr 520>
