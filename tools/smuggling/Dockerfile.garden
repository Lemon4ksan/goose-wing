# narfindustries/http-garden origin-echo image for goose-wing (wing + wing_h1).
# Build:
#   docker build -f tools/smuggling/Dockerfile.garden -t http-garden-goose-wing .
# Run:
#   docker run --rm -p 8080:80 -e GARDEN_ENGINE=wing http-garden-goose-wing
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV GARDEN_ENGINE=wing
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    ca-certificates \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN curl -sSL --retry 5 --retry-delay 2 --retry-connrefused \
    https://github.com/aardappel/goose/releases/download/v2026.4/goose-v2026.4-linux-x64.tar.gz \
    | tar -xz -C /opt && \
    ln -s /opt/goose-v2026.4-linux-x64/goose /usr/local/bin/goose

COPY . /app

RUN mkdir -p /app/tools/bin && \
    goose build -O2 -o /app/tools/bin/smuggling_wing tools/smuggling/wing_harness.goose && \
    goose build -O2 -o /app/tools/bin/smuggling_wing_h1 tools/smuggling/wing_h1_harness.goose

EXPOSE 80

ENTRYPOINT ["python3", "/app/tools/smuggling/http_garden_adapter.py", "--mode", "serve", "--host", "0.0.0.0", "--port", "80"]
