// ---- bitstream reader & writer ---------------------------------------------

struct BitReader {
    src:       const u8[:],
    pos:       i64 = 0,
    bit_buf:   u64 = 0,
    bit_count: i32 = 0,
}

fn read_bits(r: BitReader&, need: i32) -> u32, bool {
    while r.bit_count < need {
        if r.pos >= r.src.len {
            return 0, false;
        }
        let b = r.src[r.pos] as u64;
        r.pos = add_sat_i64(r.pos, 1);
        r.bit_buf |= b << ((r.bit_count as! u32) & 63);
        r.bit_count = ((r.bit_count as! u32) + 8) as! i32;
    }
    let sh = (need as! u32) & 31;
    let mask = ((1 as u32) << sh) - 1;
    let val = (r.bit_buf as! u32) & mask;
    r.bit_buf >>= sh;
    r.bit_count = ((r.bit_count as! u32) - sh) as! i32;
    return val, true;
}

inline fn refill_bits_32(r: BitReader&) {
    if r.bit_count <= 32 {
        let word = read_le_u32(r.src, r.pos) as u64;
        r.bit_buf |= word << ((r.bit_count as! u32) & 63);
        r.pos = add_sat_i64(r.pos, 4);
        r.bit_count = ((r.bit_count as! u32) + 32) as! i32;
    }
}

inline fn refill_bits_tail(r: BitReader&) {
    if r.bit_count <= 32 && add_sat_i64(r.pos, 4) <= r.src.len {
        refill_bits_32(r);
        return;
    }
    while r.bit_count <= 56 && r.pos < r.src.len {
        let b = r.src[r.pos] as u64;
        r.pos = add_sat_i64(r.pos, 1);
        r.bit_buf |= b << ((r.bit_count as! u32) & 63);
        r.bit_count = ((r.bit_count as! u32) + 8) as! i32;
    }
}

fn align_to_byte(r: BitReader&) {
    let whole_bytes = ((r.bit_count as! u32) >> 3) as i64;
    r.pos = sub_sat_i64(r.pos, whole_bytes);
    r.bit_buf = 0;
    r.bit_count = 0;
}

struct BitWriter {
    bit_buf:   u64  = 0,
    bit_count: i32  = 0,
    overflow:  bool = false,
}

inline fn record_bw_write(w: BitWriter&, ok: bool) {
    if !ok {
        w.overflow = true;
    }
}

fn write_bits<B>(w: BitWriter&, val: u32, n_bits: i32, out: B&) {
    w.bit_buf |= (val as u64) << ((w.bit_count as! u32) & 63);
    w.bit_count = ((w.bit_count as! u32) + (n_bits as! u32)) as! i32;
    while w.bit_count >= 8 {
        record_bw_write(w, comp_try_push(out, (w.bit_buf & 0xFF) as! u8));
        w.bit_buf >>= 8;
        w.bit_count = ((w.bit_count as! u32) - 8) as! i32;
    }
}

inline fn emit_bits_fast<B>(w: BitWriter&, val: u64, n_bits: u32, out: B&) {
    w.bit_buf |= val << ((w.bit_count as! u32) & 63);
    w.bit_count = ((w.bit_count as! u32) + n_bits) as! i32;
    if w.bit_count >= 32 {
        record_bw_write(w, comp_try_write_le_u32(out, (w.bit_buf & 0xFFFFFFFF) as! u32));
        w.bit_buf >>= 32;
        w.bit_count = ((w.bit_count as! u32) - 32) as! i32;
    }
}

inline fn drain_full_bytes<B>(w: BitWriter&, out: B&) {
    while w.bit_count >= 8 {
        record_bw_write(w, comp_try_push(out, (w.bit_buf & 0xFF) as! u8));
        w.bit_buf >>= 8;
        w.bit_count = ((w.bit_count as! u32) - 8) as! i32;
    }
}

fn flush_bits<B>(w: BitWriter&, out: B&) {
    drain_full_bytes(w, out);
    if w.bit_count > 0 {
        record_bw_write(w, comp_try_push(out, (w.bit_buf & 0xFF) as! u8));
        w.bit_buf = 0;
        w.bit_count = 0;
    }
}

// ---- canonical huffman table -----------------------------------------------

enum HuffTableKind {
    CodeLen,
    LitLen,
    Dist,
}

struct HuffmanTable {
    count:  i32[16]  = [0; 16],
    symbol: i32[288] = [0; 288],
    fast:   u32[512] = [FAST_ENTRY_SLOW; 512],
}

