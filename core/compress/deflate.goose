// The Goose Deflate / Inflate compression engine: RFC 1951 Specification.
namespace core;

import std;

extern fn native_deflate_l1_chunk(
    src:         const u8[:],
    chunk_start: i64,
    chunk_end:   i64,
    is_final:    i32,
    head:        u32[:],
    bit_state:   u64[:],
    dst:         u8[:],
) -> i64 = "wing_simd_deflate_l1_chunk";

// ---- compression error codes -----------------------------------------------

enum CompressError {
    None,
    InvalidHeader,
    InvalidBlockType,
    LengthMismatch,
    OutputBufferOverflow,
    InputBufferTruncated,
    CorruptedBitstream,
    InvalidHuffmanCode,
    DistanceOutOfBounds,
    InvalidDistanceCode,
    TooManyLengthOrDistanceCodes,
    CodeLengthsOverSubscribed,
    CodeLengthsIncomplete,
    RepeatWithoutPreviousLength,
    ChecksumMismatch,
    SizeMismatch,
    NeedDictionary,
    DictionaryMismatch,
}

// Returns true if the compression error is CompressError.None.
inline fn ok(err: CompressError) -> bool {
    return err == CompressError.None;
}

inline fn comp_try_push<B>(out: B&, b: u8) -> bool {
    guard out.len < out.cap else { return false; }
    out.push(b);
    return true;
}

inline fn comp_try_push(out: u8[>..]&, b: u8) -> bool {
    out.push(b);
    return true;
}

inline fn comp_try_append<B>(out: B&, src: const u8[:]) -> bool {
    guard out.len <= out.cap && src.len <= out.cap - out.len else { return false; }
    out.append(src);
    return true;
}

inline fn comp_try_append(out: u8[>..]&, src: const u8[:]) -> bool {
    out.append(src);
    return true;
}

inline fn comp_has_room<B>(out: B&, needed: i64) -> bool {
    return needed >= 0 && out.len <= out.cap && needed <= sub_sat_i64(out.cap, out.len);
}

inline fn comp_has_room(out: u8[>..]&, needed: i64) -> bool {
    return needed >= 0;
}

inline fn comp_try_fill<B>(out: B&, count: i64, fill_byte: u8) -> bool {
    guard comp_has_room(out, count) else { return false; }
    let chunk: u8[64] = [fill_byte; 64];
    var rem = count;
    while rem > 0 {
        let step = min(rem, 64);
        out.append(chunk[..step]);
        rem = sub_sat_i64(rem, step);
    }
    return true;
}

inline fn comp_try_fill(out: u8[>..]&, count: i64, fill_byte: u8) -> bool {
    guard count >= 0 else { return false; }
    let chunk: u8[64] = [fill_byte; 64];
    var rem = count;
    while rem > 0 {
        let step = min(rem, 64);
        out.append(chunk[..step]);
        rem = sub_sat_i64(rem, step);
    }
    return true;
}

inline fn comp_try_write_le_u16<B>(out: B&, val: u16) -> bool {
    let bytes: u8[2] = [
        (val & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
    ];
    return comp_try_append(out, bytes[..]);
}

inline fn comp_try_write_le_u32<B>(out: B&, val: u32) -> bool {
    let bytes: u8[4] = [
        (val & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
        ((val >> 16) & 0xFF) as u8,
        ((val >> 24) & 0xFF) as u8,
    ];
    return comp_try_append(out, bytes[..]);
}

inline fn comp_try_write_le_u64<B>(out: B&, val: u64) -> bool {
    let bytes: u8[8] = [
        (val & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
        ((val >> 16) & 0xFF) as u8,
        ((val >> 24) & 0xFF) as u8,
        ((val >> 32) & 0xFF) as u8,
        ((val >> 40) & 0xFF) as u8,
        ((val >> 48) & 0xFF) as u8,
        ((val >> 56) & 0xFF) as u8,
    ];
    return comp_try_append(out, bytes[..]);
}

inline fn comp_try_write_be_u32<B>(out: B&, val: u32) -> bool {
    let bytes: u8[4] = [
        ((val >> 24) & 0xFF) as u8,
        ((val >> 16) & 0xFF) as u8,
        ((val >> 8) & 0xFF) as u8,
        (val & 0xFF) as u8,
    ];
    return comp_try_append(out, bytes[..]);
}

