inline fn reverse_bits_u32(c: u32, len: u32) -> u32 {
    let lo = BIT_REV8[(c & 0xFF) as! i64] as u32;
    let hi = BIT_REV8[((c >> 8) & 0xFF) as! i64] as u32;
    let r16 = (lo << 8) | hi;
    return r16 >> ((16 - len) & 15);
}

inline fn encode_fast_huff_entry(s: i32, len: u32, kind: HuffTableKind) -> u32 {
    let l = len & 0xFF;
    if kind == HuffTableKind.LitLen {
        if s < 256 {
            return ((s as! u32) << 8) | l;
        }
        if s == 256 {
            return (FAST_OP_EOB << 24) | l;
        }
        if s <= 285 {
            let li = ((s - 257) as! u32) & 31;
            let op = 1 + (LENS_EXTRA[li as i64] as! u32);
            let base = LENS_BASE[li as i64] as! u32;
            return (op << 24) | (base << 8) | l;
        }
        return (FAST_OP_INVALID << 24) | l;
    }
    if kind == HuffTableKind.Dist {
        if s < 30 {
            let di = (s as! u32) & 31;
            let op = 1 + (DISTS_EXTRA[di as i64] as! u32);
            let base = DISTS_BASE[di as i64] as! u32;
            return (op << 24) | (base << 8) | l;
        }
        return (FAST_OP_INVALID << 24) | l;
    }
    return ((s as! u32) << 8) | l;
}

inline fn insert_deflate_huffman_symbol(
    table:     HuffmanTable&,
    s:         i32,
    len:       i32,
    kind:      HuffTableKind,
    offs:      u32[16]&,
    next_code: u32[16]&,
) {
    let l_idx = (len as! u32) & 15;
    let sym_pos = offs[l_idx as i64] & 511;
    if sym_pos < 288 {
        table.symbol[sym_pos as i64] = s;
    }
    offs[l_idx as i64] += 1;

    let c = next_code[l_idx as i64];
    next_code[l_idx as i64] = c + 1;
    guard l_idx <= 9 else { return; }

    let rev_code = reverse_bits_u32(c, l_idx);
    let step = (1 as u32) << l_idx;
    let entry = encode_fast_huff_entry(s, l_idx, kind);
    var idx = rev_code;
    while idx < 512 {
        table.fast[(idx & 511) as i64] = entry;
        idx += step;
    }
}

// Constructs canonical Huffman decode table from a list of code lengths into a fresh HuffmanTable.
// Returns 0 on complete code set, >0 on incomplete code set, or <0 on over-subscribed code set.
fn construct_huffman_table(
    lengths:   const i32[:],
    n_symbols: i32,
    kind:      HuffTableKind,
    table:     HuffmanTable&,
) -> i32 {
    var non_zero_count: u32 = 0;
    let n_lim = min(n_symbols as i64, lengths.len);
    for s in n_lim {
        let len = lengths[s];
        if len > 0 && len <= MAX_BITS {
            let li = (len as! u32) & 15;
            table.count[li as i64] = ((table.count[li as i64] as! u32) + 1) as! i32;
            non_zero_count += 1;
        }
    }
    if non_zero_count == 0 {
        return 0;
    }

    var left: i32 = 1;
    for l in 1..16 {
        left = ((left as! u32) << 1) as! i32;
        left = sub_sat_i64(left, table.count[l]) as! i32;
        if left < 0 {
            return left;
        }
    }

    var offs:      u32[16] = [0; 16];
    var next_code: u32[16] = [0; 16];
    var code:      u32     = 0;
    for l in 1..15 {
        offs[l + 1] = offs[l] + (table.count[l] as! u32);
    }
    for l in 1..16 {
        code = (code + (table.count[l - 1] as! u32)) << 1;
        next_code[l] = code;
    }

    for s in n_lim {
        let len = lengths[s];
        if len > 0 && len <= MAX_BITS {
            insert_deflate_huffman_symbol(table, s as! i32, len, kind, offs, next_code);
        }
    }

    return left;
}

// Decodes a canonical Huffman symbol >9 bits (or near end-of-stream) bit-by-bit.
//
// Example:
//   r.bit_count = 4, table.count[1] = 1
//   returns: 0, true
fn decode_canonical_slow(r: BitReader&, table: const HuffmanTable&) -> i32, bool {
    var code:  u32 = 0;
    var first: u32 = 0;
    var index: u32 = 0;

    for len in 1..16 {
        let b, ok_b = read_bits(r, 1);
        if !ok_b { return -1, false; }
        code |= b;
        let count = table.count[len] as! u32;
        if code < first + count {
            let sym_idx = (index + (code - first)) as i64;
            guard sym_idx < 288 else { return -1, true; }
            return table.symbol[sym_idx], true;
        }
        index += count;
        first = (first + count) << 1;
        code <<= 1;
    }

    return -1, true;
}

// Decodes a code-length alphabet symbol (0..18) using 9-bit fast table + canonical fallback.
//
// Example:
//   r.bit_count = 16, table.fast[0] = (5 << 8) | 3
//   returns: 5, true
fn decode_codelen_symbol(r: BitReader&, table: const HuffmanTable&) -> i32, bool {
    refill_bits_tail(r);
    if r.bit_count >= 9 {
        let entry = table.fast[(r.bit_buf & 0x1FF) as! i64];
        if (entry & FAST_ENTRY_SLOW) == 0 {
            let flen = entry & 0xFF;
            r.bit_buf >>= flen;
            r.bit_count = ((r.bit_count as! u32) - flen) as! i32;
            return ((entry >> 8) & 0xFFFF) as! i32, true;
        }
    }
    return decode_canonical_slow(r, table);
}

// ---- decompressor: rfc 1951 inflate ----------------------------------------

inline fn copy_fast_match<B>(out: B&, dist: i64, m_len: i64) -> bool {
    let back_idx = sub_sat_i64(out.len, dist);
    if dist >= m_len {
        return comp_try_append(out, out[back_idx..add_sat_i64(back_idx, m_len)]);
    }
    if dist == 1 {
        let b = out[back_idx];
        let blk: u8[32] = [b; 32];
        var rem = m_len;
        while rem >= 32 {
            guard comp_try_append(out, blk[..]) else { return false; }
            rem = sub_sat_i64(rem, 32);
        }
        if rem > 0 {
            guard comp_try_append(out, blk[..rem]) else { return false; }
        }
        return true;
    }
    var curr: i64 = 0;
    while curr < m_len {
        let step = min(add_sat_i64(curr, dist), sub_sat_i64(m_len, curr));
        guard comp_try_append(out, out[back_idx..add_sat_i64(back_idx, step)]) else { return false; }
        curr = add_sat_i64(curr, step);
    }
    return true;
}

fn apply_deflate_match<B>(
    out:           B&,
    dist_i64:      i64,
    match_len:     i32,
    out_start_pos: i64,
    dict:          const u8[:],
) -> bool {
    let curr_decoded = sub_sat_i64(out.len, out_start_pos);
    if dist_i64 <= curr_decoded {
        return copy_fast_match(out, dist_i64, match_len as i64);
    }

    for i in match_len {
        let curr = sub_sat_i64(out.len, out_start_pos);
        if dist_i64 <= curr {
            let b = out[sub_sat_i64(out.len, dist_i64)];
            guard comp_try_push(out, b) else { return false; }
        } else {
            let dict_back = sub_sat_i64(dist_i64, curr);
            let dict_idx = sub_sat_i64(dict.len, dict_back);
            guard comp_try_push(out, dict[dict_idx]) else { return false; }
        }
    }
    return true;
}

// Decodes a match distance value using the pre-baked distance HuffmanTable.
//
// Example:
//   dist_table.fast[0] = (1 << 24) | (1 << 8) | 5
//   returns: 1, CompressError.None
fn decode_match_distance(r: BitReader&, dist_table: const HuffmanTable&) -> i32, CompressError {
    refill_bits_tail(r);
    if r.bit_count >= 9 {
        let d_entry = dist_table.fast[(r.bit_buf & 0x1FF) as! i64];
        if (d_entry & FAST_ENTRY_SLOW) == 0 {
            let d_op = d_entry >> 24;
            if d_op == FAST_OP_INVALID {
                return 0, CompressError.InvalidDistanceCode;
            }
            let d_code_bits = d_entry & 0xFF;
            r.bit_buf >>= d_code_bits;
            r.bit_count = ((r.bit_count as! u32) - d_code_bits) as! i32;
            let d_extra = d_op - 1;
            var dist_val = (d_entry >> 8) & 0xFFFF;
            if d_extra > 0 {
                let dx, ok_dx = read_bits(r, d_extra as! i32);
                guard ok_dx else { return 0, CompressError.InputBufferTruncated; }
                dist_val += dx;
            }
            return dist_val as! i32, CompressError.None;
        }
    }

    let dsym, ok_dist = decode_canonical_slow(r, dist_table);
    guard ok_dist else { return 0, CompressError.InputBufferTruncated; }
    guard dsym >= 0 && dsym < 30 else { return 0, CompressError.InvalidDistanceCode; }
    let di = (dsym as! u32) & 31;
    let d_extra = DISTS_EXTRA[di as i64];
    var match_dist = DISTS_BASE[di as i64] as! u32;
    if d_extra > 0 {
        let dxval, ok_dx = read_bits(r, d_extra);
        guard ok_dx else { return 0, CompressError.InputBufferTruncated; }
        match_dist += dxval;
    }
    return match_dist as! i32, CompressError.None;
}

enum FastStepResult {
    Continue,
    EndOfBlock,
    Fallback,
    Error,
}

// Single step of inflate_fast: decodes up to two literals or one literal + one full match
// inline when >= 16 input bytes and >= 260 output capacity/quota bytes remain and dict is empty.
inline fn step_inflate_fast<B>(
    r:               BitReader&,
    lit_table:       const HuffmanTable&,
    dist_table:      const HuffmanTable&,
    out:             B&,
    out_start_pos:   i64,
    max_window_dist: i64,
    err_out:         CompressError&,
) -> FastStepResult {
    refill_bits_32(r);
    var entry = lit_table.fast[(r.bit_buf & 0x1FF) as! i64];
    if entry < 0x01000000 {
        out.push(((entry >> 8) & 0xFF) as! u8);
        let b1 = entry & 0xFF;
        r.bit_buf >>= b1;
        r.bit_count = ((r.bit_count as! u32) - b1) as! i32;

        entry = lit_table.fast[(r.bit_buf & 0x1FF) as! i64];
        if entry < 0x01000000 {
            out.push(((entry >> 8) & 0xFF) as! u8);
            let b2 = entry & 0xFF;
            r.bit_buf >>= b2;
            r.bit_count = ((r.bit_count as! u32) - b2) as! i32;
            return FastStepResult.Continue;
        }
    }

    let op = entry >> 24;
    if op == FAST_OP_EOB {
        let eb = entry & 0xFF;
        r.bit_buf >>= eb;
        r.bit_count = ((r.bit_count as! u32) - eb) as! i32;
        return FastStepResult.EndOfBlock;
    }
    guard op >= 1 && op < 16 else { return FastStepResult.Fallback; }

    let l_code_bits = entry & 0xFF;
    let l_extra = op - 1;
    let l_base = (entry >> 8) & 0xFFFF;
    let l_mask = ((1 as u64) << (l_extra as u64)) - 1;
    let m_len = (l_base + (((r.bit_buf >> (l_code_bits as u64)) & l_mask) as! u32)) as i64;
    let tot_l = l_code_bits + l_extra;
    r.bit_buf >>= tot_l;
    r.bit_count = ((r.bit_count as! u32) - tot_l) as! i32;

    refill_bits_32(r);
    let d_entry = dist_table.fast[(r.bit_buf & 0x1FF) as! i64];
    let d_op = d_entry >> 24;
    var dist: i64 = 0;
    if d_op >= 1 && d_op < 32 {
        let d_code_bits = d_entry & 0xFF;
        let d_extra = d_op - 1;
        let d_base = (d_entry >> 8) & 0xFFFF;
        let d_mask = ((1 as u64) << (d_extra as u64)) - 1;
        dist = (d_base + (((r.bit_buf >> (d_code_bits as u64)) & d_mask) as! u32)) as i64;
        let tot_d = d_code_bits + d_extra;
        r.bit_buf >>= tot_d;
        r.bit_count = ((r.bit_count as! u32) - tot_d) as! i32;
    } else {
        let d_val, d_err = decode_match_distance(r, dist_table);
        if d_err != CompressError.None {
            err_out = d_err;
            return FastStepResult.Error;
        }
        dist = d_val as i64;
    }

    if dist > min(max_window_dist, sub_sat_i64(out.len, out_start_pos)) {
        err_out = CompressError.DistanceOutOfBounds;
        return FastStepResult.Error;
    }
    let _ = copy_fast_match(out, dist, m_len);
    return FastStepResult.Continue;
}

// Fast-path inner decoder (`inflate_fast`) handling literals and LZ77 matches inline
// while >= 16 input bytes remain and output is safely below `max_output_bytes`.
//
// Example:
//   r.pos = 0, r.src.len = 32
//   returns: true (on EOB) or false (to resume tail loop), CompressError.None
fn decode_huffman_fast_loop<B>(
    r:                BitReader&,
    lit_table:        const HuffmanTable&,
    dist_table:       const HuffmanTable&,
    out:              B&,
    out_start_pos:    i64,
    max_output_bytes: i64,
    max_window_dist:  i64 = 32768,
) -> bool, CompressError {
    var err = CompressError.None;
    while add_sat_i64(r.pos, 16) <= r.src.len && comp_has_room(out, 260) {
        if max_output_bytes > 0 {
            let produced = sub_sat_i64(out.len, out_start_pos);
            if add_sat_i64(produced, 260) > max_output_bytes {
                return false, CompressError.None;
            }
        }
        let status = step_inflate_fast(
            r, lit_table, dist_table, out, out_start_pos, max_window_dist, err,
        );
        if status == FastStepResult.Continue {
            continue;
        }
        if status == FastStepResult.EndOfBlock {
            return true, CompressError.None;
        }
        if status == FastStepResult.Error {
            return false, err;
        }
        return false, CompressError.None;
    }
    return false, CompressError.None;
}

// Decodes a single literal, EOB, or match length on the general/tail path.
// Returns (kind: 0=lit, 1=eob, 2=match), value (byte or match_len), CompressError.
//
// Example:
//   lit_table.fast[0] = 0x40000007
//   returns: 1, 0, CompressError.None
fn decode_slow_lit_or_len(
    r:         BitReader&,
    lit_table: const HuffmanTable&,
) -> i32, i32, CompressError {
    refill_bits_tail(r);
    if r.bit_count >= 9 {
        let entry = lit_table.fast[(r.bit_buf & 0x1FF) as! i64];
        if (entry & FAST_ENTRY_SLOW) == 0 {
            let code_bits = entry & 0xFF;
            r.bit_buf >>= code_bits;
            r.bit_count = ((r.bit_count as! u32) - code_bits) as! i32;
            if entry < 0x01000000 {
                return 0, ((entry >> 8) & 0xFF) as! i32, CompressError.None;
            }
            let op = entry >> 24;
            if op == FAST_OP_EOB {
                return 1, 0, CompressError.None;
            }
            if op == FAST_OP_INVALID {
                return 0, 0, CompressError.CorruptedBitstream;
            }
            let extra = op - 1;
            var m_len = (entry >> 8) & 0xFFFF;
            if extra > 0 {
                let xv, ok_x = read_bits(r, extra as! i32);
                guard ok_x else { return 0, 0, CompressError.InputBufferTruncated; }
                m_len += xv;
            }
            return 2, m_len as! i32, CompressError.None;
        }
    }

    let sym, ok_sym = decode_canonical_slow(r, lit_table);
    guard ok_sym else { return 0, 0, CompressError.InputBufferTruncated; }
    guard sym >= 0 else { return 0, 0, CompressError.InvalidHuffmanCode; }
    if sym < 256 {
        return 0, sym, CompressError.None;
    }
    if sym == 256 {
        return 1, 0, CompressError.None;
    }
    let len_idx = sym - 257;
    guard len_idx < 29 else { return 0, 0, CompressError.CorruptedBitstream; }
    let li = (len_idx as! u32) & 31;
    let extra_bits = LENS_EXTRA[li as i64];
    var match_len = LENS_BASE[li as i64] as! u32;
    if extra_bits > 0 {
        let xval, ok_x = read_bits(r, extra_bits);
        guard ok_x else { return 0, 0, CompressError.InputBufferTruncated; }
        match_len += xval;
    }
    return 2, match_len as! i32, CompressError.None;
}

// Decodes literal/length and distance Huffman codes for a Deflate block.
//
// Example:
//   sym = 256
//   returns: CompressError.None
fn decode_block_codes<B>(
    r:                BitReader&,
    lit_table:        const HuffmanTable&,
    dist_table:       const HuffmanTable&,
    out:              B&,
    dict:             const u8[:] = "",
    out_start_pos:    i64         = 0,
    max_output_bytes: i64         = 0,
    max_window_dist:  i64         = 32768,
) -> CompressError {
    let d_len = min(dict.len, max_window_dist);
    loop {
        if d_len == 0 {
            let done, fast_err = decode_huffman_fast_loop(
                r, lit_table, dist_table, out, out_start_pos, max_output_bytes, max_window_dist,
            );
            guard fast_err == CompressError.None else { return fast_err; }
            if done { return CompressError.None; }
        }

        let kind, val, l_err = decode_slow_lit_or_len(r, lit_table);
        guard l_err == CompressError.None else { return l_err; }

        if kind == 0 {
            if max_output_bytes > 0 && sub_sat_i64(out.len, out_start_pos) >= max_output_bytes {
                return CompressError.OutputBufferOverflow;
            }
            guard comp_try_push(out, (val & 0xFF) as! u8) else {
                return CompressError.OutputBufferOverflow;
            }
            continue;
        }
        if kind == 1 {
            break;
        }

        let match_dist, d_err = decode_match_distance(r, dist_table);
        guard d_err == CompressError.None else { return d_err; }

        let produced = sub_sat_i64(out.len, out_start_pos);
        if max_output_bytes > 0 && add_sat_i64(produced, val as i64) > max_output_bytes {
            return CompressError.OutputBufferOverflow;
        }
        let dist_i64 = match_dist as i64;
        guard dist_i64 <= max_window_dist && dist_i64 <= add_sat_i64(produced, d_len) else {
            return CompressError.DistanceOutOfBounds;
        }

        guard apply_deflate_match(out, dist_i64, val, out_start_pos, dict) else {
            return CompressError.OutputBufferOverflow;
        }
    }
    return CompressError.None;
}

fn inflate_stored_block<B>(
    r:                BitReader&,
    out:              B&,
    out_start_pos:    i64,
    max_output_bytes: i64,
) -> CompressError {
    align_to_byte(r);
    guard add_sat_i64(r.pos, 4) <= r.src.len else {
        return CompressError.InputBufferTruncated;
    }
    let len = (r.src[r.pos] as u32) | ((r.src[add_sat_i64(r.pos, 1)] as u32) << 8);
    let nlen = (r.src[add_sat_i64(r.pos, 2)] as u32) | ((r.src[add_sat_i64(r.pos, 3)] as u32) << 8);
    r.pos = add_sat_i64(r.pos, 4);
    guard ((len ^ 0xFFFF) & 0xFFFF) == nlen else {
        return CompressError.LengthMismatch;
    }
    let len_i64 = len as i64;
    let end_pos = add_sat_i64(r.pos, len_i64);
    guard end_pos <= r.src.len else {
        return CompressError.InputBufferTruncated;
    }
    if max_output_bytes > 0 {
        let produced = sub_sat_i64(out.len, out_start_pos);
        if add_sat_i64(produced, len_i64) > max_output_bytes {
            return CompressError.OutputBufferOverflow;
        }
    }
    if len_i64 > 0 {
        guard comp_try_append(out, r.src[r.pos..end_pos]) else {
            return CompressError.OutputBufferOverflow;
        }
    }
    r.pos = end_pos;
    return CompressError.None;
}

fn inflate_fixed_block<B>(
    r:                BitReader&,
    out:              B&,
    dict:             const u8[:],
    out_start_pos:    i64,
    max_output_bytes: i64,
    max_window_dist:  i64 = 32768,
) -> CompressError {
    return decode_block_codes(
        r, FIXED_LIT_DEC_TABLE, FIXED_DIST_DEC_TABLE,
        out, dict, out_start_pos, max_output_bytes, max_window_dist,
    );
}

fn fill_repeated_code_len(
    lit_dist_lens: i32[320]&,
    cur_idx:       u32&,
    total_codes:   u32,
    val:           i32,
    count:         u32,
) -> bool {
    guard cur_idx + count <= total_codes else { return false; }
    for i in count {
        lit_dist_lens[(cur_idx & 511) as i64] = val;
        cur_idx += 1;
    }
    return true;
}

fn read_dynamic_code_lengths(
    r:             BitReader&,
    h_code:        const HuffmanTable&,
    total_codes:   i32,
    lit_dist_lens: i32[320]&,
) -> CompressError {
    var cur_idx: u32 = 0;
    let tot_u32 = total_codes as! u32;
    while cur_idx < tot_u32 {
        let sym, ok_s = decode_codelen_symbol(r, h_code);
        guard ok_s else { return CompressError.InputBufferTruncated; }
        guard sym >= 0 else { return CompressError.InvalidHuffmanCode; }

        if sym < 16 {
            lit_dist_lens[cur_idx as i64] = sym;
            cur_idx += 1;
            continue;
        }
        if sym == 16 {
            guard cur_idx > 0 else { return CompressError.RepeatWithoutPreviousLength; }
            let prev_len = lit_dist_lens[(cur_idx - 1) as i64];
            let rpt_bits, ok_rb = read_bits(r, 2);
            guard ok_rb else { return CompressError.InputBufferTruncated; }
            guard fill_repeated_code_len(lit_dist_lens, cur_idx, tot_u32, prev_len, rpt_bits + 3) else {
                return CompressError.TooManyLengthOrDistanceCodes;
            }
            continue;
        }
        if sym == 17 || sym == 18 {
            let ebits:  i32 = if sym == 17 { 3 } else { 7 };
            let base_c: u32 = if sym == 17 { 3 } else { 11 };
            let rpt_bits, ok_rb = read_bits(r, ebits);
            guard ok_rb else { return CompressError.InputBufferTruncated; }
            guard fill_repeated_code_len(lit_dist_lens, cur_idx, tot_u32, 0, rpt_bits + base_c) else {
                return CompressError.TooManyLengthOrDistanceCodes;
            }
            continue;
        }
        return CompressError.InvalidHuffmanCode;
    }
    return CompressError.None;
}

fn validate_incomplete_distance_codes(lit_dist_lens: const i32[:], nlen: i32, ndist: i32) -> bool {
    var dist_non_zero: u32 = 0;
    var max_dist_len:  i32 = 0;
    for d in ndist {
        let dl = lit_dist_lens[add_sat_i64(nlen, d)];
        if dl > 0 {
            dist_non_zero += 1;
            if dl > max_dist_len { max_dist_len = dl; }
        }
    }
    return dist_non_zero == 0 || (dist_non_zero == 1 && max_dist_len == 1);
}

fn read_code_length_alphabet(r: BitReader&, ncode: i32, code_lens_table: i32[19]&) -> bool {
    for i in ncode {
        let clen, ok_cl = read_bits(r, 3);
        guard ok_cl else { return false; }
        code_lens_table[CODE_LENGTH_ORDER[i as i64] as i64] = clen as! i32;
    }
    return true;
}

inline fn huff_tree_status_error(res: i32) -> CompressError {
    if res < 0 { return CompressError.CodeLengthsOverSubscribed; }
    if res > 0 { return CompressError.CodeLengthsIncomplete; }
    return CompressError.None;
}

fn inflate_dynamic_block<B>(
    r:                BitReader&,
    out:              B&,
    dict:             const u8[:],
    out_start_pos:    i64,
    max_output_bytes: i64,
    max_window_dist:  i64 = 32768,
) -> CompressError {
    let hlit_val, ok_hlit = read_bits(r, 5);
    guard ok_hlit else { return CompressError.InputBufferTruncated; }
    guard hlit_val <= 29 else { return CompressError.TooManyLengthOrDistanceCodes; }
    let nlen = (hlit_val + 257) as! i32;

    let hdist_val, ok_hdist = read_bits(r, 5);
    guard ok_hdist else { return CompressError.InputBufferTruncated; }
    guard hdist_val <= 29 else { return CompressError.TooManyLengthOrDistanceCodes; }
    let ndist = (hdist_val + 1) as! i32;

    let hclen_val, ok_hclen = read_bits(r, 4);
    guard ok_hclen else { return CompressError.InputBufferTruncated; }
    let ncode = (hclen_val + 4) as! i32;

    var code_lens_table: i32[19] = [0; 19];
    guard read_code_length_alphabet(r, ncode, code_lens_table) else {
        return CompressError.InputBufferTruncated;
    }

    var h_code = HuffmanTable { .. };
    let err_c = huff_tree_status_error(
        construct_huffman_table(code_lens_table[..], 19, HuffTableKind.CodeLen, h_code),
    );
    guard err_c == CompressError.None else { return err_c; }

    var lit_dist_lens: i32[320] = [0; 320];
    let total_codes = ((nlen as! u32) + (ndist as! u32)) as! i32;
    let r_err = read_dynamic_code_lengths(r, h_code, total_codes, lit_dist_lens);
    guard r_err == CompressError.None else { return r_err; }

    // RFC 1951 Section 3.2.7: End-of-Block symbol 256 must have a non-zero code length
    guard lit_dist_lens[256] > 0 else { return CompressError.CodeLengthsIncomplete; }

    var dyn_lit = HuffmanTable { .. };
    let err_lit = huff_tree_status_error(
        construct_huffman_table(lit_dist_lens[..nlen], nlen, HuffTableKind.LitLen, dyn_lit),
    );
    guard err_lit == CompressError.None else { return err_lit; }

    var dyn_dist = HuffmanTable { .. };
    let res_dist = construct_huffman_table(
        lit_dist_lens[nlen..total_codes], ndist, HuffTableKind.Dist, dyn_dist,
    );
    if res_dist < 0 {
        return CompressError.CodeLengthsOverSubscribed;
    } else if res_dist > 0 {
        guard validate_incomplete_distance_codes(lit_dist_lens[..], nlen, ndist) else {
            return CompressError.CodeLengthsIncomplete;
        }
    }

    return decode_block_codes(
        r, dyn_lit, dyn_dist, out, dict, out_start_pos, max_output_bytes, max_window_dist,
    );
}

// Extended inflate: supports preset dictionary, max_output_bytes quota, and reports bytes consumed from src.
fn inflate_ex<B>(
    src:              const u8[:],
    out:              B&,
    dict:             const u8[:] = "",
    max_output_bytes: i64         = 0,
    max_window_dist:  i64         = 32768,
) -> CompressError, i64 {
    let out_start_pos = out.len;
    var r = BitReader { src: src, pos: 0, bit_buf: 0, bit_count: 0 };
    var is_final:       u32 = 0;
    var last_block_pos: i64 = 0;
    var last_out_len:   i64 = out_start_pos;

    while is_final == 0 {
        if (r.bit_count & 7) == 0 {
            let unconsumed = ((r.bit_count as! u32) >> 3) as i64;
            last_block_pos = sub_sat_i64(r.pos, unconsumed);
            last_out_len = out.len;
        }

        let hdr_bits, ok_hdr = read_bits(r, 3);
        guard ok_hdr else {
            out.resize(last_out_len);
            return CompressError.InputBufferTruncated, last_block_pos;
        }
        is_final = hdr_bits & 1;
        let btype = (hdr_bits >> 1) & 3;

        var err = CompressError.InvalidBlockType;
        if btype == 0 {
            err = inflate_stored_block(r, out, out_start_pos, max_output_bytes);
        } else if btype == 1 {
            err = inflate_fixed_block(r, out, dict, out_start_pos, max_output_bytes, max_window_dist);
        } else if btype == 2 {
            err = inflate_dynamic_block(r, out, dict, out_start_pos, max_output_bytes, max_window_dist);
        }
        guard err == CompressError.None else {
            if err == CompressError.InputBufferTruncated {
                out.resize(last_out_len);
                return err, last_block_pos;
            }
            return err, r.pos;
        }
    }

    align_to_byte(r);
    return CompressError.None, r.pos;
}

// Inflates RFC 1951 raw deflate stream from src into out.
fn inflate<B>(src: const u8[:], out: B&) -> bool, CompressError {
    let saved_len = out.len;
    let err, _ = inflate_ex(src, out, "", 0);
    if err != CompressError.None {
        out.resize(saved_len);
    }
    return err == CompressError.None, err;
}

// Inflates RFC 1951 raw deflate stream from src into out with a preset dictionary.
fn inflate_with_dict<B>(src: const u8[:], out: B&, dict: const u8[:]) -> bool, CompressError {
    let saved_len = out.len;
    let err, _ = inflate_ex(src, out, dict, 0);
    if err != CompressError.None {
        out.resize(saved_len);
    }
    return err == CompressError.None, err;
}

// Inflates RFC 1951 raw deflate stream with an output quota limit.
fn inflate_with_limit<B>(src: const u8[:], out: B&, max_output_bytes: i64) -> bool, CompressError {
    let saved_len = out.len;
    let err, _ = inflate_ex(src, out, "", max_output_bytes);
    if err != CompressError.None {
        out.resize(saved_len);
    }
    return err == CompressError.None, err;
}

// Inflates RFC 1951 raw deflate stream from src into out with a preset dictionary and an output quota limit.
fn inflate_with_dict_limit<B>(
    src:              const u8[:],
    out:              B&,
    dict:             const u8[:],
    max_output_bytes: i64,
) -> bool, CompressError {
    let saved_len = out.len;
    let err, _ = inflate_ex(src, out, dict, max_output_bytes);
    if err != CompressError.None {
        out.resize(saved_len);
    }
    return err == CompressError.None, err;
}

// ---- dynamic huffman builder (moffat-katajainen in-place algorithm) --------

struct SymFreq {
    key: i32 = 0,
    sym: i32 = 0,
}

// In-place minimum redundancy code length calculation (Alistair Moffat & Jyrki Katajainen, 1996).
fn calculate_minimum_redundancy(A: SymFreq[:], n: i32) {
    if n <= 0 { return; }
    if n == 1 {
        A[0].key = 1;
        return;
    }
    A[0].key += A[1].key;
    var root: i32 = 0;
    var leaf: i32 = 2;
    for next_idx in 1..(n - 1) {
        if leaf >= n || A[root].key < A[leaf].key {
            A[next_idx].key = A[root].key;
            A[root].key = next_idx;
            root++;
        } else {
            A[next_idx].key = A[leaf].key;
            leaf++;
        }
        if leaf >= n || (root < next_idx && A[root].key < A[leaf].key) {
            A[next_idx].key += A[root].key;
            A[root].key = next_idx;
            root++;
        } else {
            A[next_idx].key += A[leaf].key;
            leaf++;
        }
    }
    A[n - 2].key = 0;
    var back_idx = n - 3;
    while back_idx >= 0 {
        let parent = A[back_idx].key;
        A[back_idx].key = A[parent].key + 1;
        back_idx--;
    }
    var avbl: i32 = 1;
    var used: i32 = 0;
    var dpth: i32 = 0;
    root = n - 2;
    var next_slot = n - 1;
    while avbl > 0 {
        while root >= 0 && A[root].key == dpth {
            used++;
            root--;
        }
        while avbl > used {
            A[next_slot].key = dpth;
            next_slot--;
            avbl--;
        }
        avbl = 2 * used;
        dpth++;
        used = 0;
    }
}

// Limits canonical Huffman code table max code size to max_code_size (<= 15 bits).
fn enforce_max_code_size(num_codes: i32[33]&, code_list_len: i32, max_code_size: i32) {
    if code_list_len <= 1 { return; }
    var idx = max_code_size + 1;
    while idx <= 32 {
        num_codes[max_code_size] += num_codes[idx];
        num_codes[idx] = 0;
        idx++;
    }
    var total: u32 = 0;
    var i = max_code_size;
    while i > 0 {
        total += (num_codes[i] as u32) << ((max_code_size - i) as u32);
        i--;
    }
    let target = (1 as u32) << (max_code_size as u32);
    while total != target {
        num_codes[max_code_size]--;
        var j = max_code_size - 1;
        while j > 0 {
            if num_codes[j] > 0 {
                num_codes[j]--;
                num_codes[j + 1] += 2;
                break;
            }
            j--;
        }
        total--;
    }
}

inline fn reverse_bits_16(c: u32, l: i32) -> u16 {
    return reverse_bits_u32(c, l as! u32) as! u16;
}

fn assign_huffman_code_lens(
    syms:          const SymFreq[:],
    num_codes:     const i32[:],
    max_code_size: i32,
    code_lens:     i32[:],
) {
    var cur_sym_idx = syms.len as! u32;
    let max_cs = (max_code_size as! u32) + 1;
    for len_val in 1..max_cs {
        var count = num_codes[len_val as i64] as! u32;
        while count > 0 {
            cur_sym_idx -= 1;
            let target_sym = syms[cur_sym_idx as i64].sym as i64;
            code_lens[target_sym] = len_val as! i32;
            count -= 1;
        }
    }
}

// Builds canonical Huffman bit lengths and bit-reversed codes into fixed caller slices.
fn build_huffman_codes(
    counts:        const i32[:],
    max_code_size: i32,
    code_lens:     i32[:],
    codes:         u16[:],
) {
    var syms: SymFreq[..288] = [];
    for i in counts.len {
        code_lens[i] = 0;
        codes[i] = 0;
        if counts[i] > 0 {
            syms.push(SymFreq { key: counts[i], sym: i as! i32 });
        }
    }

    if syms.len == 0 {
        return;
    }
    if syms.len == 1 {
        let s = syms[0].sym as i64;
        code_lens[s] = 1;
        codes[s] = 0;
        return;
    }

    sort(syms) { x, y => x.key < y.key };
    calculate_minimum_redundancy(syms[..], syms.len as! i32);

    var num_codes: i32[33] = [0; 33];
    for &s in syms {
        if s.key >= 0 && s.key <= 32 {
            num_codes[s.key] = ((num_codes[s.key] as! u32) + 1) as! i32;
        }
    }

    enforce_max_code_size(num_codes, syms.len as! i32, max_code_size);
    assign_huffman_code_lens(syms[..], num_codes[..], max_code_size, code_lens);

    var next_code:    u32[33] = [0; 33];
    var running_code: u32     = 0;
    let max_cs = (max_code_size as! u32) + 1;
    for len_val in 1..max_cs {
        running_code = (running_code + (num_codes[(len_val - 1) as i64] as! u32)) << 1;
        next_code[len_val as i64] = running_code;
    }

    for i in counts.len {
        let l = code_lens[i];
        if l > 0 {
            let li = (l as! u32) & 31;
            let c = next_code[li as i64];
            next_code[li as i64] = c + 1;
            codes[i] = reverse_bits_16(c, l);
        }
    }
}

// Run-length encoded representation of literal/distance code lengths.
struct RleToken {
    sym:        i32 = 0,
    extra_val:  u32 = 0,
    extra_bits: i32 = 0,
}

fn rle_encode_lengths(lens: const i32[:], out: RleToken[..320]&) {
    out.clear();
    var i: i64 = 0;
    let n = lens.len;
    while i < n {
        let cur = lens[i];
        var run: i64 = 1;
        while i + run < n && lens[i + run] == cur {
            run++;
        }
        if cur == 0 {
            while run >= 11 {
                let take = min(run, 138);
                out.push(RleToken { sym: 18, extra_val: (take - 11) as u32, extra_bits: 7 });
                run -= take;
                i += take;
            }
            if run >= 3 {
                out.push(RleToken { sym: 17, extra_val: (run - 3) as u32, extra_bits: 3 });
                i += run;
                run = 0;
            }
            for k in run {
                out.push(RleToken { sym: 0, extra_val: 0, extra_bits: 0 });
                i++;
            }
        } else {
            out.push(RleToken { sym: cur, extra_val: 0, extra_bits: 0 });
            i++;
            run--;
            while run >= 3 {
                let take = min(run, 6);
                out.push(RleToken { sym: 16, extra_val: (take - 3) as u32, extra_bits: 2 });
                run -= take;
                i += take;
            }
            for k in run {
                out.push(RleToken { sym: cur, extra_val: 0, extra_bits: 0 });
                i++;
            }
        }
    }
}

// Compact 4-byte LZ77 token: dist == 0 means literal/EOB (0..256), dist > 0 means match (len 3..258, dist 1..32768).
struct LzToken {
    lit_len: u16 = 0,
    dist:    u16 = 0,
}

// ---- compressor: rfc 1951 deflate ------------------------------------------

inline fn length_code_index(l: i32) -> u32 {
    return LENGTH_SYM[(((l as! u32) - 3) & 255) as i64];
}

inline fn dist_code_index(d: i32) -> u32 {
    let dm1 = (d as! u32) - 1;
    let idx = if dm1 < 256 { dm1 } else { 256 + (dm1 >> 7) };
    return DIST_SYM[(idx & 511) as i64];
}

// Compression tuning parameters per level (0..9) matching zlib-ng standards.
struct DeflateConfig {
    max_chain: i32,
    good_len:  i32,
    max_lazy:  i32,
    nice_len:  i32,
}

fn get_deflate_config(level: i32) -> DeflateConfig {
    if level <= 1 {
        return DeflateConfig { max_chain: 4, good_len: 4, max_lazy: 0, nice_len: 8 };
    } else if level == 2 {
        return DeflateConfig { max_chain: 8, good_len: 4, max_lazy: 0, nice_len: 16 };
    } else if level == 3 {
        return DeflateConfig { max_chain: 32, good_len: 4, max_lazy: 0, nice_len: 32 };
    } else if level == 4 {
        return DeflateConfig { max_chain: 16, good_len: 4, max_lazy: 4, nice_len: 16 };
    } else if level == 5 {
        return DeflateConfig { max_chain: 32, good_len: 8, max_lazy: 16, nice_len: 32 };
    } else if level == 6 {
        return DeflateConfig { max_chain: 128, good_len: 8, max_lazy: 16, nice_len: 128 };
    } else if level == 7 {
        return DeflateConfig { max_chain: 256, good_len: 8, max_lazy: 32, nice_len: 128 };
    } else if level == 8 {
        return DeflateConfig { max_chain: 1024, good_len: 32, max_lazy: 128, nice_len: 258 };
    } else {
        return DeflateConfig { max_chain: 4096, good_len: 32, max_lazy: 258, nice_len: 258 };
    }
}

// Emits uncompressed RFC 1951 Stored blocks (BTYPE 00).
fn emit_stored_blocks<B>(src: const u8[:], out: B&, w: BitWriter&, is_final: bool) {
    var offset: i64 = 0;
    while offset < src.len || (src.len == 0 && offset == 0) {
        let remaining = sub_sat_i64(src.len, offset);
        let block_size = min(remaining, 65535);
        let next_off = add_sat_i64(offset, block_size);
        let is_last = is_final && (next_off >= src.len);
        let bfinal_bit: u32 = if is_last { 1 } else { 0 };

        write_bits(w, bfinal_bit, 3, out);
        flush_bits(w, out);

        let len_u16 = block_size as! u16;
        let nlen_u16 = ~len_u16;
        record_bw_write(w, comp_try_write_le_u16(out, len_u16));
        record_bw_write(w, comp_try_write_le_u16(out, nlen_u16));
        if block_size > 0 {
            record_bw_write(w, comp_try_append(out, src[offset..next_off]));
        }
        if w.overflow { return; }
        offset = next_off;
        if src.len == 0 { break; }
    }
}

inline fn emit_fixed_literal<B>(w: BitWriter&, b: u8, out: B&) {
    let lp = FIXED_LIT_PACKED[b as i64];
    emit_bits_fast(w, (lp & 0xFFFF) as u64, lp >> 16, out);
}

inline fn emit_fixed_match<B>(w: BitWriter&, m_len: i32, dist: i32, out: B&) {
    let lp = FIXED_MATCH_LEN_PACKED[(((m_len as! u32) - 3) & 255) as i64];
    let l_bits = (lp & 0xFFFF) as u64;
    let l_nbits = lp >> 16;

    let dsym = dist_code_index(dist);
    let d_extra_bits = DISTS_EXTRA[dsym as i64] as! u32;
    let d_extra_val = ((dist as! u32) - (DISTS_BASE[dsym as i64] as! u32)) as u64;
    let d_bits = (FIXED_DIST_CODE[dsym as i64] as u64) | (d_extra_val << 5);
    let comb = l_bits | (d_bits << (l_nbits as u64));
    emit_bits_fast(w, comb, l_nbits + 5 + d_extra_bits, out);
}

// Emits RFC 1951 Fixed Huffman block (BTYPE 01) from compact LZ77 tokens.
fn emit_fixed_block<B>(tokens: const LzToken[:], out: B&, w: BitWriter&, is_final: bool) {
    let bfinal_bit: u32 = if is_final { 1 } else { 0 };
    emit_bits_fast(w, (bfinal_bit | 2) as u64, 3, out);

    for &tok in tokens {
        if tok.dist > 0 {
            emit_fixed_match(w, tok.lit_len as i32, tok.dist as i32, out);
        } else {
            let sym_idx = (tok.lit_len & 511) as i64;
            if sym_idx < 256 {
                emit_fixed_literal(w, sym_idx as! u8, out);
            } else {
                let code = FIXED_LIT_CODE[sym_idx] as u64;
                let nbits = FIXED_LIT_LEN[sym_idx] as u32;
                emit_bits_fast(w, code, nbits, out);
            }
        }
    }
    if is_final {
        flush_bits(w, out);
    } else {
        drain_full_bytes(w, out);
    }
}

// ---- level-1 single-pass fast compressor (zero token materialization) ------

inline fn extend_match_fast(src: const u8[:], pos: i64, cand: i64, end_pos: i64) -> i32 {
    let max_l = min(sub_sat_i64(end_pos, pos), 258);
    var l: i64 = 4;
    while add_sat_i64(l, 8) <= max_l {
        let diff = read_le_u64(src, add_sat_i64(pos, l)) ^ read_le_u64(src, add_sat_i64(cand, l));
        if diff != 0 {
            let tz = ctz(diff) >> 3;
            return add_sat_i64(l, tz) as! i32;
        }
        l = add_sat_i64(l, 8);
    }
    while l < max_l && src[add_sat_i64(pos, l)] == src[add_sat_i64(cand, l)] {
        l = add_sat_i64(l, 1);
    }
    return l as! i32;
}

inline fn emit_literal_span<B>(src: const u8[:], start: i64, end_pos: i64, w: BitWriter&, out: B&) {
    var p = start;
    while p < end_pos {
        emit_fixed_literal(w, src[p], out);
        p = add_sat_i64(p, 1);
    }
}

fn deflate_fast_l1_small<B>(src: const u8[:], out: B&, w: BitWriter&, is_final: bool) -> bool {
    let out_mark = out.len;
    let saved_w = w;
    let pad_bits = ((8 - (((saved_w.bit_count as! u32) + 3) & 7)) & 7) as i64;
    let stored_bits = 3 + pad_bits + 32 + (src.len * 8);

    var head: u16[2048] = [0; 2048];
    let bfinal_bit: u32 = if is_final { 1 } else { 0 };
    emit_bits_fast(w, (bfinal_bit | 2) as u64, 3, out);

    var pos:          i64 = 0;
    var miss_counter: u32 = 32;
    let limit = sub_sat_i64(src.len, 12);

    while pos <= limit {
        let v = read_le_u32(src, pos);
        let h = ((v * LZ_HASH_MUL) >> 21) & 2047;
        let cand_p1 = head[h as i64] as i64;
        head[h as i64] = ((pos as! u32) + 1) as! u16;

        let cand = cand_p1 - 1;
        if cand_p1 > 0 && read_le_u32(src, cand) == v {
            miss_counter = 32;
            let m_len = extend_match_fast(src, pos, cand, src.len);
            let dist = sub_sat_i64(pos, cand) as! i32;
            emit_fixed_match(w, m_len, dist, out);
            let next_pos = add_sat_i64(pos, m_len as i64);
            if m_len <= 16 && next_pos <= limit {
                let anchor = sub_sat_i64(next_pos, 2);
                let av = read_le_u32(src, anchor);
                let ah = ((av * LZ_HASH_MUL) >> 21) & 2047;
                head[ah as i64] = ((anchor as! u32) + 1) as! u16;
            }
            pos = next_pos;
            continue;
        }

        miss_counter += 1;
        let step = (miss_counter >> 5) as i64;
        let stop = min(add_sat_i64(pos, step), limit + 1);
        emit_literal_span(src, pos, stop, w, out);
        pos = stop;
    }

    emit_literal_span(src, pos, src.len, w, out);
    emit_bits_fast(w, 0, 7, out);
    drain_full_bytes(w, out);
    guard !w.overflow else { return false; }

    let byte_bits = mul_sat_i64(sub_sat_i64(out.len, out_mark), 8);
    let emitted_bits = add_sat_i64(byte_bits, sub_sat_i64(w.bit_count as i64, saved_w.bit_count as i64));
    if emitted_bits >= stored_bits {
        out.resize(out_mark);
        w = saved_w;
        emit_stored_blocks(src, out, w, is_final);
        return !w.overflow;
    }
    if is_final {
        flush_bits(w, out);
    }
    return !w.overflow;
}

inline fn run_fast_l1_chunk_loop<B>(
    src:         const u8[:],
    chunk_start: i64,
    chunk_end:   i64,
    head:        u32[16384]&,
    out:         B&,
    w:           BitWriter&,
) -> i64, bool {
    var pos = chunk_start;
    var miss_counter:  u32 = 32;
    var matches_found: u32 = 0;
    let limit = sub_sat_i64(chunk_end, 12);
    let probe_mark = add_sat_i64(chunk_start, 2048);

    while pos <= limit {
        let v = read_le_u32(src, pos);
        let h = ((v * LZ_HASH_MUL) >> 18) & 16383;
        let cand_p1 = head[h as i64] as i64;
        head[h as i64] = (pos as! u32) + 1;

        let cand = cand_p1 - 1;
        let dist = sub_sat_i64(pos, cand);
        if cand_p1 > 0 && dist <= 32768 && read_le_u32(src, cand) == v {
            miss_counter = 32;
            matches_found += 1;
            let m_len = extend_match_fast(src, pos, cand, chunk_end);
            emit_fixed_match(w, m_len, dist as! i32, out);
            let next_pos = add_sat_i64(pos, m_len as i64);
            if m_len <= 16 && next_pos <= limit {
                let anchor = sub_sat_i64(next_pos, 2);
                let av = read_le_u32(src, anchor);
                let ah = ((av * LZ_HASH_MUL) >> 18) & 16383;
                head[ah as i64] = (anchor as! u32) + 1;
            }
            pos = next_pos;
            continue;
        }
        if matches_found == 0 && pos >= probe_mark {
            return pos, true;
        }
        miss_counter += 1;
        let step = (miss_counter >> 5) as i64;
        let stop = min(add_sat_i64(pos, step), limit + 1);
        emit_literal_span(src, pos, stop, w, out);
        pos = stop;
    }
    return pos, false;
}

fn deflate_fast_l1_chunk<B>(
    src:            const u8[:],
    chunk_start:    i64,
    chunk_end:      i64,
    chunk_is_final: bool,
    head:           u32[16384]&,
    out:            B&,
    w:              BitWriter&,
) {
    let chunk_out_mark = out.len;
    let chunk_saved_w = w;
    let chunk_len = sub_sat_i64(chunk_end, chunk_start);
    let pad_bits = ((8 - (((chunk_saved_w.bit_count as! u32) + 3) & 7)) & 7) as i64;
    let stored_bits = 3 + pad_bits + 32 + (chunk_len * 8);

    let bfinal_bit: u32 = if chunk_is_final { 1 } else { 0 };
    emit_bits_fast(w, (bfinal_bit | 2) as u64, 3, out);

    let pos, bail_stored = run_fast_l1_chunk_loop(src, chunk_start, chunk_end, head, out, w);
    guard !w.overflow else { return; }
    if bail_stored {
        out.resize(chunk_out_mark);
        w = chunk_saved_w;
        emit_stored_blocks(src[chunk_start..chunk_end], out, w, chunk_is_final);
        return;
    }

    emit_literal_span(src, pos, chunk_end, w, out);
    emit_bits_fast(w, 0, 7, out);
    drain_full_bytes(w, out);
    guard !w.overflow else { return; }

    let w_diff = sub_sat_i64(w.bit_count as i64, chunk_saved_w.bit_count as i64);
    let emitted_bits = add_sat_i64(mul_sat_i64(sub_sat_i64(out.len, chunk_out_mark), 8), w_diff);
    if emitted_bits >= stored_bits {
        out.resize(chunk_out_mark);
        w = chunk_saved_w;
        emit_stored_blocks(src[chunk_start..chunk_end], out, w, chunk_is_final);
        return;
    }
    if chunk_is_final {
        flush_bits(w, out);
    }
}

fn deflate_fast_l1_simd<B>(src: const u8[:], out: B&, w: BitWriter&) -> bool {
    let out_mark = out.len;
    var bit_state: u64[2] = [0, 0];
    if src.len <= 4000 {
        var head: u32[2048] = [0; 2048];
        var dst:  u8[4096]  = [0; 4096];
        let n = native_deflate_l1_chunk(src, 0, src.len, 1, head[..], bit_state[..], dst[..]);
        guard n >= 0 else { return false; }
        guard comp_try_append(out, dst[..n]) else {
            w.overflow = true;
            return false;
        }
        return true;
    } else if src.len <= 16384 {
        var head: u32[4096] = [0; 4096];
        var dst:  u8[16448] = [0; 16448];
        let n = native_deflate_l1_chunk(src, 0, src.len, 1, head[..], bit_state[..], dst[..]);
        guard n >= 0 else { return false; }
        guard comp_try_append(out, dst[..n]) else {
            w.overflow = true;
            return false;
        }
        return true;
    }
    var head:        u32[16384] = [0; 16384];
    var dst:         u8[65600]  = [0; 65600];
    var chunk_start: i64        = 0;
    while chunk_start < src.len {
        let chunk_end = min(add_sat_i64(chunk_start, 65535), src.len);
        let chunk_final: i32 = if chunk_end >= src.len { 1 } else { 0 };
        let n = native_deflate_l1_chunk(
            src, chunk_start, chunk_end, chunk_final,
            head[..], bit_state[..], dst[..],
        );
        guard n >= 0 else {
            out.resize(out_mark);
            return false;
        }
        guard comp_try_append(out, dst[..n]) else {
            w.overflow = true;
            out.resize(out_mark);
            return false;
        }
        chunk_start = chunk_end;
    }
    return true;
}

fn deflate_fast_level1<B>(src: const u8[:], out: B&, w: BitWriter&, is_final: bool) -> bool {
    if w.bit_count == 0 && is_final && deflate_fast_l1_simd(src, out, w) {
        return true;
    }
    guard !w.overflow else { return false; }
    if src.len <= 16384 {
        return deflate_fast_l1_small(src, out, w, is_final);
    }
    var head:        u32[16384] = [0; 16384];
    var chunk_start: i64        = 0;
    while chunk_start < src.len {
        let chunk_end = min(add_sat_i64(chunk_start, 65535), src.len);
        let chunk_is_final = is_final && (chunk_end >= src.len);
        deflate_fast_l1_chunk(src, chunk_start, chunk_end, chunk_is_final, head, out, w);
        guard !w.overflow else { return false; }
        chunk_start = chunk_end;
    }
    return !w.overflow;
}

// ---- general lz77 match finder (levels 2..9 & preset dictionaries) ---------

inline fn hash3_nodict(src: const u8[:], pos: i64) -> i64 {
    let tri = src[pos] |
              ((src[add_sat_i64(pos, 1)] as u32) << 8) |
              ((src[add_sat_i64(pos, 2)] as u32) << 16);
    return ((tri * LZ_HASH_MUL) >> 17) & 32767;
}

inline fn hash3_small(src: const u8[:], pos: i64) -> i64 {
    let tri = src[pos] |
              ((src[add_sat_i64(pos, 1)] as u32) << 8) |
              ((src[add_sat_i64(pos, 2)] as u32) << 16);
    return ((tri * LZ_HASH_MUL) >> 20) & 4095;
}

inline fn match_len_nodict(src: const u8[:], pos: i64, cand: i64, max_l: i64) -> i32 {
    var l: i64 = 0;
    while add_sat_i64(l, 8) <= max_l {
        let diff = read_le_u64(src, add_sat_i64(pos, l)) ^ read_le_u64(src, add_sat_i64(cand, l));
        if diff != 0 {
            let tz = ctz(diff) >> 3;
            return add_sat_i64(l, tz) as! i32;
        }
        l = add_sat_i64(l, 8);
    }
    while l < max_l && src[add_sat_i64(pos, l)] == src[add_sat_i64(cand, l)] {
        l = add_sat_i64(l, 1);
    }
    return l as! i32;
}

inline fn probe_cand_len_nodict(
    src:        const u8[:],
    pos:        i64,
    cand_i64:   i64,
    cur_len:    i32,
    max_l:      i64,
    has_u32:    bool,
    target_u32: u32,
) -> i32 {
    let end_idx = add_sat_i64(pos, cur_len);
    if cur_len > 0 && end_idx < src.len && src[end_idx] != src[add_sat_i64(cand_i64, cur_len)] {
        return 0;
    }
    if has_u32 {
        let diff4 = read_le_u32(src, cand_i64) ^ target_u32;
        if diff4 == 0 {
            return 4 + match_len_nodict(src, add_sat_i64(pos, 4), add_sat_i64(cand_i64, 4), max_l - 4);
        }
        if (diff4 & 0x00FFFFFF) == 0 {
            return 3;
        }
        return 0;
    }
    return match_len_nodict(src, pos, cand_i64, max_l);
}

fn find_longest_match_nodict(
    src:       const u8[:],
    pos:       i64,
    cand_init: i32,
    max_chain: i32,
    nice_len:  i32,
    prev:      const i32[:],
    mask:      i64,
) -> i32, i32 {
    let max_l = min(sub_sat_i64(src.len, pos), 258);
    guard max_l >= 3 else { return 0, 0; }

    let has_u32 = max_l >= 4;
    let target_u32 = if has_u32 { read_le_u32(src, pos) } else { 0 };
    var cur_len:  i32 = 0;
    var cur_dist: i32 = 0;
    var cand = cand_init;
    var chain_count: u32 = 0;
    let chain_lim = max_chain as! u32;

    while cand >= 0 && chain_count < chain_lim {
        let cand_i64 = cand as i64;
        let dist = sub_sat_i64(pos, cand_i64);
        if dist > 32768 || dist <= 0 { break; }

        let l = probe_cand_len_nodict(src, pos, cand_i64, cur_len, max_l, has_u32, target_u32);
        if l > cur_len {
            cur_len = l;
            cur_dist = dist as! i32;
            if cur_len >= nice_len || cur_len >= 258 { break; }
        }
        if dist == 32768 { break; }
        cand = prev[cand_i64 & mask];
        chain_count += 1;
    }

    return cur_len, cur_dist;
}

inline fn push_match_token(
    match_len:  i32,
    match_dist: i32,
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) {
    let l_sym = 257 + length_code_index(match_len);
    let d_sym = dist_code_index(match_dist);
    tokens.push(LzToken { lit_len: match_len as! u16, dist: match_dist as! u16 });
    lit_count[l_sym as i64] = ((lit_count[l_sym as i64] as! u32) + 1) as! i32;
    dist_count[d_sym as i64] = ((dist_count[d_sym as i64] as! u32) + 1) as! i32;
}

inline fn push_literal_token(
    sym:       u16,
    tokens:    LzToken[>..]&,
    lit_count: i32[288]&,
) {
    tokens.push(LzToken { lit_len: sym, dist: 0 });
    let idx = (sym & 511) as i64;
    lit_count[idx] = ((lit_count[idx] as! u32) + 1) as! i32;
}

fn insert_skip_hashes_nodict(
    src:        const u8[:],
    start_pos:  i64,
    match_len:  i32,
    nice_len:   i32,
    head:       i32[:],
    prev:       i32[:],
    small_hash: bool,
) {
    let m_len = match_len as i64;
    if match_len >= nice_len && m_len > 12 {
        let end_anchor = add_sat_i64(start_pos, m_len - 2);
        if add_sat_i64(end_anchor, 2) < src.len {
            let h = if small_hash { hash3_small(src, end_anchor) } else { hash3_nodict(src, end_anchor) };
            let mask: i64 = if small_hash { 8191 } else { 32767 };
            prev[end_anchor & mask] = head[h];
            head[h] = end_anchor as! i32;
        }
        return;
    }
    let limit = sub_sat_i64(src.len, 2);
    for k in 1..m_len {
        let p = add_sat_i64(start_pos, k);
        if p >= limit { break; }
        let h = if small_hash { hash3_small(src, p) } else { hash3_nodict(src, p) };
        let mask: i64 = if small_hash { 8191 } else { 32767 };
        prev[p & mask] = head[h];
        head[h] = p as! i32;
    }
}

struct LazyState {
    prev_len:        i32  = 0,
    prev_dist:       i32  = 0,
    match_available: bool = false,
    miss_run:        u32  = 0,
}

inline fn emit_miss_step_nodict(
    src:       const u8[:],
    pos:       i64,
    st:        LazyState&,
    tokens:    LzToken[>..]&,
    lit_count: i32[288]&,
) -> i64 {
    st.miss_run += 1;
    if st.miss_run > 128 {
        let step = min((1 + ((st.miss_run - 128) >> 5)) as i64, sub_sat_i64(src.len, pos));
        for i in step {
            push_literal_token(src[add_sat_i64(pos, i)], tokens, lit_count);
        }
        return add_sat_i64(pos, step);
    }
    push_literal_token(src[pos], tokens, lit_count);
    return add_sat_i64(pos, 1);
}

fn step_lz77_nodict(
    src:        const u8[:],
    pos:        i64,
    cur_len:    i32,
    cur_dist:   i32,
    cfg:        DeflateConfig,
    small_hash: bool,
    st:         LazyState&,
    head:       i32[:],
    prev:       i32[:],
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) -> i64 {
    if cfg.max_lazy == 0 {
        if cur_len >= 3 {
            st.miss_run = 0;
            push_match_token(cur_len, cur_dist, tokens, lit_count, dist_count);
            insert_skip_hashes_nodict(src, pos, cur_len, cfg.nice_len, head, prev, small_hash);
            return add_sat_i64(pos, cur_len);
        }
        return emit_miss_step_nodict(src, pos, st, tokens, lit_count);
    }

    if st.match_available {
        if cur_len > st.prev_len {
            push_literal_token(src[sub_sat_i64(pos, 1)], tokens, lit_count);
            st.prev_len = cur_len;
            st.prev_dist = cur_dist;
            if cur_len >= cfg.max_lazy || cur_len >= 258 {
                push_match_token(cur_len, cur_dist, tokens, lit_count, dist_count);
                insert_skip_hashes_nodict(src, pos, cur_len, cfg.nice_len, head, prev, small_hash);
                st.match_available = false;
                return add_sat_i64(pos, cur_len);
            }
            return add_sat_i64(pos, 1);
        }
        push_match_token(st.prev_len, st.prev_dist, tokens, lit_count, dist_count);
        let match_end = add_sat_i64(sub_sat_i64(pos, 1), st.prev_len);
        if st.prev_len > 2 {
            insert_skip_hashes_nodict(src, pos, st.prev_len - 1, cfg.nice_len, head, prev, small_hash);
        }
        st.match_available = false;
        return match_end;
    }

    if cur_len >= 3 {
        st.miss_run = 0;
        st.prev_len = cur_len;
        st.prev_dist = cur_dist;
        if cur_len >= cfg.max_lazy || cur_len >= 258 {
            push_match_token(cur_len, cur_dist, tokens, lit_count, dist_count);
            insert_skip_hashes_nodict(src, pos, cur_len, cfg.nice_len, head, prev, small_hash);
            return add_sat_i64(pos, cur_len);
        }
        st.match_available = true;
        return add_sat_i64(pos, 1);
    }

    return emit_miss_step_nodict(src, pos, st, tokens, lit_count);
}

fn lz77_run_nodict_tables(
    src:        const u8[:],
    cfg:        DeflateConfig,
    small_hash: bool,
    head:       i32[:],
    prev:       i32[:],
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) {
    let mask: i64 = if small_hash { 8191 } else { 32767 };
    var pos: i64 = 0;
    var st = LazyState {};

    while pos < src.len {
        var cand: i32 = -1;
        if add_sat_i64(pos, 2) < src.len {
            let h = if small_hash { hash3_small(src, pos) } else { hash3_nodict(src, pos) };
            cand = head[h];
            prev[pos & mask] = cand;
            head[h] = pos as! i32;
        }

        var cur_len:  i32 = 0;
        var cur_dist: i32 = 0;
        if cand >= 0 {
            var max_chain = cfg.max_chain;
            if st.match_available && st.prev_len >= cfg.good_len {
                max_chain = ((max_chain as! u32) >> 2) as! i32;
            }
            cur_len, cur_dist = find_longest_match_nodict(
                src, pos, cand, max_chain, cfg.nice_len, prev, mask,
            );
        }

        pos = step_lz77_nodict(
            src, pos, cur_len, cur_dist, cfg, small_hash, st,
            head, prev, tokens, lit_count, dist_count,
        );
    }

    if st.match_available {
        push_match_token(st.prev_len, st.prev_dist, tokens, lit_count, dist_count);
    }
    push_literal_token(256, tokens, lit_count);
}

fn lz77_find_matches_nodict(
    src:        const u8[:],
    cfg:        DeflateConfig,
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) {
    if src.len <= 8192 {
        var head_s: i32[4096] = [-1; 4096];
        var prev_s: i32[8192] = [0; 8192];
        lz77_run_nodict_tables(src, cfg, true, head_s[..], prev_s[..], tokens, lit_count, dist_count);
        return;
    }
    var head_l: i32[32768] = [-1; 32768];
    var prev_l: i32[32768] = [0; 32768];
    lz77_run_nodict_tables(src, cfg, false, head_l[..], prev_l[..], tokens, lit_count, dist_count);
}

// ---- preset-dictionary lz77 match finder (dict_len > 0) --------------------

inline fn get_deflate_byte(pos: i64, dict_slice: const u8[:], dict_len: i64, src: const u8[:]) -> u8 {
    return if pos < dict_len { dict_slice[pos] } else { src[sub_sat_i64(pos, dict_len)] };
}

fn update_skip_hash_dict(
    skip_pos:   i64,
    total_len:  i64,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
    head:       i32[4096]&,
    prev:       i32[32768]&,
) {
    if add_sat_i64(skip_pos, 2) < total_len {
        let sb0 = get_deflate_byte(skip_pos, dict_slice, dict_len, src) as u32;
        let sb1 = get_deflate_byte(add_sat_i64(skip_pos, 1), dict_slice, dict_len, src) as u32;
        let sb2 = get_deflate_byte(add_sat_i64(skip_pos, 2), dict_slice, dict_len, src) as u32;
        let sh = (((sb0 << 8) ^ (sb1 << 4) ^ sb2) & 4095) as i64;
        prev[skip_pos & 32767] = head[sh];
        head[sh] = skip_pos as! i32;
    }
}

fn match_len_at_offset_dict(
    pos:        i64,
    cand:       i64,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
    total_len:  i64,
) -> i32 {
    var l: i64 = 0;
    let max_l = min(sub_sat_i64(total_len, pos), 258);
    let s_off = sub_sat_i64(pos, dict_len);
    let c_off = sub_sat_i64(cand, dict_len);
    if c_off >= 0 {
        while add_sat_i64(l, 8) <= max_l {
            let diff = read_le_u64(src, add_sat_i64(s_off, l)) ^ read_le_u64(src, add_sat_i64(c_off, l));
            if diff != 0 {
                l = add_sat_i64(l, ctz(diff) >> 3);
                break;
            }
            l = add_sat_i64(l, 8);
        }
    }
    while l < max_l {
        let byte_s = get_deflate_byte(add_sat_i64(pos, l), dict_slice, dict_len, src);
        let byte_c = get_deflate_byte(add_sat_i64(cand, l), dict_slice, dict_len, src);
        if byte_s != byte_c { break; }
        l = add_sat_i64(l, 1);
    }
    return l as! i32;
}

inline fn match_endpoint_mismatch_dict(
    pos:        i64,
    cand:       i64,
    cur_len:    i32,
    total_len:  i64,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
) -> bool {
    guard cur_len > 0 else { return false; }
    let p_s_check = add_sat_i64(pos, cur_len);
    guard p_s_check < total_len else { return false; }
    let p_c_check = add_sat_i64(cand, cur_len);
    let b_s = get_deflate_byte(p_s_check, dict_slice, dict_len, src);
    let b_c = get_deflate_byte(p_c_check, dict_slice, dict_len, src);
    return b_s != b_c;
}

fn find_longest_match_dict(
    pos:        i64,
    cand_init:  i32,
    max_chain:  i32,
    nice_len:   i32,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
    total_len:  i64,
    prev:       const i32[:],
) -> i32, i32 {
    var cur_len:  i32 = 0;
    var cur_dist: i32 = 0;
    var cand = cand_init;
    var chain_count: u32 = 0;
    let chain_lim = max_chain as! u32;

    while cand >= 0 && chain_count < chain_lim {
        let cand_i64 = cand as i64;
        let dist = sub_sat_i64(pos, cand_i64);
        if dist > 32768 || dist <= 0 { break; }

        if !match_endpoint_mismatch_dict(pos, cand_i64, cur_len, total_len, dict_slice, dict_len, src) {
            let l = match_len_at_offset_dict(pos, cand_i64, dict_slice, dict_len, src, total_len);
            if l > cur_len {
                cur_len = l;
                cur_dist = dist as! i32;
                if cur_len >= nice_len || cur_len >= 258 { break; }
            }
        }
        if dist == 32768 { break; }
        cand = prev[cand_i64 & 32767];
        chain_count += 1;
    }

    return cur_len, cur_dist;
}

fn update_range_hashes_dict(
    start_pos:  i64,
    end_pos:    i64,
    total_len:  i64,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
    head:       i32[4096]&,
    prev:       i32[32768]&,
) {
    var k = start_pos;
    while k < end_pos {
        update_skip_hash_dict(k, total_len, dict_slice, dict_len, src, head, prev);
        k = add_sat_i64(k, 1);
    }
}

fn step_lz77_dict(
    pos:        i64,
    cur_len:    i32,
    cur_dist:   i32,
    cfg:        DeflateConfig,
    total_len:  i64,
    dict_slice: const u8[:],
    dict_len:   i64,
    src:        const u8[:],
    st:         LazyState&,
    head:       i32[4096]&,
    prev:       i32[32768]&,
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) -> i64 {
    if st.match_available {
        if cur_len <= st.prev_len {
            push_match_token(st.prev_len, st.prev_dist, tokens, lit_count, dist_count);
            let match_end = add_sat_i64(sub_sat_i64(pos, 1), st.prev_len);
            update_range_hashes_dict(
                add_sat_i64(pos, 1), match_end, total_len, dict_slice, dict_len, src, head, prev,
            );
            st.match_available = false;
            return match_end;
        }
        let prev_b = get_deflate_byte(sub_sat_i64(pos, 1), dict_slice, dict_len, src);
        push_literal_token(prev_b, tokens, lit_count);
        st.prev_len = cur_len;
        st.prev_dist = cur_dist;
        if cur_len >= cfg.max_lazy || cur_len >= 258 {
            push_match_token(cur_len, cur_dist, tokens, lit_count, dist_count);
            let next_pos = add_sat_i64(pos, cur_len);
            update_range_hashes_dict(
                add_sat_i64(pos, 1), next_pos, total_len, dict_slice, dict_len, src, head, prev,
            );
            st.match_available = false;
            return next_pos;
        }
        return add_sat_i64(pos, 1);
    }

    if cur_len >= 3 {
        if cfg.max_lazy == 0 || cur_len >= cfg.max_lazy || cur_len >= 258 {
            push_match_token(cur_len, cur_dist, tokens, lit_count, dist_count);
            let next_pos = add_sat_i64(pos, cur_len);
            update_range_hashes_dict(
                add_sat_i64(pos, 1), next_pos, total_len, dict_slice, dict_len, src, head, prev,
            );
            return next_pos;
        }
        st.prev_len = cur_len;
        st.prev_dist = cur_dist;
        st.match_available = true;
        return add_sat_i64(pos, 1);
    }

    push_literal_token(get_deflate_byte(pos, dict_slice, dict_len, src), tokens, lit_count);
    return add_sat_i64(pos, 1);
}

fn lz77_find_matches_dict(
    src:        const u8[:],
    dict_slice: const u8[:],
    dict_len:   i64,
    total_len:  i64,
    cfg:        DeflateConfig,
    tokens:     LzToken[>..]&,
    lit_count:  i32[288]&,
    dist_count: i32[32]&,
) {
    var head: i32[4096]  = [-1; 4096];
    var prev: i32[32768] = [0; 32768];

    if dict_len >= 3 {
        for p in sub_sat_i64(dict_len, 2) {
            let b0 = dict_slice[p] as u32;
            let b1 = dict_slice[add_sat_i64(p, 1)] as u32;
            let b2 = dict_slice[add_sat_i64(p, 2)] as u32;
            let h = (((b0 << 8) ^ (b1 << 4) ^ b2) & 4095) as i64;
            prev[p & 32767] = head[h];
            head[h] = p as! i32;
        }
    }

    var pos = dict_len;
    var st = LazyState {};

    while pos < total_len {
        var cand: i32 = -1;
        if add_sat_i64(pos, 2) < total_len {
            let b0 = get_deflate_byte(pos, dict_slice, dict_len, src) as u32;
            let b1 = get_deflate_byte(add_sat_i64(pos, 1), dict_slice, dict_len, src) as u32;
            let b2 = get_deflate_byte(add_sat_i64(pos, 2), dict_slice, dict_len, src) as u32;
            let h = (((b0 << 8) ^ (b1 << 4) ^ b2) & 4095) as i64;
            cand = head[h];
            prev[pos & 32767] = cand;
            head[h] = pos as! i32;
        }

        var cur_len:  i32 = 0;
        var cur_dist: i32 = 0;
        if cand >= 0 {
            var max_chain = cfg.max_chain;
            if st.match_available && st.prev_len >= cfg.good_len {
                max_chain = ((max_chain as! u32) >> 2) as! i32;
            }
            cur_len, cur_dist = find_longest_match_dict(
                pos, cand, max_chain, cfg.nice_len,
                dict_slice, dict_len, src, total_len, prev[..],
            );
        }

        pos = step_lz77_dict(
            pos, cur_len, cur_dist, cfg, total_len, dict_slice, dict_len, src,
            st, head, prev, tokens, lit_count, dist_count,
        );
    }

    if st.match_available {
        push_match_token(st.prev_len, st.prev_dist, tokens, lit_count, dist_count);
    }
    push_literal_token(256, tokens, lit_count);
}

// ---- exact bit-cost calculators & dynamic block emitter --------------------

fn calc_fixed_bits_from_counts(lit_count: const i32[288]&, dist_count: const i32[32]&) -> i64 {
    var bits: u64 = 3;
    for s in 257 {
        bits += (lit_count[s] as! u64) * FIXED_LIT_LEN[s];
    }
    for k in 29 {
        let sym = 257 + k;
        let cost = FIXED_LIT_LEN[sym] + (LENS_EXTRA[k] as! u64);
        bits += (lit_count[sym] as! u64) * cost;
    }
    for d in 30 {
        let d_cost = 5 + (DISTS_EXTRA[d] as! u64);
        bits += (dist_count[d] as! u64) * d_cost;
    }
    return bits as! i64;
}

fn calc_dynamic_bit_cost_from_counts(
    ncode:         i32,
    rle_tokens:    const RleToken[:],
    hclen_lens:    const i32[19]&,
    lit_count:     const i32[288]&,
    dist_count:    const i32[32]&,
    dyn_lit_lens:  const i32[288]&,
    dyn_dist_lens: const i32[32]&,
    has_dists:     bool,
) -> i64 {
    var dyn_bits: u64 = 17 + ((ncode as! u64) * 3);
    for &rt in rle_tokens {
        let sym_idx = ((rt.sym as! u32) & 31) as i64;
        if sym_idx < 19 {
            dyn_bits += (hclen_lens[sym_idx] as! u64) + (rt.extra_bits as! u64);
        }
    }
    for s in 257 {
        dyn_bits += (lit_count[s] as! u64) * (dyn_lit_lens[s] as! u64);
    }
    for k in 29 {
        let sym = 257 + k;
        let m_cost = (dyn_lit_lens[sym] as! u64) + (LENS_EXTRA[k] as! u64);
        dyn_bits += (lit_count[sym] as! u64) * m_cost;
    }
    if has_dists {
        for d in 30 {
            let d_cost = (dyn_dist_lens[d] as! u64) + (DISTS_EXTRA[d] as! u64);
            dyn_bits += (dist_count[d] as! u64) * d_cost;
        }
    }
    return dyn_bits as! i64;
}

fn build_dynamic_combined_lens(
    dyn_lit_lens:  const i32[288]&,
    dyn_dist_lens: const i32[32]&,
    combined_lens: i32[..320]&,
) -> i32, i32 {
    var nlen: u32 = 286;
    while nlen > 257 && dyn_lit_lens[(nlen - 1) as i64] == 0 {
        nlen -= 1;
    }
    var ndist: u32 = 30;
    while ndist > 1 && dyn_dist_lens[(ndist - 1) as i64] == 0 {
        ndist -= 1;
    }
    combined_lens.clear();
    for i in nlen {
        combined_lens.push(dyn_lit_lens[i as i64]);
    }
    for j in ndist {
        combined_lens.push(dyn_dist_lens[j as i64]);
    }
    return nlen as! i32, ndist as! i32;
}

fn build_dynamic_code_length_tree(
    rle_tokens:  const RleToken[:],
    hclen_lens:  i32[19]&,
    hclen_codes: u16[19]&,
) -> i32 {
    var code_len_counts: i32[19] = [0; 19];
    for &rt in rle_tokens {
        if rt.sym >= 0 && rt.sym < 19 {
            code_len_counts[rt.sym] = ((code_len_counts[rt.sym] as! u32) + 1) as! i32;
        }
    }

    build_huffman_codes(code_len_counts[..], 7, hclen_lens[..], hclen_codes[..]);

    var ncode: u32 = 19;
    while ncode > 4 && hclen_lens[CODE_LENGTH_ORDER[(ncode - 1) as i64] as i64] == 0 {
        ncode -= 1;
    }
    return ncode as! i32;
}

fn write_dynamic_block_header<B>(
    w:          BitWriter&,
    bfinal_bit: u32,
    nlen:       i32,
    ndist:      i32,
    ncode:      i32,
    hclen_lens: const i32[19]&,
    out:        B&,
) {
    let hdr_val = (bfinal_bit | 4) |
                  (((nlen as! u32) - 257) << 3) |
                  (((ndist as! u32) - 1) << 8) |
                  (((ncode as! u32) - 4) << 13);
    emit_bits_fast(w, hdr_val as u64, 17, out);

    for i in ncode {
        let order_sym = CODE_LENGTH_ORDER[i as i64] as i64;
        let clen_val = hclen_lens[order_sym] as! u64;
        emit_bits_fast(w, clen_val, 3, out);
    }
}

fn write_dynamic_huffman_payload<B>(
    tokens:         const LzToken[:],
    rle_tokens:     const RleToken[:],
    hclen_codes:    const u16[19]&,
    hclen_lens:     const i32[19]&,
    dyn_lit_codes:  const u16[288]&,
    dyn_lit_lens:   const i32[288]&,
    dyn_dist_codes: const u16[32]&,
    dyn_dist_lens:  const i32[32]&,
    w:              BitWriter&,
    out:            B&,
) {
    for &rt in rle_tokens {
        let sym_idx = rt.sym as i64;
        let c = hclen_codes[sym_idx] as u64;
        let l = hclen_lens[sym_idx] as! u32;
        let tot_bits = l + (rt.extra_bits as! u32);
        let comb = c | ((rt.extra_val as u64) << (l as u64));
        emit_bits_fast(w, comb, tot_bits, out);
    }

    for &tok in tokens {
        if tok.dist > 0 {
            let m_len = tok.lit_len as i32;
            let li = length_code_index(m_len);
            let sym_idx = (257 + li) as i64;
            let lc = dyn_lit_codes[sym_idx] as u64;
            let ll = dyn_lit_lens[sym_idx] as! u32;
            let le_bits = LENS_EXTRA[li as i64] as! u32;
            let le_val = ((m_len as! u32) - (LENS_BASE[li as i64] as! u32)) as u64;
            emit_bits_fast(w, lc | (le_val << (ll as u64)), ll + le_bits, out);

            let dist = tok.dist as i32;
            let di = dist_code_index(dist);
            let dc = dyn_dist_codes[di as i64] as u64;
            let dl = dyn_dist_lens[di as i64] as! u32;
            let de_bits = DISTS_EXTRA[di as i64] as! u32;
            let de_val = ((dist as! u32) - (DISTS_BASE[di as i64] as! u32)) as u64;
            emit_bits_fast(w, dc | (de_val << (dl as u64)), dl + de_bits, out);
        } else {
            let sym_idx = (tok.lit_len & 511) as i64;
            let c = dyn_lit_codes[sym_idx] as u64;
            let l = dyn_lit_lens[sym_idx] as! u32;
            emit_bits_fast(w, c, l, out);
        }
    }
}

fn prepare_dist_tree_counts(dist_count: const i32[32]&, tree_counts: i32[32]&) -> bool {
    var non_zero: u32 = 0;
    for i in 30 {
        let c = dist_count[i];
        tree_counts[i] = c;
        if c > 0 {
            non_zero += 1;
        }
    }
    tree_counts[30] = 0;
    tree_counts[31] = 0;
    if non_zero == 0 {
        tree_counts[0] = 1;
        tree_counts[1] = 1;
        return false;
    }
    if non_zero == 1 {
        if tree_counts[0] == 0 {
            tree_counts[0] = 1;
        } else {
            tree_counts[1] = 1;
        }
    }
    return true;
}

fn emit_dynamic_deflate_block<B>(
    tokens:      const LzToken[:],
    lit_count:   const i32[288]&,
    dist_count:  const i32[32]&,
    out:         B&,
    w:           BitWriter&,
    bfinal_bit:  u32,
    stored_bits: i64,
    fixed_bits:  i64,
    src:         const u8[:],
    is_final:    bool,
) -> bool {
    var dist_tree_counts: i32[32] = [0; 32];
    let has_dists = prepare_dist_tree_counts(dist_count, dist_tree_counts);

    var dyn_lit_lens:  i32[288] = [0; 288];
    var dyn_lit_codes: u16[288] = [0; 288];
    build_huffman_codes(lit_count[..], 15, dyn_lit_lens[..], dyn_lit_codes[..]);

    var dyn_dist_lens:  i32[32] = [0; 32];
    var dyn_dist_codes: u16[32] = [0; 32];
    build_huffman_codes(dist_tree_counts[..], 15, dyn_dist_lens[..], dyn_dist_codes[..]);

    var combined_lens: i32[..320] = [];
    let nlen, ndist = build_dynamic_combined_lens(dyn_lit_lens, dyn_dist_lens, combined_lens);

    var rle_tokens: RleToken[..320] = [];
    rle_encode_lengths(combined_lens[..], rle_tokens);

    var hclen_lens:  i32[19] = [0; 19];
    var hclen_codes: u16[19] = [0; 19];
    let ncode = build_dynamic_code_length_tree(rle_tokens[..], hclen_lens, hclen_codes);

    let dyn_bits = calc_dynamic_bit_cost_from_counts(
        ncode, rle_tokens[..], hclen_lens,
        lit_count, dist_count, dyn_lit_lens, dyn_dist_lens, has_dists,
    );

    if stored_bits <= fixed_bits && stored_bits <= dyn_bits {
        emit_stored_blocks(src, out, w, is_final);
        return true;
    }
    if fixed_bits <= dyn_bits {
        emit_fixed_block(tokens, out, w, is_final);
        return true;
    }

    write_dynamic_block_header(w, bfinal_bit, nlen, ndist, ncode, hclen_lens, out);
    write_dynamic_huffman_payload(
        tokens, rle_tokens[..], hclen_codes, hclen_lens,
        dyn_lit_codes, dyn_lit_lens, dyn_dist_codes, dyn_dist_lens,
        w, out,
    );

    if is_final {
        flush_bits(w, out);
    } else {
        drain_full_bytes(w, out);
    }
    return true;
}

inline fn finalize_deflate_block<B>(
    ok:       bool,
    out:      B&,
    out_mark: i64,
    w:        BitWriter&,
    saved_w:  BitWriter,
) -> bool {
    if !ok || w.overflow {
        out.resize(out_mark);
        w = saved_w;
        w.overflow = true;
        return false;
    }
    return true;
}

fn deflate_block<B>(
    src:      const u8[:],
    out:      B&,
    w:        BitWriter&,
    level:    i32         = 6,
    is_final: bool        = true,
    dict:     const u8[:] = "",
) -> bool {
    if w.overflow { return false; }
    let out_mark = out.len;
    let saved_w = w;

    if level <= 0 {
        emit_stored_blocks(src, out, w, is_final);
        return finalize_deflate_block(true, out, out_mark, w, saved_w);
    }
    if level == 1 && dict.len == 0 {
        let ok_l1 = deflate_fast_level1(src, out, w, is_final);
        return finalize_deflate_block(ok_l1, out, out_mark, w, saved_w);
    }

    let bfinal_bit: u32 = if is_final { 1 } else { 0 };
    let cfg = get_deflate_config(level);

    var tokens:     LzToken[>..] = [];
    var lit_count:  i32[288]     = [0; 288];
    var dist_count: i32[32]      = [0; 32];

    if dict.len == 0 {
        lz77_find_matches_nodict(src, cfg, tokens, lit_count, dist_count);
    } else {
        let dict_slice = if dict.len > 32768 { dict[^32768..] } else { dict };
        let dict_len = dict_slice.len;
        let total_len = add_sat_i64(dict_len, src.len);
        lz77_find_matches_dict(
            src, dict_slice, dict_len, total_len, cfg,
            tokens, lit_count, dist_count,
        );
    }

    let num_chunks = if src.len == 0 {
        1 as i64
    } else {
        let q, _ = div_rem_u64(add_sat_u64(src.len as! u64, 65534), 65535);
        q as! i64
    };
    let pad_bits = ((8 - (((w.bit_count as! u32) + 3) & 7)) & 7) as i64;
    let chunk_overhead = mul_sat_i64(sub_sat_i64(num_chunks, 1), 40);
    let stored_bits = add_sat_i64(add_sat_i64(pad_bits, 35), add_sat_i64(chunk_overhead, mul_sat_i64(src.len, 8)));
    let fixed_bits = calc_fixed_bits_from_counts(lit_count, dist_count);

    if level < 6 || src.len < 128 {
        if stored_bits <= fixed_bits {
            emit_stored_blocks(src, out, w, is_final);
        } else {
            emit_fixed_block(tokens[..], out, w, is_final);
        }
        return finalize_deflate_block(true, out, out_mark, w, saved_w);
    }

    let ok_dyn = emit_dynamic_deflate_block(
        tokens[..], lit_count, dist_count, out, w,
        bfinal_bit, stored_bits, fixed_bits, src, is_final,
    );
    return finalize_deflate_block(ok_dyn, out, out_mark, w, saved_w);
}

// Compresses src into out using RFC 1951 Deflate.
fn deflate<B>(src: const u8[:], out: B&, level: i32 = 6) -> bool {
    var w = BitWriter { bit_buf: 0, bit_count: 0 };
    return deflate_block(src, out, w, level, true, "");
}

// Compresses src into out using RFC 1951 Deflate with a preset dictionary.
fn deflate_with_dict<B>(src: const u8[:], out: B&, level: i32, dict: const u8[:]) -> bool {
    var w = BitWriter { bit_buf: 0, bit_count: 0 };
    return deflate_block(src, out, w, level, true, dict);
}
