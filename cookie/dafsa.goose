const DAFSA_OFFSET_TYPE_MASK:   u8 = 0x60;
const DAFSA_OFFSET_LOW_MASK:    u8 = 0x1F;
const DAFSA_OFFSET_SINGLE_MASK: u8 = 0x3F;
const DAFSA_RETURN_VAL_MASK:    u8 = 0x0F;

