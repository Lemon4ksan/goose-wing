# goose-lit configuration
baseline = .lit/baseline
ceiling = 25.0
cov_profile = .lit/cache/cov/merged.info
delta = 5.0
bce = true
include_tests = false
format = table
prefix = CHECK
src_dir = .
tests_dir = tests
jobs = auto
timeout = 300
exclude = tests/lit/wire_kit.goose, tests/fuzz/, tests/wasm_runner.goose, tools/goosemarklint/, tools/goose2rfc/src/, vendor/
cc = gcc
cc_windows = tools/gcc_noavx.cmd
profile_target = bench/server_profiling_benchmark.goose
fuzz_entry = tests/fuzz/c_fuzz_entry.goose
fuzz_extra_c = shim/rio.c, shim/uring.c, shim/kqueue.c, shim/simd.c, shim/tcp.c, shim/af_xdp.c, shim/dpdk.c, shim/smartnic.c, shim/page_ring.c, shim/page_mem.c, shim/spsc.c, shim/crypto_fusion.c, shim/tls_backend.c
fuzz_extra_libs_windows = ws2_32, mswsock
fuzz_extra_libs_linux = pthread, m, dl
fuzz_extra_libs_macos = pthread, m
sloc_baseline = .lit/sloc-baseline
sloc_map = .lit/sloc-map
sloc_exclude = tests/, tools/, bench/, examples/, vendor/
sloc_bce_entries = core.goose, wing.goose
sloc_max_packing = 1.35
sloc_max_delta = 0
sloc_cycle_noise = 5.0
