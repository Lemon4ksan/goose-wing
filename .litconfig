# goose-lit configuration
baseline = .lit/baseline
ceiling = 25.0
cov = 0.85
delta = 5.0
bce = true
include_tests = false
format = table
prefix = CHECK
src_dir = .
tests_dir = tests
timeout = 300
exclude = tests/lit/wire_kit.goose, tests/lit/alloc_kit.goose, tests/fuzz/, tests/wasm_runner.goose, tools/goosemarklint/, vendor/
cc = tools/gcc_stack.bat
