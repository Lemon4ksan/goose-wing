fn test_zstd_deep_paths(t: lit::T&) {
    t.run("Zstd formatted dict, compressed+treeless literals, incremental, levels & errors") { sub =>
        var out: u8[>..] = [];
        let ok_fd, err_fd = core::zstd_decompress_with_dict(ZSTD_FMT_DICT_FRAME[..], DICT_FORMATTED[..], out);
        sub.assert_true(ok_fd && core::ok(err_fd) && out.len == 168, "formatted zstd dict frame decompressed");

        out.clear();
        let ok_v, err_v = core::zstd_decompress(ZSTD_VARIED_FRAME[..], out);
        sub.assert_true(ok_v && core::ok(err_v) && out.len == 5800, "varied huf+fse zstd frame decompressed");

        // Multi-block (>140KB) + levels 1, 2, 3, tiny/medium, without checksum, empty
        var huge: u8[>..] = [];
        for i in 140000 { huge.push(('a' + ((i * 7 + (i / 13)) % 26)) as u8); }
        var c_huge: u8[>..] = [];
        sub.assert_true(core::zstd_compress_level(huge[..], c_huge, 1, false), "zstd L1 140KB no checksum");
        out.clear();
        let ok_h1, _ = core::zstd_decompress(c_huge[..], out);
        sub.assert_true(ok_h1 && out[..] == huge[..], "140KB multi-block roundtrip");

        c_huge.clear();
        sub.assert_true(core::zstd_compress_level(huge[..8000], c_huge, 2, true), "zstd L2 medium");
        out.clear();
        let ok_h2, _ = core::zstd_decompress(c_huge[..], out);
        sub.assert_true(ok_h2 && out[..] == huge[..8000], "L2 8KB medium roundtrip");

        c_huge.clear();
        sub.assert_true(core::zstd_compress_level("", c_huge, 3, true), "zstd empty frame");
        out.clear();
        let ok_em, _ = core::zstd_decompress(c_huge[..], out);
        sub.assert_true(ok_em && out.len == 0, "empty zstd roundtrip");

        // Incremental frames: two complete frames + truncated third frame
        var stream2: u8[>..] = [];
        sub.assert_true(core::zstd_compress("frame-one-data", stream2, true), "frame 1");
        let split_mark = stream2.len;
        sub.assert_true(core::zstd_compress("frame-two-data", stream2, true), "frame 2");
        sub.assert_true(core::zstd_compress("frame-three", stream2, false), "frame 3");
        let trunc_slice = stream2[..stream2.len - 2];
        out.clear();
        let cons, inc_err = core::zstd_decompress_frames_incremental(trunc_slice, out);
        sub.assert_true(core::ok(inc_err) && cons > split_mark && out[..] == "frame-one-dataframe-two-data", "incremental stops cleanly at truncated 3rd frame");

        var bounded: u8[..64] = [];
        let cons_b, b_err = core::zstd_decompress_frames_incremental(stream2[..split_mark], bounded);
        sub.assert_true(core::ok(b_err) && cons_b == split_mark && bounded[..] == "frame-one-data", "generic bounded incremental zstd");

        // Corrupted magic, reserved block type 3, bounded output overflow
        let bad_magic: u8[8] = [0x01, 0x02, 0x03, 0x04, 0, 0, 0, 0];
        let ok_bm, err_bm = core::zstd_decompress(bad_magic[..], out);
        sub.assert_false(ok_bm && core::ok(err_bm));
        // Valid header + block type 3 (reserved): magic + FHD(0x20, 1B FCS=1) + block_hdr((3<<1)|1 = 7)
        let bad_blk: u8[9] = [0x28, 0xB5, 0x2F, 0xFD, 0x20, 0x01, 0x07, 0x00, 0x00];
        let ok_bb, err_bb = core::zstd_decompress(bad_blk[..], out);
        sub.assert_false(ok_bb || core::ok(err_bb));
    };
}

fn test_brotli_and_deflate_deep(t: lit::T&) {
    t.run("Brotli rich Q9, metadata block, small L1 & multi-metablock >66KB") { sub =>
        var out: u8[>..] = [];
        let ok_r, err_r = core::brotli_decompress(BR_RICH_Q9[..], out);
        sub.assert_true(ok_r && core::ok(err_r) && out.len == 1544, "BR_RICH_Q9 decompresses cleanly");
        sub.assert_true(core::contains(out[..], "https://auth.example.com"), "BR_RICH_Q9 content exact");

        out.clear();
        let ok_m, err_m = core::brotli_decompress(BR_METADATA_EMPTY[..], out);
        sub.assert_true(ok_m && core::ok(err_m) && out.len == 0, "BR_METADATA_EMPTY ok");

        // Empty compress + <4KB L1 (scan_brotli_lz77_small) + >66KB L1 (multi-metablock)
        var br_c: u8[>..] = [];
        sub.assert_true(core::brotli_compress("", br_c, 1), "brotli empty compress");
        out.clear();
        let ok_e, _ = core::brotli_decompress(br_c[..], out);
        sub.assert_true(ok_e && out.len == 0, "brotli empty roundtrip");

        var small_rep: u8[>..] = [];
        for i in 900 { small_rep.push(('0' + (i % 10)) as u8); }
        br_c.clear();
        sub.assert_true(core::brotli_compress(small_rep[..], br_c, 1), "brotli small L1 compress");
        out.clear();
        let ok_sr, _ = core::brotli_decompress(br_c[..], out);
        sub.assert_true(ok_sr && out[..] == small_rep[..], "brotli small L1 roundtrip");

        var big68: u8[>..] = [];
        for i in 68000 { big68.push(('a' + ((i * 5) % 26)) as u8); }
        br_c.clear();
        sub.assert_true(core::brotli_compress(big68[..], br_c, 1), "brotli >66KB L1 multi-metablock");
        out.clear();
        let ok_b68, _ = core::brotli_decompress(br_c[..], out);
        sub.assert_true(ok_b68 && out[..] == big68[..], "brotli >66KB roundtrip");

        // Trailing non-zero bit / trailing garbage rejected
        br_c.push(0xFF);
        let ok_tr, _ = core::brotli_decompress(br_c[..], out);
        sub.assert_false(ok_tr, "trailing brotli bytes rejected");
    };

    t.run("Deflate >9-bit slow Huffman, L1 small, sync flush w/ dict, Gzip & Zlib errors") { sub =>
        var out: u8[>..] = [];
        let ok_sk, err_sk = core::inflate(DF_SKEWED[..], out);
        sub.assert_true(ok_sk && core::ok(err_sk) && out.len == 9350, "DF_SKEWED (>9-bit codes) inflated");

        // Deflate fast L1 small (<= 16KB) and sync flush with preset dict
        var small_df_in: u8[>..] = [];
        for i in 2048 { small_df_in.push(('A' + (i % 17)) as u8); }
        var df1s: u8[>..] = [];
        sub.assert_true(core::deflate(small_df_in[..], df1s, 1), "deflate L1 2KB");
        out.clear();
        let ok_1s, _ = core::inflate(df1s[..], out);
        sub.assert_true(ok_1s && out[..] == small_df_in[..], "deflate L1 2KB roundtrip");

        let dict = "header-dictionary-prefix-value-xyz";
        let sync_in = "header-dictionary-prefix-value-xyz tail data";
        var sync_wire: u8[>..] = [];
        sub.assert_true(core::deflate_sync_flush_with_dict(sync_in, sync_wire, 6, dict, 32768), "deflate_sync_flush_with_dict");
        // Finalize with final empty stored block (BFINAL=1, BTYPE=0, len=0, nlen=0xFFFF)
        sync_wire.push(0x01);
        sync_wire.push(0x00); sync_wire.push(0x00);
        sync_wire.push(0xFF); sync_wire.push(0xFF);
        out.clear();
        let ok_sf, _ = core::inflate_with_dict(sync_wire[..], out, dict);
        sub.assert_true(ok_sf && out[..] == sync_in, "deflate_sync_flush_with_dict roundtrip");

        // Negative Zlib & Gzip errors
        var zwire: u8[>..] = [];
        sub.assert_true(core::zlib_compress("hello zlib", zwire, 6), "zlib compress");
        zwire[1] ^= 0x01; // break FCHECK
        let ok_zf, err_zf = core::zlib_decompress(zwire[..], out);
        sub.assert_false(ok_zf);
        sub.assert_true(err_zf == core::CompressError.InvalidHeader, "bad FCHECK -> InvalidHeader");
        zwire[1] ^= 0x01;
        zwire[zwire.len - 1] ^= 0xFF; // break Adler32
        let ok_za, err_za = core::zlib_decompress(zwire[..], out);
        sub.assert_false(ok_za);
        sub.assert_true(err_za == core::CompressError.ChecksumMismatch, "bad Adler32 -> ChecksumMismatch");
        zwire[zwire.len - 1] ^= 0xFF;
        zwire.push(0x00); // trailing byte
        let ok_zt, err_zt = core::zlib_decompress(zwire[..], out);
        sub.assert_false(ok_zt);
        sub.assert_true(err_zt == core::CompressError.CorruptedBitstream, "trailing zlib byte -> CorruptedBitstream");

        var gzwire: u8[>..] = [];
        sub.assert_true(core::gzip_compress("hello gzip", gzwire, 6), "gzip compress");
        gzwire[gzwire.len - 5] ^= 0xFF; // break CRC32
        let ok_gc, err_gc = core::gzip_decompress(gzwire[..], out);
        sub.assert_false(ok_gc || core::ok(err_gc));
        gzwire[gzwire.len - 5] ^= 0xFF;
        gzwire[gzwire.len - 1] ^= 0xFF; // break ISIZE
        let ok_gi, err_gi = core::gzip_decompress(gzwire[..], out);
        sub.assert_false(ok_gi || core::ok(err_gi));
    };
}

fn main() {
    let runner = lit::new_runner("Core Codecs Deep Verification Suite");
    lit::run_case(runner, "1. Zstd Formatted Dict, Multi-block & Errors", test_zstd_deep_paths);
    lit::run_case(runner, "2. Brotli Rich Q9, Metadata & Deflate/Zlib/Gzip Edges", test_brotli_and_deflate_deep);
    assert(lit::finish(runner));
}
