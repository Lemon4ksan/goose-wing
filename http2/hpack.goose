// ---- huffman codec primitives -------------------------------------------

struct HuffDecode {
    fstate: u8 = 0,
    flags:  u8 = 0,
    sym:    u8 = 0,
}

struct HuffContext {
    fstate: u8 = 0,
    flags:  u8 = 0x01, // HUFF_ACCEPTED at root
}

fn new_huff_context() -> HuffContext {
    return HuffContext { fstate: 0, flags: HUFF_ACCEPTED };
}

inline fn huff_decode_lookup(state: u8, nibble: u8) -> HuffDecode {
    let idx = ((state as u32) << 4) | (nibble & 0x0F);
    let packed = HUFF_DECODE_TABLE_PACKED[idx];
    return HuffDecode {
        fstate: (packed & 0xFF) as u8,
        flags:  ((packed >> 8) & 0xFF) as u8,
        sym:    ((packed >> 16) & 0xFF) as u8,
    };
}

// Decodes a slice of Huffman-encoded bytes into preallocated dst.
// Processes two 4-bit nibbles per byte without dynamic allocations or branches.
//
// Example:
//   src = [0x9C, 0xC5], dst_len = 0, is_final = true
//   returns: written = 3, ok = true
fn huff_decode_step(
    ctx:      HuffContext&,
    dst:      u8[:],
    dst_len:  u64,
    src:      const u8[:],
    is_final: bool,
) -> u64, bool {
    var state = ctx.fstate;
    var flags = ctx.flags;
    var out_idx = dst_len;
    var i: u64 = 0;
    let src_len = src.len as u64;
    var last_sym_byte: i64 = -1;

    while i < src_len {
        let c = src[i];

        // Step 1: High nibble (bits 7..4)
        let t1 = huff_decode_lookup(state, c >> 4);
        if (t1.flags & HUFF_FAIL) != 0 {
            return out_idx, false;
        }
        if (t1.flags & HUFF_SYM) != 0 {
            if out_idx >= (dst.len as u64) {
                return out_idx, false;
            }
            dst[out_idx] = t1.sym;
            out_idx++;
            last_sym_byte = i as i64;
        }

        // Step 2: Low nibble (bits 3..0)
        let t2 = huff_decode_lookup(t1.fstate, c & 0x0F);
        if (t2.flags & HUFF_FAIL) != 0 {
            return out_idx, false;
        }
        if (t2.flags & HUFF_SYM) != 0 {
            if out_idx >= (dst.len as u64) {
                return out_idx, false;
            }
            dst[out_idx] = t2.sym;
            out_idx++;
            last_sym_byte = i as i64;
        }

        state = t2.fstate;
        flags = t2.flags;
        i++;
    }
    ctx.fstate = state;
    ctx.flags = flags;

    // EOS & Padding check (RFC 7541 Section 5.2 & RFC 9204 Section 4.1.2):
    // If final, state must be one of the accepted states (all '1' padding bits)
    // and padding MUST NOT exceed 7 bits (cannot consume a full byte after last symbol).
    if is_final {
        if (flags & HUFF_ACCEPTED) == 0 {
            return out_idx, false;
        }
        if src_len > 0 && last_sym_byte != ((src_len as i64) - 1) {
            return out_idx, false;
        }
    }
    return out_idx, true;
}

// Decodes a Huffman-encoded byte slice directly into any appendable buffer.
fn huff_decode_bytes<B>(src: const u8[:], out: B&) -> bool {
    var ctx = new_huff_context();
    var tmp: u8[8192] = [0; 8192];
    let written, ok = huff_decode_step(ctx, tmp[..], 0, src, true);
    guard ok else { return false; }
    guard out.len + (written as i64) <= out.cap else { return false; }
    out.append(tmp[..written as i64]);
    return true;
}

// Example:
//   src = [0x9C, 0xC5], out = []
//   returns: ok = true, out contains "www"
inline fn decode_huffman_exact<B>(src: const u8[:], out: B&) -> bool {
    return huff_decode_bytes(src, out);
}

// Calculates the exact Huffman-encoded byte length of an uncompressed string.
fn huff_encoded_byte_len(src: const u8[:]) -> u64 {
    var total_bits: u64 = 0;
    for b in src {
        total_bits += HUFF_SYM_LENS[b];
    }
    return (total_bits + 7) / 8;
}

// Encodes uncompressed bytes using canonical RFC 7541 Huffman code into out.
fn huff_encode_bytes<B>(src: const u8[:], out: B&) -> bool {
    var acc:   u64 = 0;
    var nbits: u32 = 0;

    for b in src {
        let code = HUFF_SYM_CODES[b] as u64;
        let clen = HUFF_SYM_LENS[b] as u32;
        acc = (acc << clen) | code;
        nbits += clen;

        while nbits >= 8 {
            nbits -= 8;
            guard out.try_push(((acc >> nbits) & 0xFF) as u8) else { return false; }
        }
    }

    // RFC 7541 Section 5.2: pad remaining bits with 1s (EOS prefix)
    if nbits > 0 {
        let pad_bits = 8 - nbits;
        acc = (acc << pad_bits) | (((1 as u64) << pad_bits) - 1);
        guard out.try_push((acc & 0xFF) as u8) else { return false; }
    }
    return true;
}

// ---- integer codec with shift overflow protection -----------------------

// Decodes an HPACK integer with N-bit prefix (RFC 7541 Section 5.1).
// Guards against shift overflow (shift >= 28) and integer overflow (Trail of Bits FIND-401).
// Returns (value, next_offset, ok).
//
// Example:
//   src = [0x0A], offset = 0, prefix_bits = 5
//   returns: val = 10, next_offset = 1, ok = true
fn hpack_decode_int(src: const u8[:], offset: u64, prefix_bits: u8) -> u64, u64, bool {
    guard offset < (src.len as u64) else { return 0, offset, false; }
    guard prefix_bits >= 1 && prefix_bits <= 8 else { return 0, offset, false; }

    let mask = (((1 as u32) << prefix_bits) - 1) as u8;
    var val = (src[offset] & mask) as u64;
    var idx = offset + 1;

    if val < mask {
        return val, idx, true;
    }

    // Multibyte continuation
    var shift: u32 = 0;
    while idx < (src.len as u64) {
        let b = src[idx];
        let payload = (b & 0x7F) as u64;

        if shift >= HPACK_MAX_INT_SHIFT {
            if shift > 28 || payload > 0x0F {
                // Integer overflow beyond 31-bit limit
                return 0, idx, false;
            }
        }

        let term = payload << shift;
        if (rfc::H2_MAX_WINDOW_SIZE - val) < term {
            return 0, idx, false;
        }
        val += term;
        idx++;

        if (b & 0x80) == 0 {
            return val, idx, true;
        }
        shift += 7;
    }

    // Truncated integer sequence
    return 0, offset, false;
}

// Encodes an integer with an N-bit prefix into out.
fn hpack_encode_int<B>(out: B&, val: u64, prefix_bits: u8, prefix_mask: u8) -> bool {
    guard prefix_bits >= 1 && prefix_bits <= 8 else { return false; }
    let max_prefix = (((1 as u64) << prefix_bits) - 1);

    if val < max_prefix {
        return out.try_push(prefix_mask | (val as u8));
    }

    var rem = val - max_prefix;
    guard out.try_push(prefix_mask | (max_prefix as u8)) else { return false; }

    while rem >= 128 {
        guard out.try_push((0x80 | (rem & 0x7F)) as u8) else { return false; }
        rem = rem >> 7;
    }
    return out.try_push((rem & 0x7F) as u8);
}

// ---- static table (rfc 7541 appendix a) ---------------------------------

struct HpackStaticField {
    name: const u8[:] = "",
    val:  const u8[:] = "",
}

const HPACK_STATIC_TABLE: HpackStaticField[62] = [
    HpackStaticField { name: "", val: "" },
    HpackStaticField { name: ":authority", val: "" },
    HpackStaticField { name: ":method", val: "GET" },
    HpackStaticField { name: ":method", val: "POST" },
    HpackStaticField { name: ":path", val: "/" },
    HpackStaticField { name: ":path", val: "/index.html" },
    HpackStaticField { name: ":scheme", val: "http" },
    HpackStaticField { name: ":scheme", val: "https" },
    HpackStaticField { name: ":status", val: "200" },
    HpackStaticField { name: ":status", val: "204" },
    HpackStaticField { name: ":status", val: "206" },
    HpackStaticField { name: ":status", val: "304" },
    HpackStaticField { name: ":status", val: "400" },
