    HpackStaticField { name: "authorization", val: "" },
    HpackStaticField { name: "cache-control", val: "" },
    HpackStaticField { name: "content-disposition", val: "" },
    HpackStaticField { name: "content-encoding", val: "" },
    HpackStaticField { name: "content-language", val: "" },
    HpackStaticField { name: "content-length", val: "" },
    HpackStaticField { name: "content-location", val: "" },
    HpackStaticField { name: "content-range", val: "" },
    HpackStaticField { name: "content-type", val: "" },
    HpackStaticField { name: "cookie", val: "" },
    HpackStaticField { name: "date", val: "" },
    HpackStaticField { name: "etag", val: "" },
    HpackStaticField { name: "expect", val: "" },
    HpackStaticField { name: "expires", val: "" },
    HpackStaticField { name: "from", val: "" },
    HpackStaticField { name: "host", val: "" },
    HpackStaticField { name: "if-match", val: "" },
    HpackStaticField { name: "if-modified-since", val: "" },
    HpackStaticField { name: "if-none-match", val: "" },
    HpackStaticField { name: "if-range", val: "" },
    HpackStaticField { name: "if-unmodified-since", val: "" },
    HpackStaticField { name: "last-modified", val: "" },
    HpackStaticField { name: "link", val: "" },
    HpackStaticField { name: "location", val: "" },
    HpackStaticField { name: "max-forwards", val: "" },
    HpackStaticField { name: "proxy-authenticate", val: "" },
    HpackStaticField { name: "proxy-authorization", val: "" },
    HpackStaticField { name: "range", val: "" },
    HpackStaticField { name: "referer", val: "" },
    HpackStaticField { name: "refresh", val: "" },
    HpackStaticField { name: "retry-after", val: "" },
    HpackStaticField { name: "server", val: "" },
    HpackStaticField { name: "set-cookie", val: "" },
    HpackStaticField { name: "strict-transport-security", val: "" },
    HpackStaticField { name: "transfer-encoding", val: "" },
    HpackStaticField { name: "user-agent", val: "" },
    HpackStaticField { name: "vary", val: "" },
    HpackStaticField { name: "via", val: "" },
    HpackStaticField { name: "www-authenticate", val: "" },
];

fn get_hpack_static_field(idx: u64) -> HpackStaticField, bool {
    guard idx >= 1 && idx <= rfc::HPACK_STATIC_TABLE_ENTRIES else {
        return HpackStaticField { .. }, false;
    }
    return HPACK_STATIC_TABLE[idx as i64], true;
}

// Searches static table for matching name and optional value.
// Returns (1-based index, exact_value_match).
// Dispatches in O(1) via first character prefix without scanning all 61 entries.
fn find_hpack_static_field(name: const u8[:], val: const u8[:]) -> u64, bool {
    guard name.len > 0 else { return 0, false; }
    let c = name[0];

    if c == ':' {
        if name == ":status" {
            if val == "200" { return 8, true; }
            if val == "204" { return 9, true; }
            if val == "206" { return 10, true; }
            if val == "304" { return 11, true; }
            if val == "400" { return 12, true; }
            if val == "404" { return 13, true; }
            if val == "500" { return 14, true; }
            return 8, false;
        }
        if name == ":method" {
            if val == "GET" { return 2, true; }
            if val == "POST" { return 3, true; }
            return 2, false;
        }
        if name == ":path" {
            if val == "/" { return 4, true; }
            if val == "/index.html" { return 5, true; }
            return 4, false;
        }
        if name == ":scheme" {
            if val == "http" { return 6, true; }
            if val == "https" { return 7, true; }
            return 6, false;
        }
        if name == ":authority" {
            return 1, val.len == 0;
        }
        return 0, false;
    } else if c == 'a' {
        if name == "accept" { return 19, val.len == 0; }
        if name == "accept-encoding" {
            if val == "gzip, deflate" { return 16, true; }
            return 16, false;
        }
        if name == "authorization" { return 23, val.len == 0; }
        if name == "access-control-allow-origin" { return 20, val.len == 0; }
        if name == "accept-language" { return 17, val.len == 0; }
        if name == "accept-ranges" { return 18, val.len == 0; }
        if name == "accept-charset" { return 15, val.len == 0; }
        if name == "age" { return 21, val.len == 0; }
        if name == "allow" { return 22, val.len == 0; }
        return 0, false;
    } else if c == 'c' {
        if name == "content-type" { return 31, val.len == 0; }
        if name == "content-length" { return 28, val.len == 0; }
        if name == "cookie" { return 32, val.len == 0; }
        if name == "cache-control" { return 24, val.len == 0; }
        if name == "content-encoding" { return 26, val.len == 0; }
        if name == "content-disposition" { return 25, val.len == 0; }
        if name == "content-language" { return 27, val.len == 0; }
        if name == "content-location" { return 29, val.len == 0; }
        if name == "content-range" { return 30, val.len == 0; }
        return 0, false;
    } else if c == 'd' {
        if name == "date" { return 33, val.len == 0; }
        return 0, false;
    } else if c == 'e' {
        if name == "etag" { return 34, val.len == 0; }
        if name == "expires" { return 36, val.len == 0; }
        if name == "expect" { return 35, val.len == 0; }
        return 0, false;
    } else if c == 'f' {
        if name == "from" { return 37, val.len == 0; }
        return 0, false;
    } else if c == 'h' {
        if name == "host" { return 38, val.len == 0; }
        return 0, false;
    } else if c == 'i' {
        if name == "if-modified-since" { return 40, val.len == 0; }
        if name == "if-none-match" { return 41, val.len == 0; }
        if name == "if-match" { return 39, val.len == 0; }
        if name == "if-range" { return 42, val.len == 0; }
        if name == "if-unmodified-since" { return 43, val.len == 0; }
        return 0, false;
    } else if c == 'l' {
        if name == "last-modified" { return 44, val.len == 0; }
        if name == "location" { return 46, val.len == 0; }
        if name == "link" { return 45, val.len == 0; }
        return 0, false;
    } else if c == 'm' {
        if name == "max-forwards" { return 47, val.len == 0; }
        return 0, false;
    } else if c == 'p' {
        if name == "proxy-authorization" { return 49, val.len == 0; }
        if name == "proxy-authenticate" { return 48, val.len == 0; }
        return 0, false;
    } else if c == 'r' {
        if name == "referer" { return 51, val.len == 0; }
        if name == "range" { return 50, val.len == 0; }
        if name == "retry-after" { return 53, val.len == 0; }
        if name == "refresh" { return 52, val.len == 0; }
        return 0, false;
    } else if c == 's' {
        if name == "server" { return 54, val.len == 0; }
        if name == "set-cookie" { return 55, val.len == 0; }
        if name == "strict-transport-security" { return 56, val.len == 0; }
        return 0, false;
    } else if c == 't' {
        if name == "transfer-encoding" { return 57, val.len == 0; }
        return 0, false;
    } else if c == 'u' {
        if name == "user-agent" { return 58, val.len == 0; }
        return 0, false;
    } else if c == 'v' {
        if name == "vary" { return 59, val.len == 0; }
        if name == "via" { return 60, val.len == 0; }
        return 0, false;
    } else if c == 'w' {
        if name == "www-authenticate" { return 61, val.len == 0; }
        return 0, false;
    }

    return 0, false;
}

// ---- zero-allocation dynamic table (rfc 7541 section 4) ------------------

struct HpackHeaderField {
    name_off:    u32  = 0,
    name_len:    u16  = 0,
    val_off:     u32  = 0,
    val_len:     u16  = 0,
    meta_size:   u32  = 0, // name_len + val_len + 32
    generation:  u8   = 0,
    never_index: bool = false,
}

// RFC 7541 Section 2.3.2: Dynamic Table - O(1) direct-mapped encoder hash table with generation tracking.
struct HpackHashTable {
    slots:       u16[256] = [0; 256],
    generations: u8[256]  = [0; 256],
}

struct DynamicTable {
    entries:          HpackHeaderField[128] = [HpackHeaderField { .. }; 128],
    arena:            u8[4096]              = [0; 4096],
    hash_table:       HpackHashTable        = HpackHashTable { .. },
    head:             u64                   = 0, // Oldest entry index in ring
    count:            u64                   = 0, // Current number of active entries
    arena_write_pos:  u32                   = 0, // Sequential write cursor in arena
    arena_head:       u32                   = 0, // Linearized boundary write start offset
    arena_tail:       u32                   = 0, // Linearized boundary oldest live byte offset
    next_generation:  u8                    = 1, // Monotonic non-zero generation counter
    used_bytes:       u64                   = 0, // Total protocol size (sum of meta_size)
    max_allowed_size: u64                   = 4096, // From SETTINGS_HEADER_TABLE_SIZE
    current_max_size: u64                   = 4096, // Set by HPACK size updates
}

fn new_dynamic_table(max_allowed: u64 = 4096) -> DynamicTable {
    return DynamicTable {
        max_allowed_size: max_allowed,
        current_max_size: max_allowed,
        ..
    };
}

// Computes an 8-bit direct-mapped slot index (0..255) for an HPACK (name, val) pair.
inline fn compute_hpack_hash_slot(name: const u8[:], val: const u8[:]) -> u8 {
    var h: u32 = core::FNV1A_32_OFFSET;
    for b in name {
        h = (h ^ b) * core::FNV1A_32_PRIME;
    }
    h = (h ^ 0xFF) * core::FNV1A_32_PRIME;
    for b in val {
        h = (h ^ b) * core::FNV1A_32_PRIME;
    }
    return ((h ^ (h >> 8) ^ (h >> 16)) & 0xFF) as u8;
}

// Advances the monotonic generation counter, skipping 0 (reserved for empty/invalidated slots).
inline fn next_hpack_generation(dt: DynamicTable&) -> u8 {
    let g = dt.next_generation;
    let next_g: u8 = if g == 255 { 1 } else { g + 1 };
    dt.next_generation = next_g;
    return if g == 0 { 1 } else { g };
}

// Invalidates any hash table slot pointing to an evicted ring index & generation.
inline fn invalidate_hpack_hash_entry(dt: DynamicTable&, ring_idx: u64, entry: const HpackHeaderField&) {
    let n_off = entry.name_off;
    let n_len = entry.name_len as u32;
    let v_off = entry.val_off;
    let v_len = entry.val_len as u32;
    let slot = compute_hpack_hash_slot(dt.arena[n_off..n_off + n_len], dt.arena[v_off..v_off + v_len]);
    let encoded_ref = (ring_idx as u16) + 1;
    if dt.hash_table.slots[slot] == encoded_ref && dt.hash_table.generations[slot] == entry.generation {
        dt.hash_table.slots[slot] = 0;
        dt.hash_table.generations[slot] = 0;
    }
}

// Evicts the oldest entry from the dynamic table and updates arena_tail & hash generations.
fn evict_oldest_entry(dt: DynamicTable&) {
    guard dt.count > 0 else { return; }
    let oldest = dt.entries[dt.head];
    invalidate_hpack_hash_entry(dt, dt.head, oldest);
    dt.used_bytes -= oldest.meta_size;
    dt.head = (dt.head + 1) & HPACK_RING_MASK;
    dt.count--;
    if dt.count == 0 {
        dt.arena_head = 0;
        dt.arena_tail = 0;
        dt.arena_write_pos = 0;
    } else {
        dt.arena_tail = dt.entries[dt.head].name_off;
    }
}

// Evicts oldest entries from head until used_bytes <= target_size.
fn evict_until(dt: DynamicTable&, target_size: u64) {
    while dt.count > 0 && dt.used_bytes > target_size {
        evict_oldest_entry(dt);
    }
}

fn has_entry_overlapping_arena_range(dt: const DynamicTable&, write_start: u32, write_end: u32) -> bool {
    var i: u64 = 0;
    while i < dt.count {
        let idx = (dt.head + i) & HPACK_RING_MASK;
        let entry = dt.entries[idx];
        let old_start = entry.name_off;
        let old_end = entry.val_off + entry.val_len;
        if (old_start < write_end) && (old_end > write_start) {
            return true;
        }
        i += 1;
    }
    return false;
}

// RFC 7541 Section 2.3.2: Dynamic Table - Linearized boundary wrap helper.
// Evicts any older entries whose contiguous arena slice [name_off .. val_off + val_len)
// overlaps [write_start .. write_end) in the 4096-byte ring buffer.
fn evict_overlapping_arena_range(dt: DynamicTable&, write_start: u32, write_end: u32) {
    while dt.count > 0 && has_entry_overlapping_arena_range(dt, write_start, write_end) {
        evict_oldest_entry(dt);
    }
}

inline fn pack_header_into_arena(dt: DynamicTable&, name: const u8[:], val: const u8[:]) -> u32, u32 {
    let n_len = name.len;
    let v_len = val.len;
    let name_off = dt.arena_write_pos;
    for i in n_len {
        dt.arena[name_off + (i as u32)] = name[i];
    }
    let val_off = name_off + (n_len as u32);
    for i in v_len {
        dt.arena[val_off + (i as u32)] = val[i];
    }
    dt.arena_head = name_off;
    dt.arena_write_pos = val_off + (v_len as u32);
    return name_off, val_off;
}

// Inserts a (name, val) pair into the dynamic table using the linearized boundary ring buffer
// and O(1) direct-mapped hash table without heap allocations or O(N) compaction copies.
fn insert_header(dt: DynamicTable&, name: const u8[:], val: const u8[:], never_index: bool = false) {
    let entry_weight = (name.len as u64) + (val.len as u64) + rfc::HPACK_ENTRY_OVERHEAD;

    // RFC 7541 Section 4.4: if entry exceeds current max size, table is emptied
    if entry_weight > dt.current_max_size {
        evict_until(dt, 0);
        return;
    }

    evict_until(dt, dt.current_max_size - entry_weight);

    let total_raw = ((name.len as u64) + (val.len as u64)) as u32;
    guard total_raw <= (HPACK_MAX_ARENA_BYTES as u32) else {
        evict_until(dt, 0);
        return;
    }

    // Linearized boundary policy: if incoming header exceeds remaining space between
    // arena_write_pos and 4096, wrap write cursor to 0 so every stored header is contiguous (Invariant 10).
    if dt.arena_write_pos + total_raw > (HPACK_MAX_ARENA_BYTES as u32) {
        evict_overlapping_arena_range(dt, dt.arena_write_pos, HPACK_MAX_ARENA_BYTES as u32);
        dt.arena_write_pos = 0;
    }
    evict_overlapping_arena_range(dt, dt.arena_write_pos, dt.arena_write_pos + total_raw);
    while dt.count >= HPACK_MAX_RING_ENTRIES {
        evict_oldest_entry(dt);
    }

    let insert_idx = (dt.head + dt.count) & HPACK_RING_MASK;
    let name_off, val_off = pack_header_into_arena(dt, name, val);
    let gen = next_hpack_generation(dt);
    dt.entries[insert_idx] = HpackHeaderField {
        name_off:    name_off,
        name_len:    name.len as u16,
        val_off:     val_off,
        val_len:     val.len as u16,
        meta_size:   entry_weight as u32,
        generation:  gen,
        never_index: never_index,
    };
    dt.count += 1;
    dt.used_bytes += entry_weight;
    dt.arena_tail = dt.entries[dt.head].name_off;

    let slot = compute_hpack_hash_slot(name, val);
    dt.hash_table.slots[slot] = (insert_idx as u16) + 1;
    dt.hash_table.generations[slot] = gen;
}

// RFC 7541 Section 2.3.2: Dynamic Table - Direct-mapped O(1) hash lookup on HpackHashTable.
// Returns (slot_entry_ref, has_active_slot).
fn hpack_hash_lookup(tbl: const HpackHashTable&, name: const u8[:], val: const u8[:]) -> u16, bool {
    let slot = compute_hpack_hash_slot(name, val);
    let entry_ref = tbl.slots[slot];
    let gen = tbl.generations[slot];
    guard entry_ref > 0 && gen > 0 else { return 0, false; }
    return entry_ref, true;
}

// RFC 7541 Section 2.3.2: Dynamic Table - Verifies O(1) direct-mapped hash hit against the dynamic table
// using constant-time byte equality (`core::ct_eq_bytes`) and generation validation, returning the
// external HPACK index (>= 62) on exact match.
fn hpack_hash_lookup(dt: const DynamicTable&, name: const u8[:], val: const u8[:]) -> u16, bool {
    guard dt.count > 0 else { return 0, false; }
    let slot = compute_hpack_hash_slot(name, val);
    let entry_ref = dt.hash_table.slots[slot];
    let slot_gen = dt.hash_table.generations[slot];
    guard entry_ref > 0 && slot_gen > 0 else { return 0, false; }

    let ring_idx = (entry_ref - 1) as u64;
    guard ring_idx < HPACK_MAX_RING_ENTRIES else { return 0, false; }
    let dist = (ring_idx + HPACK_MAX_RING_ENTRIES - dt.head) & HPACK_RING_MASK;
    guard dist < dt.count else { return 0, false; }

    let entry = dt.entries[ring_idx];
    guard entry.generation == slot_gen && !entry.never_index else { return 0, false; }

    let n_end = entry.name_off + entry.name_len;
    let v_end = entry.val_off + entry.val_len;
    let entry_name = dt.arena[entry.name_off..n_end];
    let entry_val = dt.arena[entry.val_off..v_end];

    guard core::ct_eq_bytes(entry_name, name) && core::ct_eq_bytes(entry_val, val) else {
        return 0, false;
    }

    let offset_from_newest = (dt.count - 1) - dist;
    return (62 + offset_from_newest) as u16, true;
}

// Looks up an external dynamic index (idx >= 62).
// Resolves LIFO index: pos = (head + count - 1 - (idx - 62)) & HPACK_RING_MASK.
// Eliminates Go #69316 / #72940 "id <= evictCount" panic.
fn lookup_dynamic_index(dt: const DynamicTable&, external_idx: u64) -> HpackHeaderField, bool {
    guard external_idx >= 62 else { return HpackHeaderField { .. }, false; }
    let offset = external_idx - 62;
    guard offset < dt.count else { return HpackHeaderField { .. }, false; }

    let pos = (dt.head + dt.count - 1 - offset) & HPACK_RING_MASK;
    return dt.entries[pos], true;
}

// Fetches indexed header name and value slices directly without buffer copying.
fn get_indexed_header_slices(dt: const DynamicTable&, idx: u64) -> const u8[:], const u8[:], bool {
    guard idx >= 1 else { return "", "", false; } // Index 0 is invalid (RFC 7541 Section 6.1)

    if idx <= rfc::HPACK_STATIC_TABLE_ENTRIES {
        let s, ok = get_hpack_static_field(idx);
        guard ok else { return "", "", false; }
        return s.name, s.val, true;
    }

    let entry, ok = lookup_dynamic_index(dt, idx);
    guard ok else { return "", "", false; }

    let n_off = entry.name_off;
    let n_len = entry.name_len as u32;
    let v_off = entry.val_off;
    let v_len = entry.val_len as u32;

    return dt.arena[n_off..n_off + n_len], dt.arena[v_off..v_off + v_len], true;
}

// Fetches an indexed header from Static Table (1..61) or Dynamic Table (>= 62).
// Buffers are cleared only if the entry is successfully resolved.
fn get_indexed_header<B1, B2>(dt: const DynamicTable&, idx: u64, out_name: B1&, out_val: B2&) -> bool {
    let name_slice, val_slice, ok = get_indexed_header_slices(dt, idx);
    guard ok else { return false; }
    guard name_slice.len <= out_name.cap && val_slice.len <= out_val.cap else { return false; }
    out_name.clear();
    out_val.clear();
    out_name.append(name_slice);
    out_val.append(val_slice);
    return true;
}

// Fetches indexed header name slice directly without buffer copying.
fn get_indexed_header_name_slice(dt: const DynamicTable&, idx: u64) -> const u8[:], bool {
    guard idx >= 1 else { return "", false; }

    if idx <= rfc::HPACK_STATIC_TABLE_ENTRIES {
        let s, ok = get_hpack_static_field(idx);
        guard ok else { return "", false; }
        return s.name, true;
    }

    let entry, ok = lookup_dynamic_index(dt, idx);
    guard ok else { return "", false; }

    let n_off = entry.name_off;
    let n_len = entry.name_len as u32;
    return dt.arena[n_off..n_off + n_len], true;
}

fn get_indexed_header_name<B>(dt: const DynamicTable&, idx: u64, out_name: B&) -> bool {
    let name_slice, ok = get_indexed_header_name_slice(dt, idx);
    guard ok else { return false; }
    guard name_slice.len <= out_name.cap else { return false; }
    out_name.clear();
    out_name.append(name_slice);
    return true;
}

// Updates dynamic table maximum size per HPACK instruction (001xxxxx).
fn update_dynamic_table_max_size(dt: DynamicTable&, new_max: u64) -> bool {
    guard new_max <= dt.max_allowed_size else { return false; }
    dt.current_max_size = new_max;
    evict_until(dt, new_max);
    return true;
}

// ---- full hpack block decoder & rfc 9113 header validator ----------------

struct H2PseudoHeaders {
    method:             u8[..16]   = [],
    scheme:             u8[..16]   = [],
    authority:          u8[..256]  = [],
    path:               u8[..2048] = [],
    protocol:           u8[..64]   = [],
    status:             i32        = 0,
    has_method:         bool       = false,
    has_scheme:         bool       = false,
    has_authority:      bool       = false,
    has_path:           bool       = false,
    has_protocol:       bool       = false,
    has_status:         bool       = false,
    has_regular_header: bool       = false,
    has_content_length: bool       = false,
    content_length_val: i64        = -1,
    is_trailer:         bool       = false,
    wireframe_size:     u32        = 0,
}

fn clear_h2_pseudo_headers(p: H2PseudoHeaders&, keep_trailer_flag: bool = true) {
    let tr = if keep_trailer_flag { p.is_trailer } else { false };
    p.method.clear();
    p.scheme.clear();
    p.authority.clear();
    p.path.clear();
    p.protocol.clear();
    p.status = 0;
    p.has_method = false;
    p.has_scheme = false;
    p.has_authority = false;
    p.has_path = false;
    p.has_protocol = false;
    p.has_status = false;
    p.has_regular_header = false;
    p.has_content_length = false;
    p.content_length_val = -1;
    p.is_trailer = tr;
    p.wireframe_size = 0;
}

// Validates RFC 9113 Section 8.2.1 header field syntax:
// 1. Name must be lowercase ASCII token without whitespace or uppercase.
// 2. Value must not contain NUL, CR, or LF, nor leading/trailing SP/HTAB.
fn validate_h2_field_syntax(name: const u8[:], val: const u8[:]) -> bool {
    guard name.len > 0 else { return false; }

    // Validate name
    var is_pseudo = (name[0] == ':');
    var i: i64 = if is_pseudo { 1 } else { 0 };
    guard i < name.len else { return false; }

    while i < name.len {
        let c = name[i];
        // Rejects uppercase 'A'..'Z' and non-tchar characters (RFC 9113 §8.2.1 & RFC 9110 §5.6.2)
        if (c >= 'A' && c <= 'Z') || !wing::is_tchar(c) {
            return false;
        }
        i++;
    }

    // Validate value
    if val.len > 0 {
        // No leading/trailing SP or HTAB
        if val[0] == ' ' || val[0] == '\t' || val[val.len - 1] == ' ' || val[val.len - 1] == '\t' {
            return false;
        }
        for b in val {
            if (b < 0x20 && b != '\t') || b == 0x7F {
                return false; // Forbidden CTL characters and DEL (RFC 9113 Section 8.2.1)
            }
        }
    }
    return true;
}

// Decodes string literal from HPACK stream (with Huffman or raw octets).
//
// Example:
//   src = [0x05, 'c', 'u', 's', 't', 'm'], offset = 0, out: appends "custm"
//   returns: consumed_offset = 6, ok = true
fn decode_hpack_string<B>(src: const u8[:], offset: u64, out: B&) -> u64, bool {
    guard offset < (src.len as u64) else { return offset, false; }
    let is_huff = (src[offset] & 0x80) != 0;
    let str_len, next_off, ok_len = hpack_decode_int(src, offset, 7);
    guard ok_len else { return offset, false; }

    guard (next_off + str_len) <= (src.len as u64) else {
        return offset, false;
    }

    let raw_slice = src[next_off..next_off + str_len];
    if is_huff {
        let ok_huff = huff_decode_bytes(raw_slice, out);
        guard ok_huff else { return offset, false; }
    } else {
        guard out.len + raw_slice.len <= out.cap else { return offset, false; }
        out.append(raw_slice);
    }

    return next_off + str_len, true;
}

inline fn is_forbidden_authority_byte(b: u8) -> bool {
    return b <= 0x20 || b == 0x7F || b == '/' || b == '?' || b == '#' || b == '@' || b == ',';
}

inline fn is_forbidden_path_byte(b: u8) -> bool {
    return b <= 0x20 || b == 0x7F || b == '<' || b == '>' || b == '"'
        || b == '\\' || b == '^' || b == '{' || b == '|' || b == '}';
}

fn is_valid_h2_scheme(val: const u8[:]) -> bool {
    guard val.len > 0 else { return false; }
    let b0 = val[0];
    guard (b0 >= 'a' && b0 <= 'z') || (b0 >= 'A' && b0 <= 'Z') else { return false; }
    for b in val[1..] {
        let ok = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z')
            || (b >= '0' && b <= '9') || b == '+' || b == '-' || b == '.';
        guard ok else { return false; }
    }
    return true;
}

fn is_valid_h2_authority(val: const u8[:]) -> bool {
    guard val.len > 0 else { return false; }
    for b in val {
        guard !is_forbidden_authority_byte(b) else { return false; }
    }
    return true;
}

fn is_valid_h2_path(val: const u8[:]) -> bool {
    guard val.len > 0 else { return false; }
    if val == "*" { return true; }
    guard val[0] == '/' else { return false; }
    for b in val {
        guard !is_forbidden_path_byte(b) else { return false; }
    }
    return true;
}

fn validate_h2_pseudo_status_code(pseudo: const H2PseudoHeaders&, val: const u8[:], out_code: i32&) -> u32 {
    let sc, ok_sc = core::parse_i32_dec(val);
    guard val.len == 3 && ok_sc && sc >= 100 && sc <= 599 && sc != 101 else {
        return rfc::H2_ERR_PROTOCOL_ERROR;
    }
    guard !pseudo.has_method && !pseudo.has_scheme && !pseudo.has_path
          && !pseudo.has_protocol && !pseudo.has_authority else {
        return rfc::H2_ERR_PROTOCOL_ERROR;
    }
    out_code = sc;
    return rfc::H2_ERR_NO_ERROR;
}

fn validate_pseudo_authority(val: const u8[:]) -> u32 {
    guard val.len > 0 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    for b in val {
        guard !is_forbidden_authority_byte(b) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    }
    return rfc::H2_ERR_NO_ERROR;
}

fn validate_pseudo_path(val: const u8[:], pseudo: const H2PseudoHeaders&) -> u32 {
    guard val.len > 0 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    if val.len == 1 && val[0] == '*' {
        guard !pseudo.has_method || pseudo.method[..] == "OPTIONS" else {
            return rfc::H2_ERR_PROTOCOL_ERROR;
        }
        return rfc::H2_ERR_NO_ERROR;
    }
    guard val[0] == '/' else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    for b in val {
        guard !is_forbidden_path_byte(b) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    }
    return rfc::H2_ERR_NO_ERROR;
}

fn validate_and_record_pseudo_header(
    pseudo:               H2PseudoHeaders&,
    name:                 const u8[:],
    val:                  const u8[:],
    validate_http2_rules: bool,
) -> u32 {
    if validate_http2_rules {
        guard !pseudo.is_trailer && !pseudo.has_regular_header else {
            return rfc::H2_ERR_PROTOCOL_ERROR;
        }
    }

    if name == ":status" {
        if validate_http2_rules {
            guard !pseudo.has_status else { return rfc::H2_ERR_PROTOCOL_ERROR; }
            var code: i32 = 0;
            let err = validate_h2_pseudo_status_code(pseudo, val, code);
            guard err == rfc::H2_ERR_NO_ERROR else { return err; }
            pseudo.status = code;
        } else {
            let parsed, ok_p = core::parse_u32_dec(val);
            if ok_p { pseudo.status = parsed as i32; }
        }
        pseudo.has_status = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    if name == ":method" {
        if validate_http2_rules {
            guard !pseudo.has_method && !pseudo.has_status && val.len > 0 else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
            if val != "OPTIONS" && pseudo.has_path && pseudo.path[..] == "*" {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
        }
        guard pseudo.method.try_set(val) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        pseudo.has_method = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    if name == ":scheme" {
        if validate_http2_rules {
            guard !pseudo.has_scheme && !pseudo.has_status && val.len > 0 else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
        }
        guard pseudo.scheme.try_set(val) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        pseudo.has_scheme = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    if name == ":authority" {
        if validate_http2_rules {
            guard !pseudo.has_authority && !pseudo.has_status else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
            let err = validate_pseudo_authority(val);
            guard err == rfc::H2_ERR_NO_ERROR else { return err; }
        }
        guard pseudo.authority.try_set(val) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        pseudo.has_authority = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    if name == ":path" {
        if validate_http2_rules {
            guard !pseudo.has_path && !pseudo.has_status else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
            let err = validate_pseudo_path(val, pseudo);
            guard err == rfc::H2_ERR_NO_ERROR else { return err; }
        }
        guard pseudo.path.try_set(val) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        pseudo.has_path = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    if name == ":protocol" {
        if validate_http2_rules {
            guard !pseudo.has_protocol && !pseudo.has_status && val.len > 0 else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
        }
        guard pseudo.protocol.try_set(val) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        pseudo.has_protocol = true;
        return rfc::H2_ERR_NO_ERROR;
    }

    return if validate_http2_rules { rfc::H2_ERR_PROTOCOL_ERROR } else { rfc::H2_ERR_NO_ERROR };
}

fn validate_content_length_pseudo(pseudo: H2PseudoHeaders&, val: const u8[:]) -> u32 {
    guard val.len > 0 && val.len <= 19 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    var parsed_len: i64 = 0;
    for c in val {
        guard c >= '0' && c <= '9' else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        let digit = (c - '0') as i64;
        guard parsed_len <= (9223372036854775807 - digit) / 10 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        parsed_len = parsed_len * 10 + digit;
    }
    if pseudo.has_content_length {
        guard pseudo.content_length_val == parsed_len else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    } else {
        pseudo.has_content_length = true;
        pseudo.content_length_val = parsed_len;
    }
    return rfc::H2_ERR_NO_ERROR;
}

fn validate_regular_header_to_map(
    pseudo:      H2PseudoHeaders&,
    out_headers: const wing::HeaderMap&,
    name:        const u8[:],
    val:         const u8[:],
) -> u32 {
    pseudo.has_regular_header = true;

    if pseudo.is_trailer {
        let is_forbidden_trailer = name == "content-length" || name == "transfer-encoding"
            || name == "host" || name == "connection" || name == "keep-alive"
            || name == "upgrade" || name == "trailer" || rfc::is_disallowed_trailer_field(name);
        guard !is_forbidden_trailer else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        guard name != "te" || val == "trailers" else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    }

    if name == "host" {
        guard val.len > 0 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        for b in val {
            guard !is_forbidden_authority_byte(b) else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        }
        guard !wing::has_header(out_headers, "host") else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        if pseudo.has_authority {
            guard core::eq_ascii_fold(pseudo.authority[..], val) else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
        }
    }

    if name == "content-length" {
        let v_cl = validate_content_length_pseudo(pseudo, val);
        guard v_cl == rfc::H2_ERR_NO_ERROR else { return v_cl; }
    }

    let is_forbidden_conn = name == "connection" || name == "keep-alive"
        || name == "proxy-connection" || name == "transfer-encoding"
        || name == "upgrade";
    guard !is_forbidden_conn else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    guard name != "te" || val == "trailers" else { return rfc::H2_ERR_PROTOCOL_ERROR; }

    return rfc::H2_ERR_NO_ERROR;
}

// Validates and records a single decoded HPACK field into `out_pseudo` and `out_headers`.
fn validate_header_ordering_and_rules(
    out_pseudo:           H2PseudoHeaders&,
    out_headers:          wing::HeaderMap&,
    name:                 const u8[:],
    val:                  const u8[:],
    validate_http2_rules: bool = true,
) -> u32 {
    if validate_http2_rules {
        guard validate_h2_field_syntax(name, val) else {
            return rfc::H2_ERR_PROTOCOL_ERROR;
        }
    } else {
        guard name.len > 0 else { return rfc::H2_ERR_PROTOCOL_ERROR; }
    }

    if name[0] == ':' {
        return validate_and_record_pseudo_header(out_pseudo, name, val, validate_http2_rules);
    }

    if validate_http2_rules {
        let v_reg = validate_regular_header_to_map(out_pseudo, out_headers, name, val);
        guard v_reg == rfc::H2_ERR_NO_ERROR else { return v_reg; }
    } else {
        out_pseudo.has_regular_header = true;
    }

    guard wing::append_header(out_headers, name, val) else {
        return rfc::H2_ERR_ENHANCE_YOUR_CALM;
    }
    return rfc::H2_ERR_NO_ERROR;
}

fn append_decoded_header_to_map(
    out_pseudo:           H2PseudoHeaders&,
    out_headers:          wing::HeaderMap&,
    name:                 const u8[:],
    val:                  const u8[:],
    max_header_list_size: u32,
    validate_http2_rules: bool,
) -> u32 {
    let field_size = (name.len + val.len + 32) as u32;
    out_pseudo.wireframe_size += field_size;
    guard out_pseudo.wireframe_size <= max_header_list_size else {
        return rfc::H2_ERR_ENHANCE_YOUR_CALM;
    }
    return validate_header_ordering_and_rules(out_pseudo, out_headers, name, val, validate_http2_rules);
}

// Decodes an HPACK literal header field with given prefix bits into bounded name/value buffers.
//
// Example:
//   src = [0x00, 0x04, 'n', 'a', 'm', 'e', 0x03, 'v', 'a', 'l'], offset = 0, prefix_bits = 4
//   returns: val_next_off = 10, error_code = ERR_NO_ERROR
fn decode_literal_field_slices(
    dt:          const DynamicTable&,
    src:         const u8[:],
    offset:      u64,
    prefix_bits: u8,
    name_buf:    u8[..256]&,
    val_buf:     u8[..8192]&,
) -> u64, u32 {
    let name_idx, init_off, ok_idx = hpack_decode_int(src, offset, prefix_bits);
    guard ok_idx else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }
    var mut_off = init_off;

    if name_idx == 0 {
        let next_name_off, ok_name = decode_hpack_string(src, mut_off, name_buf);
        guard ok_name else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }
        mut_off = next_name_off;
    } else {
        let ok_n = get_indexed_header_name(dt, name_idx, name_buf);
        guard ok_n else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }
    }

    let val_next_off, ok_val = decode_hpack_string(src, mut_off, val_buf);
    guard ok_val else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }
    return val_next_off, rfc::H2_ERR_NO_ERROR;
}

// Decodes a single HPACK field representation step directly into `out_pseudo` and `out_headers`.
//
// Example:
//   src = [0x82], offset = 0, dt = DynamicTable { .. }
//   returns: next_offset = 1, error_code = ERR_NO_ERROR, out_pseudo.method = "GET"
fn decode_hpack_field_step_to_map(
    dt:                   DynamicTable&,
    src:                  const u8[:],
    offset:               u64,
    updates_allowed:      bool&,
    update_count:         u32&,
    out_pseudo:           H2PseudoHeaders&,
    out_headers:          wing::HeaderMap&,
    max_header_list_size: u32,
    validate_http2_rules: bool,
) -> u64, u32 {
    let b = src[offset];

    // 1. Indexed Header Field Representation: 1xxxxxxx (7-bit prefix)
    if (b & 0x80) != 0 {
        updates_allowed = false;
        let idx, next_off, ok_int = hpack_decode_int(src, offset, 7);
        guard ok_int && idx != 0 else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }

        let name_slice, val_slice, ok_get = get_indexed_header_slices(dt, idx);
        guard ok_get else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }

        let err = append_decoded_header_to_map(
            out_pseudo,
            out_headers,
            name_slice,
            val_slice,
            max_header_list_size,
            validate_http2_rules,
        );
        return next_off, err;
    }

    // 2. Literal Header Field with Incremental Indexing: 01xxxxxx (6-bit prefix)
    if (b & 0xC0) == 0x40 {
        updates_allowed = false;
        var name_buf: u8[..256]  = [];
        var val_buf:  u8[..8192] = [];
        let val_next_off, err_dec = decode_literal_field_slices(dt, src, offset, 6, name_buf, val_buf);
        guard err_dec == rfc::H2_ERR_NO_ERROR else { return offset, err_dec; }

        insert_header(dt, name_buf[..], val_buf[..], false);
        let err = append_decoded_header_to_map(
            out_pseudo,
            out_headers,
            name_buf[..],
            val_buf[..],
            max_header_list_size,
            validate_http2_rules,
        );
        return val_next_off, err;
    }

    // 3. Dynamic Table Size Update: 001xxxxx (5-bit prefix)
    if (b & 0xE0) == 0x20 {
        guard updates_allowed else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }
        update_count++;
        guard update_count <= 16 else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }

        let new_size, next_off, ok_size = hpack_decode_int(src, offset, 5);
        guard ok_size else { return offset, rfc::H2_ERR_COMPRESSION_ERROR; }

        guard update_dynamic_table_max_size(dt, new_size) else {
            return offset, rfc::H2_ERR_COMPRESSION_ERROR;
        }
        return next_off, rfc::H2_ERR_NO_ERROR;
    }

    // 4. Literal Header without Indexing (0000xxxx) or Never Indexed (0001xxxx)
    updates_allowed = false;
    var name_buf: u8[..256]  = [];
    var val_buf:  u8[..8192] = [];
    let val_next_off, err_dec = decode_literal_field_slices(dt, src, offset, 4, name_buf, val_buf);
    guard err_dec == rfc::H2_ERR_NO_ERROR else { return offset, err_dec; }

    let err = append_decoded_header_to_map(
        out_pseudo,
        out_headers,
        name_buf[..],
        val_buf[..],
        max_header_list_size,
        validate_http2_rules,
    );
    return val_next_off, err;
}

// RFC 9113 Section 8.3.1 & 8.3.2: Verify mandatory pseudo-headers in non-trailer header blocks
fn validate_mandatory_pseudo_headers(pseudo: const H2PseudoHeaders&) -> u32 {
    if pseudo.has_status {
        guard !pseudo.has_method && !pseudo.has_scheme && !pseudo.has_path
              && !pseudo.has_authority && !pseudo.has_protocol else {
            return rfc::H2_ERR_PROTOCOL_ERROR;
        }
        return rfc::H2_ERR_NO_ERROR;
    }
    if pseudo.has_method {
        let is_connect = (pseudo.method[..] == "CONNECT");
        if is_connect && !pseudo.has_protocol {
            guard pseudo.has_authority else { return rfc::H2_ERR_PROTOCOL_ERROR; }
            guard !pseudo.has_scheme && !pseudo.has_path else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        } else if is_connect && pseudo.has_protocol {
            guard pseudo.has_scheme && pseudo.has_path && pseudo.has_authority else {
                return rfc::H2_ERR_PROTOCOL_ERROR;
            }
        } else {
            guard !pseudo.has_protocol else { return rfc::H2_ERR_PROTOCOL_ERROR; }
            guard pseudo.has_scheme && pseudo.has_path else { return rfc::H2_ERR_PROTOCOL_ERROR; }
        }
        return rfc::H2_ERR_NO_ERROR;
    }
    return rfc::H2_ERR_PROTOCOL_ERROR;
}

// Decodes a complete HPACK header block directly into `out_pseudo` and `out_headers` (RFC 7541, RFC 9113 §8.2).
// Enforces RFC 9113 pseudo-header ordering, duplicate content-length checks (CVE-2026-78660),
// iterative dynamic table size updates only at the start of the block, and `max_header_list_size`.
//
// Example:
//   src = [0x82, 0x86, 0x84], out_pseudo = H2PseudoHeaders { .. }, out_headers = wing::HeaderMap { .. }
//   returns: error_code = ERR_NO_ERROR, out_pseudo.method = "GET"
fn decode_hpack_to_map(
    dt:                   DynamicTable&,
    src:                  const u8[:],
    out_pseudo:           H2PseudoHeaders&,
    out_headers:          wing::HeaderMap&,
    max_header_list_size: u32  = 8192,
    validate_http2_rules: bool = true,
) -> u32 {
    var offset: u64 = 0;
    let src_len = src.len as u64;
    var updates_allowed = true;
    var update_count: u32 = 0;
    var first_err:    u32 = rfc::H2_ERR_NO_ERROR;

    clear_h2_pseudo_headers(out_pseudo, true);
    out_headers.clear();

    while offset < src_len {
        let next_off, err = decode_hpack_field_step_to_map(
            dt,
            src,
            offset,
            updates_allowed,
            update_count,
            out_pseudo,
            out_headers,
            max_header_list_size,
            validate_http2_rules,
        );
        if err == rfc::H2_ERR_COMPRESSION_ERROR {
            return err;
        }
        if err != rfc::H2_ERR_NO_ERROR && first_err == rfc::H2_ERR_NO_ERROR {
            first_err = err;
        }
        offset = next_off;
    }

    guard first_err == rfc::H2_ERR_NO_ERROR else { return first_err; }

    if validate_http2_rules && !out_pseudo.is_trailer {
        let v_err = validate_mandatory_pseudo_headers(out_pseudo);
        guard v_err == rfc::H2_ERR_NO_ERROR else { return v_err; }
    }

    return rfc::H2_ERR_NO_ERROR;
}

enum HpackIndexing {
    Incremental,
    None,
    NeverIndexed,
}

fn find_hpack_dynamic_field(dt: const DynamicTable&, name: const u8[:], val: const u8[:]) -> u64, bool {
    var d_match_idx: u64 = 0;
    var i:           u64 = 0;
    while i < dt.count {
        let ext_idx = 62 + i;
        i += 1;
        let entry, ok_e = lookup_dynamic_index(dt, ext_idx);
        guard ok_e && !entry.never_index else { continue; }
        let t_name, t_val, ok_get = get_indexed_header_slices(dt, ext_idx);
        guard ok_get && core::ct_eq_bytes(t_name, name) else { continue; }
        if core::ct_eq_bytes(t_val, val) {
            return ext_idx, true;
        }
        if d_match_idx == 0 {
            d_match_idx = ext_idx;
        }
    }
    return d_match_idx, false;
}

// Encodes a single HTTP/2 header field into out with optional Huffman and dynamic indexing.
fn encode_hpack_field<B>(
    dt:          DynamicTable&,
    out:         B&,
    name:        const u8[:],
    val:         const u8[:],
    indexing:    HpackIndexing = HpackIndexing.Incremental,
    use_huffman: bool          = true,
) -> bool {
    let start_len = out.len;
    let is_never = (indexing == HpackIndexing.NeverIndexed);
    let is_inc = (indexing == HpackIndexing.Incremental);

    if !is_never {
        // 1. Check for exact match in static table
        let s_idx, exact_s = find_hpack_static_field(name, val);
        if s_idx > 0 && exact_s {
            // Indexed field (1xxxxxxx)
            guard hpack_encode_int(out, s_idx, 7, 0x80) else {
                out.resize(start_len);
                return false;
            }
            return true;
        }

        // 2. Check for O(1) direct-mapped hash hit in dynamic table
        let fast_idx, fast_ok = hpack_hash_lookup(dt, name, val);
        if fast_ok && fast_idx >= 62 {
            guard hpack_encode_int(out, fast_idx as u64, 7, 0x80) else {
                out.resize(start_len);
                return false;
            }
            return true;
        }

        // 3. Fallback scan for name-only match or collision resolution in dynamic table
        let d_match_idx, d_exact = find_hpack_dynamic_field(dt, name, val);
        if d_exact {
            guard hpack_encode_int(out, d_match_idx, 7, 0x80) else {
                out.resize(start_len);
                return false;
            }
            return true;
        }
    }

    let s_idx, _ = find_hpack_static_field(name, val);
    var d_match_idx: u64 = 0;
    if !is_never {
        let dyn_idx, _ = find_hpack_dynamic_field(dt, name, val);
        d_match_idx = dyn_idx;
    }

    // Choose prefix depending on indexing mode
    let prefix_mask: u8 = if is_inc { 0x40 } else if is_never { 0x10 } else { 0x00 };
    let prefix_bits: u8 = if is_inc { 6 } else { 4 };

    let name_ref_idx = if s_idx > 0 { s_idx } else { d_match_idx };
    if name_ref_idx > 0 {
        guard hpack_encode_int(out, name_ref_idx, prefix_bits, prefix_mask) else {
            out.resize(start_len);
            return false;
        }
    } else {
        guard hpack_encode_int(out, 0, prefix_bits, prefix_mask) &&
              encode_hpack_string_literal(out, name, use_huffman) else {
            out.resize(start_len);
            return false;
        }
    }

    guard encode_hpack_string_literal(out, val, use_huffman) else {
        out.resize(start_len);
        return false;
    }

    if is_inc {
        insert_header(dt, name, val, false);
    }
    return true;
}

fn encode_hpack_string_literal<B>(out: B&, raw: const u8[:], use_huffman: bool) -> bool {
    if use_huffman {
        let huff_len = huff_encoded_byte_len(raw);
        if huff_len < (raw.len as u64) {
            return hpack_encode_int(out, huff_len, 7, 0x80) && huff_encode_bytes(raw, out);
        }
    }
    // Raw octets
    return hpack_encode_int(out, raw.len as u64, 7, 0x00) && out.try_append(raw);
}
