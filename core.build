// goose-wing core package build configuration sidecar.
// Compiles only the 6 C11 shims used by core/ modules.
c_sources_windows = ["shim/simd.c", "shim/tcp.c", "shim/crypto_fusion.c", "shim/page_mem.c", "shim/page_ring.c", "shim/spsc.c"];
c_sources_linux = ["shim/simd.c", "shim/tcp.c", "shim/crypto_fusion.c", "shim/page_mem.c", "shim/page_ring.c", "shim/spsc.c"];
c_sources_macos = ["shim/simd.c", "shim/tcp.c", "shim/crypto_fusion.c", "shim/page_mem.c", "shim/page_ring.c", "shim/spsc.c"];
c_libs_windows = ["ws2_32", "mswsock"];
c_libs_linux = ["pthread"];
c_flags_cc_windows = ["-mstackrealign"];
c_flags_msvc = ["/std:c11"];
exclude = ["auth", "bench", "cli", "client", "cookie", "dns", "docs", "examples", "fingerprint", "grpc", "h1", "http", "http2", "http3", "net", "proxy", "quic", "realtime", "rfc", "scratch", "scripts", "security", "server", "tests", "tls", "tools", "vendor", "wire"];
