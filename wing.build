// goose-wing package build configuration sidecar.
// Configures platform-specific system libraries, compiler flags, and exclusions.
c_sources_windows = ["shim/rio.c", "shim/uring.c", "shim/kqueue.c", "shim/tcp.c", "shim/simd.c", "shim/af_xdp.c", "shim/smartnic.c"];
c_sources_linux = ["shim/rio.c", "shim/uring.c", "shim/kqueue.c", "shim/tcp.c", "shim/simd.c", "shim/af_xdp.c", "shim/smartnic.c"];
c_sources_macos = ["shim/rio.c", "shim/uring.c", "shim/kqueue.c", "shim/tcp.c", "shim/simd.c", "shim/af_xdp.c", "shim/smartnic.c"];
c_libs_windows = ["ws2_32", "mswsock"];
c_flags_msvc = ["/std:c11"];
exclude = ["scratch", "vendor", "tools"];
