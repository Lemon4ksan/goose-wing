# scripts/repl/verify_ws_streaming_utf8.repl
# WebSocket Close Frame Codes & Streaming UTF-8 Invariants (RFC 6455 §5.5.1 / §7.4 / §8.1)
# tested flush at the 64 KB Wasm page boundary.

# 1. Valid 2-byte Close Frame Payload: 1000 Normal Closure (0x03E8)
:pkt_edge 03E8

:assert EDGE_ADDR == 65534
:assert EDGE_LEN == 2

# Memory safety: reading 1 byte past 2-byte payload must trap
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Bounded WebSocket close frame payload parser enforcing RFC 6455 §7.4
fn validate_ws_close_wire(addr: i32, len: i32) -> i32 {
    if len == 0 { return 1005; } // No status code present (valid internal default)
    if len == 1 { return -1; }   // RFC 6455 §5.5.1: 1-byte close payload is strictly FORBIDDEN

    let code = (load_u8(addr) << 8) | load_u8(addr + 1);

    // RFC 6455 §7.4.2: Range 1000..4999
    if code < 1000 || code >= 5000 {
        return -2;
    }
    // Reserved codes that MUST NOT be sent on the wire
    if code == 1004 || code == 1005 || code == 1006 || code == 1015 {
        return -2;
    }
    // Codes 1016..2999 are reserved/unassigned
    if code >= 1016 && code < 3000 {
        return -2;
    }

    return code;
}

# Streaming split check across all prefix fragments at page edge
# Prefix 1 returns -1 (1-byte forbidden) without trap; full 2 bytes returns 1000
:split_check validate_ws_close_wire EDGE_ADDR EDGE_LEN -1 1000

# Wire mutation fuzzing: 256 random bit flips and byte boundary mutations at page edge
:mutate validate_ws_close_wire EDGE_ADDR EDGE_LEN 256

# 2. RFC 6455 Close Status Code Violation Invariant Assertions
# Code 1005 (0x03ED) sent on wire (forbidden: MUST NOT be sent on wire per §7.4.1)
:pkt 2048 03ED
:assert validate_ws_close_wire(2048, 2) == -2

# Code 1006 (0x03EE) sent on wire (forbidden: abnormal closure)
:pkt 2050 03EE
:assert validate_ws_close_wire(2050, 2) == -2

# Code 1004 (0x03EC) sent on wire (forbidden: reserved)
:pkt 2060 03EC
:assert validate_ws_close_wire(2060, 2) == -2

# Code 2000 (0x07D0) sent on wire (forbidden: 1016..2999 unassigned)
:pkt 2070 07D0
:assert validate_ws_close_wire(2070, 2) == -2

# Code 5000 (0x1388) sent on wire (forbidden: out of range >= 5000)
:pkt 2080 1388
:assert validate_ws_close_wire(2080, 2) == -2

# Code 1002 (0x03EA Protocol Error) sent on wire (valid)
:pkt 2090 03EA
:assert validate_ws_close_wire(2090, 2) == 1002

# 3. Fast UTF-8 Wire Validator (RFC 6455 §8.1)
# Detects overlong sequences and UTF-16 surrogates on byte streams.
fn validate_utf8_wire(addr: i32, len: i32) -> i32 {
    var i: i32 = 0;
    while i < len {
        let b0 = load_u8(addr + i);
        if b0 < 128 {
            i += 1;
        } else if (b0 & 224) == 192 {
            // 2-byte sequence: 110xxxxx 10xxxxxx
            if i + 1 >= len { return -1; } // incomplete
            let b1 = load_u8(addr + i + 1);
            if (b1 & 192) != 128 { return -2; } // invalid continuation
            if b0 < 194 { return -2; } // Overlong encoding: 0xC0..0xC1 forbidden
            i += 2;
        } else if (b0 & 240) == 224 {
            // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
            if i + 2 >= len { return -1; } // incomplete
            let b1 = load_u8(addr + i + 1);
            let b2 = load_u8(addr + i + 2);
            if (b1 & 192) != 128 || (b2 & 192) != 128 { return -2; }
            if b0 == 224 && b1 < 160 { return -2; } // Overlong 3-byte
            if b0 == 237 && b1 >= 160 { return -2; } // UTF-16 surrogates (0xED 0xA0..0xBF)
            i += 3;
        } else {
            return -2; // Unsupported or invalid start byte
        }
    }
    return 1; // Valid UTF-8
}

# Valid ASCII text: "hello"
:pkt 3000 "hello"
:assert validate_utf8_wire(3000, 5) == 1

# Overlong 2-byte NUL: 0xC0 0x80 (forbidden)
:pkt 3020 C080
:assert validate_utf8_wire(3020, 2) == -2

# UTF-16 surrogate half: 0xED 0xA0 0x80 (forbidden)
:pkt 3030 EDA080
:assert validate_utf8_wire(3030, 3) == -2
