# scripts/repl/verify_http1_chunked.repl
# HTTP/1.1 chunked transfer coding framing (RFC 9112 Section 7), bare LF smuggling defense
# (CVE-2025-22871), chunk extension boundary parsing, and page-edge buffer safety.

# 1. Bounded HTTP/1 Chunk Header & Body Validator
# Validates RFC 9112 Section 7:
# chunk = chunk-size [ chunk-ext ] CRLF chunk-data CRLF
# last-chunk = 1*"0" [ chunk-ext ] CRLF
# Returns chunk_size on success, -1 on incomplete/truncated, -2 on smuggling / format violation.
fn parse_http1_chunk_frame(addr: i32, len: i32) -> i32 {
    if len < 3 { return -1; }
    var size: i32 = 0;
    var i: i32 = 0;
    var seen_digits: i32 = 0;

    // Step 1: Parse chunk-size hex octets
    while i < len {
        let b = load_u8(addr + i);
        if b == 13 || b == 59 { // '\r' (CR) or ';' (extension start)
            break;
        }
        if b == 10 {
            // Bare LF without preceding CR: RFC 9112 Section 2.2 / CVE-2025-22871 defense
            return -2;
        }

        var digit: i32 = -1;
        if b >= 48 && b <= 57 { digit = b - 48; } // '0'..'9'
        else if b >= 97 && b <= 102 { digit = b - 87; } // 'a'..'f'
        else if b >= 65 && b <= 70 { digit = b - 55; } // 'A'..'F'
        else { return -2; } // Non-hex character

        if seen_digits >= 8 {
            return -2; // Hex overflow: chunk size exceeds 32-bit bound
        }
        size = (size << 4) | digit;
        seen_digits += 1;
        i += 1;
    }

    if seen_digits == 0 { return -2; }

    // Step 2: Skip chunk extensions (";name=value") up to CR
    while i < len && load_u8(addr + i) != 13 {
        if load_u8(addr + i) == 10 {
            return -2; // Bare LF inside extension
        }
        i += 1;
    }

    // Step 3: Enforce CRLF after chunk-size and extensions
    if i + 1 >= len { return -1; } // Truncated before CRLF
    if load_u8(addr + i) != 13 || load_u8(addr + i + 1) != 10 {
        return -2;
    }
    i += 2;

    let hdr_len = i;
    var total_needed = hdr_len + size;
    if size > 0 {
        total_needed += 2; // Trailing CRLF after payload
    }

    // Bounds guard: ensure complete payload bytes exist in buffer
    if len < total_needed {
        return -1; // Truncated payload
    }

    // Step 4: Validate trailing CRLF after non-empty chunk data
    if size > 0 {
        let cr = load_u8(addr + hdr_len + size);
        let lf = load_u8(addr + hdr_len + size + 1);
        if cr != 13 || lf != 10 {
            return -2; // Missing trailing CRLF after chunk data
        }
    }

    return size;
}

# 2. Standard Chunk at Page Edge
# Wire: "5\r\nHello\r\n" (hex: 35 0D 0A 48 65 6C 6C 6F 0D 0A, 10 bytes)
:pkt_edge 350D0A48656C6C6F0D0A
:assert EDGE_ADDR == 65526
:assert EDGE_LEN == 10

# Trap when indexing 1 byte beyond allocated page boundary
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess
:assert_trap load_u8(65536) OutOfBoundsMemoryAccess

# Fragmented stream split check: all 9 prefixes 1..9 return -1; full 10 bytes returns 5
:split_check parse_http1_chunk_frame EDGE_ADDR EDGE_LEN -1 5

# Wire mutation fuzzing at page edge: 256 randomized mutations
:mutate parse_http1_chunk_frame EDGE_ADDR EDGE_LEN 256

# 3. Final Chunk (Last Chunk) at Page Edge
# Wire: "0\r\n" (hex: 30 0D 0A, 3 bytes)
:pkt_edge 300D0A
:assert EDGE_ADDR == 65533
:assert EDGE_LEN == 3
:split_check parse_http1_chunk_frame EDGE_ADDR EDGE_LEN -1 0
:mutate parse_http1_chunk_frame EDGE_ADDR EDGE_LEN 256

# Pipelined / Completed trailer chunk: "0\r\n\r\n"
:pkt 2080 300D0A0D0A
:assert parse_http1_chunk_frame(2080, 5) == 0

# 4. Chunk with Extension at Page Edge
# Wire: "4;ext=1\r\nWiki\r\n" (hex: 34 3B 65 78 74 3D 31 0D 0A 57 69 6B 69 0D 0A, 15 bytes)
:pkt_edge 343B6578743D310D0A57696B690D0A
:assert EDGE_ADDR == 65521
:assert EDGE_LEN == 15
:split_check parse_http1_chunk_frame EDGE_ADDR EDGE_LEN -1 4
:mutate parse_http1_chunk_frame EDGE_ADDR EDGE_LEN 256

# 5. Smuggling & Desynchronization Security Vectors
# Vector A: Bare LF in chunk size (CVE-2025-22871 defense): "5\nHello\r\n" -> -2
:pkt 2100 350A48656C6C6F0D0A
:assert parse_http1_chunk_frame(2100, 9) == -2

# Vector B: Bare LF in chunk extension: "5;x\nHello\r\n" -> -2
:pkt 2120 353B780A48656C6C6F0D0A
:assert parse_http1_chunk_frame(2120, 11) == -2

# Vector C: Non-hex characters in chunk size: "5G\r\n" -> -2
:pkt 2140 35470D0A
:assert parse_http1_chunk_frame(2140, 4) == -2

# Vector D: Missing trailing CRLF after chunk data: "4\r\nWikiXX" -> -2
:pkt 2160 340D0A57696B695858
:assert parse_http1_chunk_frame(2160, 9) == -2

# Vector E: Overstated chunk length attack at page edge:
# Chunk claims size 256 (0x100: "100\r\n"), but only 4 bytes delivered at edge
:pkt_edge 3130300D0A01020304
:assert EDGE_ADDR == 65527
:assert EDGE_LEN == 9
# Must return -1 without attempting to read chunk payload beyond page edge
:assert parse_http1_chunk_frame(EDGE_ADDR, EDGE_LEN) == -1
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# 6. Pure Framing Computation JIT Parity & Latency Gates
fn calc_chunk_step(size: i64, digit: i64) -> i64 {
    return (size << 4) | (digit & 15);
}

fn calc_chunk_overhead(chunk_len: i64, has_ext: i64) -> i64 {
    return chunk_len + 4 + (has_ext & 8);
}

:bench_gate calc_chunk_step(16, 10) 500 10000
:bench_gate calc_chunk_overhead(100, 1) 500 10000
