# scripts/repl/verify_chaos_fuzzing.repl
# Zero-allocation chaos, mutation fuzzing, and page-edge boundary verification
# across core protocol wire parsers (HTTP/1 Chunked, DNS QNAME, TLS 1.3 Record, and WebSocket RFC 6455).

# ==============================================================================
# SECTION 1: HTTP/1.1 CHUNKED TRANSFER WIRE PARSER AT 64 KB PAGE EDGE
# ==============================================================================

# Injects "1A\r\n0123456789abcdef0123456789\r\n" (26 bytes of payload, chunk-size = 26 / 0x1A)
# Total wire size: 4 bytes header + 26 payload + 2 trailing CRLF = 32 bytes
:pkt_edge 31410d0a30313233343536373839616263646566303132333435363738390d0a

:assert EDGE_ADDR == 65504
:assert EDGE_LEN == 32

# Verify strict out-of-bounds trap directly past edge
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess
:assert_trap load_u8(65536) OutOfBoundsMemoryAccess

# Zero-allocation HTTP/1 chunk header parser with strict CRLF & hex overflow guards
fn parse_chunk_size(addr: i32, len: i32) -> i32 {
    if len < 3 { return -1; }
    var size: i32 = 0;
    var i: i32 = 0;
    var seen_digits: i32 = 0;

    while i < len {
        let b = load_u8(addr + i);
        if b == 13 || b == 59 { // '\r' or ';' (extension)
            break;
        }
        if b == 10 { return -2; } // Bare LF rejected (CVE-2025-22871)

        var digit: i32 = -1;
        if b >= 48 && b <= 57 { digit = b - 48; }
        else if b >= 97 && b <= 102 { digit = b - 87; }
        else if b >= 65 && b <= 70 { digit = b - 55; }
        else { return -2; }

        if seen_digits >= 8 { return -2; } // Prevent 32-bit integer overflow
        size = (size << 4) | digit;
        seen_digits += 1;
        i += 1;
    }

    if seen_digits == 0 { return -2; }

    // Skip chunk extension up to CR
    while i < len && load_u8(addr + i) != 13 {
        if load_u8(addr + i) == 10 { return -2; }
        i += 1;
    }

    if i + 1 >= len { return -1; }
    if load_u8(addr + i) != 13 || load_u8(addr + i + 1) != 10 { return -2; }
    i += 2;

    let total_needed = i + size + 2;
    if len < total_needed { return -1; }
    if load_u8(addr + i + size) != 13 || load_u8(addr + i + size + 1) != 10 { return -2; }
    return size;
}

# Verify TCP streaming split check across all prefixes at 64 KB boundary
:split_check parse_chunk_size EDGE_ADDR EDGE_LEN -1 26

# Randomized bit-flip and byte mutation fuzzing at hardware page boundary (512 iterations)
:mutate parse_chunk_size EDGE_ADDR EDGE_LEN 512

# ==============================================================================
# SECTION 2: DNS WIRE FORMAT QUESTION PARSER AT 64 KB PAGE EDGE
# ==============================================================================

# Injects DNS Question for "example.com", Type A (1), Class IN (1)
# Header: 12 bytes [ID=0x1234, Flags=0x0100, QDCOUNT=1, AN=0, NS=0, AR=0]
# QNAME: 7 "example" (0x07 6578616d706c65), 3 "com" (0x03 636f6d), 0x00 terminal
# QTYPE: 0x0001 (A), QCLASS: 0x0001 (IN)
# Total length: 12 + 8 + 4 + 1 + 2 + 2 = 29 bytes
:pkt_edge 123401000001000000000000076578616d706c6503636f6d0000010001

:assert EDGE_ADDR == 65507
:assert EDGE_LEN == 29

# Verify trap past boundary
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

fn parse_dns_question(addr: i32, len: i32) -> i32 {
    if len < 12 { return -1; }
    let qdcount = (load_u8(addr + 4) << 8) | load_u8(addr + 5);
    if qdcount == 0 { return -2; }
    var offset: i32 = 12;
    var labels: i32 = 0;

    while offset < len {
        let label_len = load_u8(addr + offset);
        if label_len == 0 {
            offset += 1;
            break;
        }
        if (label_len & 0xC0) != 0 { return -2; } // Reject compression pointer in Question
        if label_len > 63 { return -2; } // RFC 1035 label limit
        offset += 1 + label_len;
        labels += 1;
        if labels > 128 || offset > len {
            if offset > len { return -1; }
            return -2;
        }
    }

    if offset + 4 > len { return -1; }
    let qtype = (load_u8(addr + offset) << 8) | load_u8(addr + offset + 1);
    let qclass = (load_u8(addr + offset + 2) << 8) | load_u8(addr + offset + 3);
    if qclass != 1 && qclass != 255 { return -2; }
    return qtype;
}

# Verify TCP/UDP DNS split check across all 28 prefixes at page edge
:split_check parse_dns_question EDGE_ADDR EDGE_LEN -1 1

# Mutation fuzzing across DNS wire question at page edge (512 iterations)
:mutate parse_dns_question EDGE_ADDR EDGE_LEN 512

# ==============================================================================
# SECTION 3: TLS 1.3 RECORD HEADER PARSER AT 64 KB PAGE EDGE
# ==============================================================================

# Injects TLS 1.3 ApplicationData record header:
# ContentType = 23 (0x17), Version = 0x0303 (TLS 1.2 legacy), Length = 128 (0x0080)
# Header: 5 bytes
:pkt_edge 1703030080

:assert EDGE_ADDR == 65531
:assert EDGE_LEN == 5

:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

fn parse_tls_record_header(addr: i32, len: i32) -> i32 {
    if len < 5 { return -1; }
    let ctype = load_u8(addr);
    if ctype < 20 || ctype > 23 { return -2; } // Invalid content type
    let v_maj = load_u8(addr + 1);
    let v_min = load_u8(addr + 2);
    if v_maj != 3 || (v_min != 1 && v_min != 3) { return -2; }
    let rlen = (load_u8(addr + 3) << 8) | load_u8(addr + 4);
    if rlen > 16640 { return -2; } // RecordOverflow
    if ctype == 23 && rlen == 0 { return -2; } // RFC 8446 §5.4 empty ApplicationData rejection
    return rlen;
}

# Split check across prefixes 1..4 at page boundary
:split_check parse_tls_record_header EDGE_ADDR EDGE_LEN -1 128

# Mutation fuzzing across TLS 1.3 record header (512 iterations)
:mutate parse_tls_record_header EDGE_ADDR EDGE_LEN 512

# ==============================================================================
# SECTION 4: WEBSOCKET RFC 6455 16-BIT EXTENDED PAYLOAD AT PAGE EDGE
# ==============================================================================

# Injects WebSocket Text Frame with 16-bit extended length:
# Byte 0: 0x81 (FIN=1, Opcode=1 Text)
# Byte 1: 0xFE (Mask=1, PayloadLen=126 -> indicates 16-bit len follows)
# Bytes 2-3: 0x0100 (PayloadLen = 256)
# Bytes 4-7: Masking Key (0xA1B2C3D4)
# Header total length: 8 bytes
:pkt_edge 81fe0100a1b2c3d4

:assert EDGE_ADDR == 65528
:assert EDGE_LEN == 8

:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

fn parse_ws_extended_header(addr: i32, len: i32) -> i32 {
    if len < 2 { return -1; }
    let b0 = load_u8(addr);
    let b1 = load_u8(addr + 1);
    let rsv = (b0 >> 4) & 7;
    if rsv != 0 { return -2; } // RSV bits MUST be 0
    let opcode = b0 & 15;
    if opcode > 10 { return -2; }

    let masked = (b1 & 128) != 0;
    var plen = (b1 & 127) as i32;
    var hdr_len = 2;

    if plen == 126 {
        hdr_len += 2;
        if len < hdr_len { return -1; }
        plen = (load_u8(addr + 2) << 8) | load_u8(addr + 3);
        if plen < 126 { return -2; } // RFC 6455 §5.2 minimal encoding violation
    } else if plen == 127 {
        hdr_len += 8;
        if len < hdr_len { return -1; }
        let msb = (load_u8(addr + 2) << 24) | (load_u8(addr + 3) << 16) | (load_u8(addr + 4) << 8) | load_u8(addr + 5);
        if (msb & 0x80000000) != 0 { return -2; }
        plen = (load_u8(addr + 6) << 24) | (load_u8(addr + 7) << 16) | (load_u8(addr + 8) << 8) | load_u8(addr + 9);
        if msb == 0 && plen < 65536 { return -2; }
    }

    if masked {
        hdr_len += 4;
        if len < hdr_len { return -1; }
    }

    return plen;
}

# Split check across prefixes 1..7 at boundary
:split_check parse_ws_extended_header EDGE_ADDR EDGE_LEN -1 256

# Mutation fuzzing across WebSocket frame header (512 iterations)
:mutate parse_ws_extended_header EDGE_ADDR EDGE_LEN 512
