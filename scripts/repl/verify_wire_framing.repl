# scripts/repl/verify_wire_framing.repl
# Deterministic wire framing assertions: gRPC LPM, TLS 1.3 Record Layer, and HTTP delimiter detection.

# -----------------------------------------------------------------------------
# 1. gRPC Length-Prefixed Message (LPM) Framing
# -----------------------------------------------------------------------------
# LPM header: Flag (1B), Length (4B Big-Endian), Payload ("hello world" = 11B)
:pkt 2048 000000000B68656C6C6F20776F726C64
:mem 2048 16

fn decode_grpc_lpm_len(addr: i32) -> i32 {
    let flag = load_u8(addr);
    if (flag & 0xFE) != 0 { return -1; }
    let b1 = load_u8(addr + 1);
    let b2 = load_u8(addr + 2);
    let b3 = load_u8(addr + 3);
    let b4 = load_u8(addr + 4);
    return (b1 << 24) | (b2 << 16) | (b3 << 8) | b4;
}

# Assert flag is 0 and length is 11
:assert load_u8(2048) == 0
:assert decode_grpc_lpm_len(2048) == 11
# Assert first payload byte is 'h' (104) and last is 'd' (100)
:assert load_u8(2053) == 104
:assert load_u8(2063) == 100

# -----------------------------------------------------------------------------
# 2. TLS 1.3 Record Layer Framing (RFC 8446 Section 5.1)
# -----------------------------------------------------------------------------
# Header: Type 0x17 (ApplicationData), Version 0x0303 (TLS 1.2 legacy), Length 0x0010 (16 bytes)
:pkt 3000 1703030010
:mem 3000 8

fn validate_tls_record_header(addr: i32, max_len: i32) -> i32 {
    let ctype = load_u8(addr);
    let v_maj = load_u8(addr + 1);
    let v_min = load_u8(addr + 2);
    let len_hi = load_u8(addr + 3);
    let len_lo = load_u8(addr + 4);
    let r_len = (len_hi << 8) | len_lo;

    // In TLS 1.3, legacy version must be 0x0303 (TLS 1.2) or 0x0301 during initial ClientHello
    if v_maj != 3 || (v_min != 3 && v_min != 1) { return -1; }
    // RFC 8446 Section 5.1: plaintext limit 2^14 (16384) + 256 expansion
    if r_len > max_len { return 22; }
    return ctype;
}

:assert validate_tls_record_header(3000, 16640) == 23

# Overflow test: Record length 16641 (> 16640)
:pkt 3100 1703034101
:assert validate_tls_record_header(3100, 16640) == 22

# -----------------------------------------------------------------------------
# 3. HTTP Header Delimiter (\r\n\r\n) Scanner
# -----------------------------------------------------------------------------
:pkt 4000 "POST /submit HTTP/1.1\r\nContent-Length: 0\r\n\r\nBODY"

fn find_crlfcrlf_offset(start: i32, max_scan: i32) -> i32 {
    var i: i32 = 0;
    while i <= max_scan - 4 {
        let b0 = load_u8(start + i);
        let b1 = load_u8(start + i + 1);
        let b2 = load_u8(start + i + 2);
        let b3 = load_u8(start + i + 3);
        if b0 == 13 && b1 == 10 && b2 == 13 && b3 == 10 {
            return i;
        }
        if b1 != 13 {
            i += 2;
        } else {
            i += 1;
        }
    }
    return -1;
}

# "POST /submit HTTP/1.1\r\nContent-Length: 0\r\n\r\n" -> CRLFCRLF starts at offset 40
:assert find_crlfcrlf_offset(4000, 48) == 40
