# scripts/repl/verify_hpack_qpack.repl
# HPACK / QPACK variable-length integer decoding, FIND-401 shift overflow defense,
# Huffman string boundary validation, and page-edge memory safety.

# 1. RFC 7541 Section 5.1 / RFC 9004 Section 4.5.1: 5-Bit Prefix Integer Decoder
fn decode_varint_5(addr: i32, len: i32) -> i32 {
    if len < 1 { return -1; }
    let b0 = load_u8(addr);
    let prefix = b0 & 31;
    if prefix < 31 { return prefix; }

    var val: i32 = 31;
    var shift: i32 = 0;
    var i: i32 = 1;

    while i < len {
        let b = load_u8(addr + i);
        let payload = b & 127;

        // Trail of Bits FIND-401 shift overflow guard
        if shift >= 28 {
            if shift > 28 || payload > 15 {
                return -2; // Integer overflow
            }
        }

        let term = payload << shift;
        if (2147483647 - val) < term {
            return -2; // 31-bit limit exceeded
        }
        val += term;
        i += 1;

        if (b & 128) == 0 {
            return val;
        }
        shift += 7;
    }

    return -1; // Truncated continuation sequence
}

# Test vector: 1337 with 5-bit prefix: 0x1F, 0x9A, 0x0A (31 + 26 + (10 << 7) = 1337)
:pkt_edge 1F9A0A
:assert EDGE_ADDR == 65533
:assert EDGE_LEN == 3

# Trap on reading 1 byte beyond the page boundary
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Fragmented stream split check: prefixes of length 1 and 2 return -1; full 3 bytes return 1337
:split_check decode_varint_5 EDGE_ADDR EDGE_LEN -1 1337

# Wire mutation fuzzing at page edge (256 iterations)
:mutate decode_varint_5 EDGE_ADDR EDGE_LEN 256

# 2. 7-Bit Prefix Integer Decoder (Used for Header Table Index & String Lengths)
fn decode_varint_7(addr: i32, len: i32) -> i32 {
    if len < 1 { return -1; }
    let b0 = load_u8(addr);
    let prefix = b0 & 127;
    if prefix < 127 { return prefix; }

    var val: i32 = 127;
    var shift: i32 = 0;
    var i: i32 = 1;

    while i < len {
        let b = load_u8(addr + i);
        let payload = b & 127;

        // FIND-401 shift overflow protection
        if shift >= 28 {
            if shift > 28 || payload > 15 {
                return -2; // Overflow error
            }
        }

        let term = payload << shift;
        if (2147483647 - val) < term {
            return -2;
        }
        val += term;
        i += 1;

        if (b & 128) == 0 {
            return val;
        }
        shift += 7;
    }

    return -1;
}

# Single byte encoding: value 42 (0x2A)
:pkt 2048 2A
:assert decode_varint_7(2048, 1) == 42

# Two byte encoding: 127 + (1 << 7) = 255: 0x7F, 0x80, 0x01
:pkt_edge 7F8001
:split_check decode_varint_7 EDGE_ADDR EDGE_LEN -1 255
:mutate decode_varint_7 EDGE_ADDR EDGE_LEN 256

# FIND-401 Security Vectors: Malicious continuation chains
# Vector A: Shift == 28 with payload > 0x0F (e.g., 0x10) must return -2 (overflow)
:pkt 2100 7FFFFFFFFFFF10
:assert decode_varint_7(2100, 6) == -2

# Vector B: 10 continuation octets of 0xFF (excessive shift chain)
:pkt 2120 7FFFFFFFFFFFFFFFFFFF01
:assert decode_varint_7(2120, 11) == -2

# Vector C: Truncated continuation bit without following byte
:pkt 2140 7F80
:assert decode_varint_7(2140, 2) == -1

# 3. HPACK String Literal Framing & Huffman Boundary Guard (RFC 7541 Section 5.2)
# Wire format: [H (1 bit) | Length (7-bit prefix)] [Octets...]
fn parse_hpack_string_frame(addr: i32, len: i32) -> i32 {
    if len < 1 { return -1; }
    let b0 = load_u8(addr);
    let is_huffman = (b0 & 128) != 0;
    let raw_len = b0 & 127;

    var str_len: i32 = raw_len;
    var hdr_len: i32 = 1;

    if raw_len == 127 {
        var shift: i32 = 0;
        var i: i32 = 1;
        var cont_ok: i32 = 0;
        while i < len {
            let b = load_u8(addr + i);
            let payload = b & 127;
            if shift >= 28 {
                if shift > 28 || payload > 15 { return -2; }
            }
            str_len += (payload << shift);
            i += 1;
            if (b & 128) == 0 {
                cont_ok = 1;
                hdr_len = i;
                break;
            }
            shift += 7;
        }
        if cont_ok == 0 { return -1; } // Truncated length header
    }

    // Bounds guard: ensure full payload bytes exist before any decoding
    if len < hdr_len + str_len {
        return -1; // Truncated string payload
    }

    // Return string length with sign indicating Huffman encoding
    if is_huffman {
        return 0 - str_len;
    }
    return str_len;
}

# Injects raw literal "custom-key" (10 bytes, uncompressed H=0) at page edge:
# Header: 0x0A (len 10, H=0), Payload: "custom-key" (63 75 73 74 6F 6D 2D 6B 65 79)
:pkt_edge 0A637573746F6D2D6B6579
:assert EDGE_ADDR == 65525
:assert EDGE_LEN == 11
:split_check parse_hpack_string_frame EDGE_ADDR EDGE_LEN -1 10
:mutate parse_hpack_string_frame EDGE_ADDR EDGE_LEN 256

# Injects Huffman literal "www.example.com" (12 bytes Huffman, H=1 -> 0x8C):
# Header: 0x8C, Payload: f1 e3 c2 e5 f2 3a 6b a0 ab 90 f4 ff (RFC 7541 C.4.1)
:pkt_edge 8CF1E3C2E5F23A6BA0AB90F4FF
:assert EDGE_ADDR == 65523
:assert EDGE_LEN == 13
:split_check parse_hpack_string_frame EDGE_ADDR EDGE_LEN -1 -12
:mutate parse_hpack_string_frame EDGE_ADDR EDGE_LEN 256

# Overstated string length attack: header claims 64 bytes, but only 4 bytes provided
:pkt_edge 40010203
:assert parse_hpack_string_frame(EDGE_ADDR, EDGE_LEN) == -1
# Confirm that no memory was read past EDGE_ADDR + EDGE_LEN (which would trap at 65536)
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# 4. Pure Framing Computation JIT Parity & Latency Gates
fn calc_varint_step(acc: i64, payload: i64, shift: i64) -> i64 {
    return acc + ((payload & 127) << (shift as u32));
}

fn derive_hpack_mask(prefix_bits: i64) -> i64 {
    return ((1 as i64) << (prefix_bits as u32)) - 1;
}

:bench_gate calc_varint_step(31, 10, 7) 500 10000
:bench_gate derive_hpack_mask(5) 500 10000
