# scripts/repl/verify_hpack_edge.repl
# HPACK RFC 7541 variable-length integer and Huffman padding invariants
# tested flush at the 64 KB Wasm page boundary.

# 1. 7-bit prefix integer decoding at page edge
# Injects 1337 encoded with 5-bit prefix: [0x1F, 0x9A, 0x0A] (3 bytes)
# Value = 31 + 26 + (10 << 7) = 1337
:pkt_edge 1F9A0A

:assert EDGE_ADDR == 65533
:assert EDGE_LEN == 3

# Memory safety: reading 1 byte past integer must trap
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Bounded HPACK N-bit integer decoder with shift overflow protection
fn hpack_decode_int_mem(addr: i32, len: i32) -> i32 {
    if len <= 0 { return -1; }
    let mask = 31; // 5-bit prefix
    let b0 = load_u8(addr);
    var val = b0 & mask;
    if val < mask {
        return val;
    }
    var shift: i32 = 0;
    var idx: i32 = 1;
    while idx < len {
        let b = load_u8(addr + idx);
        let payload = b & 127;
        if shift >= 28 {
            if shift > 28 || payload > 15 {
                return -2; // overflow
            }
        }
        val += payload << shift;
        idx += 1;
        if (b & 128) == 0 {
            return val;
        }
        shift += 7;
    }
    return -1; // incomplete
}

# Streaming split check across all prefix fragments at page edge
# Prefixes 1..2 return -1 (incomplete) without trap; full 3 bytes returns 1337
:split_check hpack_decode_int_mem EDGE_ADDR EDGE_LEN -1 1337

# Wire mutation fuzzing: 256 random bit flips and boundary mutations at page edge
:mutate hpack_decode_int_mem EDGE_ADDR EDGE_LEN 256

# 2. Integer shift overflow attack (FIND-401)
# 10 bytes of 0xFF (shift exceeds 28 with non-zero payload)
:pkt 3000 1FFFFFFFFFFFFFFFFFFF01
:assert hpack_decode_int_mem(3000, 11) == -2

# 3. Huffman Padding Canonicality Validator (RFC 7541 §5.2)
# Evaluates whether the trailing bits in a Huffman-coded string match EOS (1s) and do not exceed 7 bits.
fn validate_huffman_padding(addr: i32, len: i32, rem_bits: i32) -> i32 {
    if len <= 0 || rem_bits < 0 || rem_bits > 7 { return -1; }
    if rem_bits == 0 { return 1; } // No padding bits to verify
    let last_byte = load_u8(addr + len - 1);
    let pad_mask = (1 << rem_bits) - 1;
    let pad_val = last_byte & pad_mask;
    // RFC 7541 §5.2: padding bits MUST be all 1s (most significant bits of EOS)
    if pad_val != pad_mask {
        return 0; // Invalid non-canonical padding (contains 0s)
    }
    return 1; // Valid canonical padding
}

# "no-cache" encoded: a8 eb 10 64 9c bf (6 bytes)
# The last byte 0xBF (10111111_2) contains 6 padding bits (all 1s, 0x3F)
:pkt 4000 A8EB10649CBF
:assert validate_huffman_padding(4000, 6, 6) == 1

# Tampered padding: 0xBF altered to 0xB0 (padding contains zeros)
:pkt 4020 A8EB10649CB0
:assert validate_huffman_padding(4020, 6, 6) == 0

# Excessive padding (> 7 bits) rejected
:assert validate_huffman_padding(4000, 6, 8) == -1
