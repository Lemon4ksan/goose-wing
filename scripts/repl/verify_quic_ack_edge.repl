# scripts/repl/verify_quic_ack_edge.repl
# QUIC ACK Frame (RFC 9000 Section 19.3) & Header Security Invariants
# tested flush at the 64 KB Wasm page boundary.

# 1. Valid QUIC ACK Frame at Page Edge
# Frame Type: 0x02 (ACK, 1B), Largest Acked: 100 (VarInt 0x4064, 2B), ACK Delay: 25 (VarInt 0x19, 1B),
# Range Count: 0 (VarInt 0x00, 1B), First ACK Range: 10 (VarInt 0x0A, 1B)
# Total = 6 bytes: 02 40 64 19 00 0A
:pkt_edge 02406419000A

:assert EDGE_ADDR == 65530
:assert EDGE_LEN == 6

# Memory safety: reading 1 byte past ACK frame must trap
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Zero-allocation QUIC ACK frame wire validator
fn validate_quic_ack_wire(addr: i32, len: i32) -> i32 {
    if len <= 0 { return -1; }
    var idx: i32 = 0;

    // Decode Frame Type
    if idx >= len { return -1; }
    let ftype = load_u8(addr + idx);
    idx += 1;
    if ftype != 2 && ftype != 3 { return -2; } // only ACK (2) or ACK_ECN (3)

    // Decode Largest Acked (QUIC VarInt)
    if idx >= len { return -1; }
    let l0 = load_u8(addr + idx);
    let tag_l = (l0 >> 6) & 3;
    var largest_acked: i64 = (l0 & 63) as i64;
    var l_bytes: i32 = 1;
    if tag_l == 1 {
        l_bytes = 2;
        if idx + l_bytes > len { return -1; }
        largest_acked = (largest_acked << 8) | (load_u8(addr + idx + 1) as i64);
    } else if tag_l == 2 {
        l_bytes = 4;
        if idx + l_bytes > len { return -1; }
        largest_acked = (largest_acked << 24) | ((load_u8(addr + idx + 1) as i64) << 16) | ((load_u8(addr + idx + 2) as i64) << 8) | (load_u8(addr + idx + 3) as i64);
    }
    idx += l_bytes;

    // Decode ACK Delay
    if idx >= len { return -1; }
    let d0 = load_u8(addr + idx);
    let tag_d = (d0 >> 6) & 3;
    var d_bytes: i32 = 1;
    if tag_d == 1 { d_bytes = 2; }
    else if tag_d == 2 { d_bytes = 4; }
    if idx + d_bytes > len { return -1; }
    idx += d_bytes;

    // Decode Range Count
    if idx >= len { return -1; }
    let r0 = load_u8(addr + idx);
    let tag_r = (r0 >> 6) & 3;
    var r_bytes: i32 = 1;
    if tag_r == 1 { r_bytes = 2; }
    if idx + r_bytes > len { return -1; }
    idx += r_bytes;

    // Decode First ACK Range
    if idx >= len { return -1; }
    let a0 = load_u8(addr + idx);
    let tag_a = (a0 >> 6) & 3;
    var first_range: i64 = (a0 & 63) as i64;
    var a_bytes: i32 = 1;
    if tag_a == 1 {
        a_bytes = 2;
        if idx + a_bytes > len { return -1; }
        first_range = (first_range << 8) | (load_u8(addr + idx + 1) as i64);
    }
    idx += a_bytes;

    // RFC 9000 §19.3.1: Largest Acknowledged MUST be >= First ACK Range
    if largest_acked < first_range {
        return -3; // frame encoding error
    }

    return (largest_acked - first_range) as i32;
}

# Streaming split check across all prefix fragments at page edge
# Prefixes 1..5 return -1 without trap; full 6 bytes returns 90 (smallest acked: 100 - 10)
:split_check validate_quic_ack_wire EDGE_ADDR EDGE_LEN -1 90

# Wire mutation fuzzing: 256 random bit flips and boundary mutations at page edge
:mutate validate_quic_ack_wire EDGE_ADDR EDGE_LEN 256

# 2. RFC 9000 Section 19.3.1 Invariant: First ACK Range > Largest Acknowledged
# Largest Acked: 5 (0x05), First Range: 10 (0x0A) -> MUST be rejected (-3)
:pkt 2048 020519000A
:assert validate_quic_ack_wire(2048, 5) == -3

# 3. QUIC Long Header Fixed Bit (0x40) & Reserved Bits (0x0C) Rules (RFC 9000 Section 17.2)
fn validate_quic_long_header_wire(addr: i32, len: i32) -> i32 {
    if len < 5 { return -1; }
    let first = load_u8(addr);
    // Must be Long Header (bit 7 set)
    if (first & 128) == 0 { return -2; }
    // Fixed bit 6 (0x40) MUST be set
    if (first & 64) == 0 { return -3; }
    // Reserved bits 2 and 3 (0x0C) MUST be 0 for Initial (long_type = 0)
    let long_type = (first >> 4) & 3;
    if long_type == 0 && (first & 12) != 0 {
        return -4; // invalid reserved bits
    }
    return 1;
}

# Valid Initial header byte: 0xC0 (Long=1, Fixed=1, Type=0, Reserved=0, PnLen=0)
:pkt 2100 C000000001
:assert validate_quic_long_header_wire(2100, 5) == 1

# Invalid Fixed bit cleared: 0x80 (Fixed=0) -> -3
:pkt 2110 8000000001
:assert validate_quic_long_header_wire(2110, 5) == -3

# Invalid Reserved bit set: 0xC4 (Reserved bit 2 set) -> -4
:pkt 2120 C400000001
:assert validate_quic_long_header_wire(2120, 5) == -4
