# scripts/repl/verify_asn1_der_edge.repl
# ASN.1 DER length and serial number canonical invariants (ITU-T X.690 & RFC 5280)
# tested flush at the 64 KB Wasm page boundary.

# 1. ASN.1 DER Long Form Length at Page Edge
# Injects 2-byte long form length [0x82, 0x01, 0x00] = 256 bytes
:pkt_edge 820100

:assert EDGE_ADDR == 65533
:assert EDGE_LEN == 3

# Memory safety: reading 1 byte past length descriptor must trap
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Bounded ASN.1 DER length decoder enforcing ITU-T X.690 §8.1.3 invariants
fn decode_der_length(addr: i32, len: i32) -> i32 {
    if len <= 0 { return -1; }
    let b0 = load_u8(addr);
    if (b0 & 128) == 0 {
        return b0;
    }
    // Indefinite length (0x80) and initial 0xFF are strictly forbidden in DER
    if b0 == 128 || b0 == 255 {
        return -2;
    }
    let num_bytes = b0 & 127;
    if num_bytes < 1 || num_bytes > 4 {
        return -2;
    }
    if len < 1 + num_bytes {
        return -1; // incomplete
    }
    var total: i32 = 0;
    var i: i32 = 0;
    while i < num_bytes {
        let b = load_u8(addr + 1 + i);
        // Redundant leading zero in long form is strictly forbidden
        if i == 0 && b == 0 {
            return -2;
        }
        total = (total << 8) | b;
        i += 1;
    }
    // Long form must encode values >= 128
    if total < 128 {
        return -2;
    }
    return total;
}

# Streaming split check across all prefix fragments at page edge
# Prefixes 1..2 return -1 (incomplete) without trap; full 3 bytes returns 256
:split_check decode_der_length EDGE_ADDR EDGE_LEN -1 256

# Wire mutation fuzzing: 256 random bit flips and byte boundary mutations at page edge
:mutate decode_der_length EDGE_ADDR EDGE_LEN 256

# 2. X.690 §8.1.3 Length Rule Assertions
# BER indefinite length (0x80) must be rejected
:pkt 2048 80
:assert decode_der_length(2048, 1) == -2

# Redundant leading zeros in long form (0x82 0x00 0x80) must be rejected
:pkt 2050 820080
:assert decode_der_length(2050, 3) == -2

# Reserved initial octet 0xFF must be rejected
:pkt 2060 FF
:assert decode_der_length(2060, 1) == -2

# Long form encoding for value < 128 (0x81 0x7F) must be rejected
:pkt 2070 817F
:assert decode_der_length(2070, 2) == -2

# 3. ASN.1 DER Integer & Certificate Serial Number Canonical Rules
# Validates DER integer canonical padding and RFC 5280 positive serial number rules.
fn validate_asn1_serial_number(addr: i32, len: i32) -> i32 {
    if len <= 0 { return -1; }
    // RFC 5280 §4.1.2.2: serial numbers longer than 20 octets are forbidden
    if len > 20 { return -2; }
    let b0 = load_u8(addr);
    // Serial numbers MUST be positive (high bit must be 0)
    if (b0 & 128) != 0 { return -2; }
    // Canonical DER padding: if b0 == 0x00 and len > 1, the next byte MUST have its high bit set
    if len > 1 && b0 == 0 {
        let b1 = load_u8(addr + 1);
        if (b1 & 128) == 0 {
            return -2; // Redundant leading zero padding
        }
    }
    return 1; // Valid serial number
}

# Valid 1-byte serial: 0x42
:pkt 3000 42
:assert validate_asn1_serial_number(3000, 1) == 1

# Valid 2-byte serial with necessary zero prefix: 0x00 0x80 (positive 128)
:pkt 3010 0080
:assert validate_asn1_serial_number(3010, 2) == 1

# Invalid serial: negative integer 0x80 (high bit set)
:pkt 3020 80
:assert validate_asn1_serial_number(3020, 1) == -2

# Invalid serial: redundant zero padding 0x00 0x01
:pkt 3030 0001
:assert validate_asn1_serial_number(3030, 2) == -2

# Invalid serial: length > 20 octets (21 bytes)
:pkt 3040 0102030405060708090A0B0C0D0E0F101112131415
:assert validate_asn1_serial_number(3040, 21) == -2
