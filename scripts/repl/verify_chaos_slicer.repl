# scripts/repl/verify_chaos_slicer.repl
# Fragmented stream reassembly verification.

let lis = tcp_listen(9005)
:assert lis > 0

let cli = tcp_connect(9005)
:assert cli > 0

let srv = tcp_accept(lis)
:assert srv > 0

# Client sends sliced chunks over TCP
# Message: "GET /api/v1/stream HTTP/1" (25 bytes)
# Slice 1: "GET " (4 bytes)
let s1 = tcp_send(cli, "GET ", 4)
:assert s1 == 4

# Slice 2: "/a" (2 bytes)
let s2 = tcp_send(cli, "/a", 2)
:assert s2 == 2

# Slice 3: "pi/v1/" (6 bytes)
let s3 = tcp_send(cli, "pi/v1/", 6)
:assert s3 == 6

# Slice 4: "stream" (6 bytes)
let s4 = tcp_send(cli, "stream", 6)
:assert s4 == 6

# Slice 5: " HTTP/1" (7 bytes)
let s5 = tcp_send(cli, " HTTP/1", 7)
:assert s5 == 7

# Server reads incrementally into linear memory at 3000
var total_rcvd: i32 = 0

fn drain_sliced_stream(sock: i64, dst_addr: i32, expected_total: i32) -> i32 {
    var accumulated: i32 = 0;
    while accumulated < expected_total {
        let chunk_len = expected_total - accumulated;
        let r = tcp_recv(sock, dst_addr + accumulated, chunk_len);
        if r <= 0 { break; }
        accumulated += r;
    }
    return accumulated;
}

let rcvd = drain_sliced_stream(srv, 3000, 25)
:assert rcvd == 25

:mem 3000 25

# Verify reassembled payload in memory
# "GET " -> 71, 69, 84, 32
:assert load_u8(3000) == 71
:assert load_u8(3001) == 69
:assert load_u8(3002) == 84
:assert load_u8(3003) == 32

# "/api/v1/"
:assert load_u8(3004) == 47
:assert load_u8(3005) == 97
:assert load_u8(3006) == 112
:assert load_u8(3007) == 105

# Last bytes " HTTP/1"
:assert load_u8(3023) == 47
:assert load_u8(3024) == 49

# Close sockets
tcp_close(cli)
tcp_close(srv)
tcp_close(lis)
:sockets
