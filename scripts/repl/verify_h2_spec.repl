# scripts/repl/verify_h2_spec.repl
# HTTP/2 framing checks (RFC 9113).

# Connection preface (RFC 9113 section 3.4)
# 24-byte preface: "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
:pkt 2048 "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
:mem 2048 24

fn verify_h2_preface(addr: i32) -> i32 {
    let p0 = load_u8(addr);
    let p1 = load_u8(addr + 1);
    let p2 = load_u8(addr + 2);
    let p3 = load_u8(addr + 3);
    // Expect 'P', 'R', 'I', ' ' (80, 82, 73, 32)
    if p0 != 80 || p1 != 82 || p2 != 73 || p3 != 32 { return 0; }
    // Check trailing \r\n\r\n at end (offsets 20, 21, 22, 23)
    let c0 = load_u8(addr + 20);
    let c1 = load_u8(addr + 21);
    let c2 = load_u8(addr + 22);
    let c3 = load_u8(addr + 23);
    if c0 == 13 && c1 == 10 && c2 == 13 && c3 == 10 { return 1; }
    return 0;
}

:assert verify_h2_preface(2048) == 1

# Frame header parsing and validation (RFC 9113 section 7)
# Error codes: 0 = ok, 1 = protocol error, 6 = frame size error

fn parse_and_validate_h2_frame(addr: i32, is_client: i32) -> i32 {
    let l0 = load_u8(addr);
    let l1 = load_u8(addr + 1);
    let l2 = load_u8(addr + 2);
    let length = (l0 << 16) | (l1 << 8) | l2;

    let ftype = load_u8(addr + 3);
    let flags = load_u8(addr + 4);

    let s0 = load_u8(addr + 5) & 0x7F;
    let s1 = load_u8(addr + 6);
    let s2 = load_u8(addr + 7);
    let s3 = load_u8(addr + 8);
    let stream_id = (s0 << 24) | (s1 << 16) | (s2 << 8) | s3;

    // SETTINGS (type 0x4) MUST be on stream 0
    if ftype == 4 {
        if stream_id != 0 { return 1; } // protocol error
        // SETTINGS with ACK (flag 0x1) MUST have length 0
        if (flags & 0x1) != 0 && length != 0 { return 6; } // frame size error
        // SETTINGS payload must be multiple of 6 (key 2B, value 4B)
        if (flags & 0x1) == 0 && (length % 6) != 0 { return 6; }
    }

    // PING (type 0x6) MUST be on stream 0 and length MUST be 8
    if ftype == 6 {
        if stream_id != 0 { return 1; }
        if length != 8 { return 6; }
    }

    // Client-initiated streams MUST be odd (stream_id % 2 == 1)
    if is_client == 1 && stream_id > 0 {
        if (stream_id & 1) == 0 { return 1; } // protocol error (even stream ID from client)
    }

    // WINDOW_UPDATE (type 0x8) payload must be 4 bytes
    if ftype == 8 {
        if length != 4 { return 6; }
    }

    return 0; // ok
}

# Valid SETTINGS frame (len=6, type=4, flags=0, stream=0)
:pkt 3000 000006040000000000
:assert parse_and_validate_h2_frame(3000, 1) == 0

# SETTINGS on stream 1 produces protocol error (1)
:pkt 3020 000006040000000001
:assert parse_and_validate_h2_frame(3020, 1) == 1

# SETTINGS ACK with length > 0 produces frame size error (6)
:pkt 3040 000006040100000000
:assert parse_and_validate_h2_frame(3040, 1) == 6

# Valid PING frame (len=8, type=6, flags=0, stream=0)
:pkt 3060 000008060000000000
:assert parse_and_validate_h2_frame(3060, 1) == 0

# Invalid PING frame with length 7 produces frame size error (6)
:pkt 3080 000007060000000000
:assert parse_and_validate_h2_frame(3080, 1) == 6

# Client stream with even stream ID produces protocol error (1)
:pkt 3100 00000A010500000002
:assert parse_and_validate_h2_frame(3100, 1) == 1

# Client stream with odd stream ID is accepted (0)
:pkt 3120 00000A010500000003
:assert parse_and_validate_h2_frame(3120, 1) == 0
