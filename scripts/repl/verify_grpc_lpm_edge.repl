# scripts/repl/verify_grpc_lpm_edge.repl
# gRPC Length-Prefixed Message (LPM) binary framing and 32-bit length overflow invariants
# tested flush at the 64 KB Wasm page boundary.

# 1. Valid 5-byte LPM Frame + 5-byte Payload "hello" at Page Edge (10 bytes total)
# Flag = 0x00, Length = 0x00000005, Payload = "hello" (0x68656C6C6F)
:pkt_edge 000000000568656C6C6F

:assert EDGE_ADDR == 65526
:assert EDGE_LEN == 10

# Memory safety: reading 1 byte past frame must trap
:assert_trap load_u8(EDGE_ADDR + EDGE_LEN) OutOfBoundsMemoryAccess

# Zero-allocation gRPC LPM frame decoder with 64-bit safe length checks
fn validate_grpc_lpm_wire(addr: i32, len: i32) -> i32 {
    if len < 5 { return -1; } // incomplete header
    let flag = load_u8(addr);
    // Flag can only have bit 0 set (compressed), all other bits must be 0
    if (flag & 254) != 0 { return -2; }

    let b1 = load_u8(addr + 1);
    let b2 = load_u8(addr + 2);
    let b3 = load_u8(addr + 3);
    let b4 = load_u8(addr + 4);
    let payload_len: i64 = ((b1 as i64) << 24) | ((b2 as i64) << 16) | ((b3 as i64) << 8) | (b4 as i64);

    let total_len: i64 = 5 + payload_len;
    if (len as i64) < total_len {
        return -1; // incomplete payload
    }
    return payload_len as i32;
}

# Streaming split check across all 9 prefix fragments at page edge
# Prefixes 1..9 return -1 (incomplete) without trap; full 10 bytes returns 5
:split_check validate_grpc_lpm_wire EDGE_ADDR EDGE_LEN -1 5

# Wire mutation fuzzing: 256 random bit flips and byte boundary mutations at page edge
:mutate validate_grpc_lpm_wire EDGE_ADDR EDGE_LEN 256

# 2. 32-bit Integer Overflow Length Invariant Assertions
# Payload length 0xFFFFFFFF (4294967295): 5 + 0xFFFFFFFF must not wrap around to 4!
:pkt 2048 00FFFFFFFF
:assert validate_grpc_lpm_wire(2048, 5) == -1

# Payload length 0xFFFFFFFB (4294967291): 5 + 0xFFFFFFFB must not wrap around to 0!
:pkt 2060 00FFFFFFFB
:assert validate_grpc_lpm_wire(2060, 5) == -1

# Invalid reserved flag bits (e.g. 0x02 set)
:pkt 2080 0200000000
:assert validate_grpc_lpm_wire(2080, 5) == -2
