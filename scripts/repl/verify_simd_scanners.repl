# scripts/repl/verify_simd_scanners.repl
# Zero-allocation in-memory verification for SIMD/SWAR scanners in goose-wing.

# 1. HTTP Delimiter SIMD Inspection
:pkt 2048 "GET /api/v2/orders HTTP/1.1\r\nHost: example.com\r\n\r\n"
:simd 2048 47
:mem 2048 32

fn scan_slashes_at(addr: i32) -> i32 {
    let vec = simd_v128_load(addr);
    let slash_filter = simd_i8x16_splat(47);
    let matches = simd_i8x16_eq(vec, slash_filter);
    return simd_i8x16_bitmask(matches);
}

# In "GET /api/v2/orde", '/' is at index 4 (16), index 8 (256), and index 11 (2048) -> bitmask 2320
:assert scan_slashes_at(2048) == 2320

# 2. WebSocket 128-bit SIMD In-place XOR Unmasking
# Payload: 16 bytes "Hello Goose Wing"
# Mask: [0xAA, 0xBB, 0xCC, 0xDD] repeating
:pkt 4096 "Hello Goose Wing"
:pkt 4112 "Hello Goose Wing"

fn test_simd_xor_mask(src_addr: i32, dst_addr: i32) -> i32 {
    let data_vec = simd_v128_load(src_addr);
    let mask_vec = simd_i32x4_splat(0xDDCCBBAA);
    let masked_vec = simd_v128_xor(data_vec, mask_vec);
    simd_v128_store(dst_addr, masked_vec);

    let unmasked_vec = simd_v128_xor(masked_vec, mask_vec);
    simd_v128_store(dst_addr + 16, unmasked_vec);
    return 1;
}

:assert test_simd_xor_mask(4096, 5000) == 1
# Verify original bytes restored after roundtrip XOR
:assert load_u8(5016) == 72
:assert load_u8(5017) == 101
:assert load_u8(5018) == 108
:assert load_u8(5019) == 108
:assert load_u8(5020) == 111
